              </div>

              <!-- Other User's Profile Action Buttons -->
              <div id="profile-other-actions" class="hidden flex items-center gap-2 flex-wrap justify-center sm:justify-start">
                <button id="profile-main-follow-btn" onclick="toggleMainProfileFollow()" class="px-5 py-1.5 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-semibold rounded-lg transition active:scale-95 shadow-sm">
                  Takip Et
                </button>
                <button onclick="sendDirectMessageFromProfile()" class="px-4 py-1.5 bg-gray-100 hover:bg-gray-200 dark:bg-[#262626] dark:hover:bg-[#333] text-xs font-semibold rounded-lg transition flex items-center gap-1.5 active:scale-95 border border-[#dbdbdb] dark:border-[#444]">
                  <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                  <span>Mesaj Gönder</span>
                </button>
                <button onclick="giftPawPointsFromProfile()" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-bold rounded-lg transition flex items-center gap-1 active:scale-95" title="10 Pati Puanı Hediye Et">
                  <span>🐾</span>
                  <span>Pati Maması İkram Et</span>
                </button>
              </div>
            </div>

            <!-- Stats & Pati Puanı Button -->
            <div class="flex items-center justify-center md:justify-start gap-4 sm:gap-6 text-sm">
              <span><strong id="profile-posts-count">18</strong> gönderi</span>
              <button onclick="openFollowersModal('followers')" class="hover:opacity-80 transition cursor-pointer text-left">
                <span><strong id="profile-followers-count">48.6B</strong> takipçi</span>
              </button>
              <button onclick="openFollowersModal('following')" class="hover:opacity-80 transition cursor-pointer text-left">
                <span><strong id="profile-following-count">294</strong> takip</span>
              </button>
              
              <!-- Pati Puanı Badge (Clickable) -->
              <button onclick="openPawPointsModal()" class="flex items-center gap-1.5 px-3 py-1 bg-gradient-to-r from-amber-500/20 via-orange-500/20 to-pink-500/20 hover:from-amber-500/30 hover:to-pink-500/30 border border-amber-500/40 rounded-full transition shadow-xs group cursor-pointer">
                <span class="text-base group-hover:scale-125 transition">🐾</span>
                <span class="font-extrabold text-xs text-amber-600 dark:text-amber-400"><strong id="profile-paw-points">125</strong> Pati</span>
              </button>
            </div>

            <!-- Bio & Poodle Passport Info -->
            <div class="text-sm flex flex-col gap-1">
              <div class="flex items-center justify-center md:justify-start gap-2 flex-wrap">
                <span id="profile-main-name" class="font-bold text-base">Mochi 🐾</span>
                <span id="profile-badge-variety" class="px-2 py-0.5 bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-[10px] rounded-full border border-amber-500/20">Toy Poodle</span>
                <span id="profile-badge-color" class="px-2 py-0.5 bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-[10px] rounded-full border border-purple-500/20">Red Apricot</span>
                <span id="profile-badge-rank" class="px-2 py-0.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] rounded-full border border-emerald-500/20">Kıvırcık Kaşif 🎾</span>
                <span id="profile-badge-verified-pill" onclick="openVerificationModal()" class="hidden items-center gap-1 px-2.5 py-0.5 bg-sky-500/10 hover:bg-sky-500/20 text-[#0095f6] font-bold text-[10px] rounded-full border border-[#0095f6]/30 cursor-pointer transition active:scale-95" title="Mavi Pati Onaylı Poodle">
                  <svg class="size-3 text-[#0095f6]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                    <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                    <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                    <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                    <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                    <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
                  </svg>
                  <span>Mavi Pati Onaylı</span>
                </span>
              </div>
              <p id="profile-main-bio" class="text-gray-700 dark:text-gray-300">Park delisi, ödül maması aşığı bir minik prens 🦴👑</p>
              <p id="profile-main-location" class="text-xs text-[#737373] flex items-center justify-center md:justify-start gap-1">📍 İstanbul, Bebek</p>
            </div>
          </div>
        </div>

        <!-- Story Highlights -->
        <div id="profile-highlights-tray" class="flex items-center gap-6 overflow-x-auto no-scrollbar pb-4 border-b border-[#dbdbdb] dark:border-[#262626]">
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_teddy.jpg" alt="Kuaför" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Kuaför ✂️</span>
          </div>
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_coco.jpg" alt="Park" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Park 🎾</span>
          </div>
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_bella.jpg" alt="Bebeklik" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Bebeklik 🍼</span>
          </div>
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_milo.jpg" alt="Seyahat" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Seyahat ✈️</span>
          </div>
        </div>

        <!-- Multi-Poodle Management Section -->
        <div id="profile-poodles-section" class="flex flex-col gap-2.5 p-3 sm:p-4 bg-gray-50 dark:bg-[#181818] border border-gray-200 dark:border-[#2d2d2d] rounded-2xl shadow-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-base sm:text-lg">🐩</span>
              <h3 class="font-bold text-xs sm:text-sm text-gray-900 dark:text-white">Poodle Profillerim</h3>
              <span class="text-[10px] text-gray-400 font-medium hidden sm:inline">(Çoklu Profil Yönetimi)</span>
            </div>
            <button onclick="openAddPoodleModal()" class="px-3 py-1.5 bg-amber-500/15 hover:bg-amber-500/25 text-amber-700 dark:text-amber-300 border border-amber-500/30 rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-xs">
              <span>➕</span>
              <span>Yeni Poodle Ekle</span>
            </button>
          </div>
          <div id="profile-poodles-list" class="flex items-center gap-3 overflow-x-auto py-1">
            <div class="text-xs text-gray-400 py-2">Poodle profilleri yükleniyor...</div>
          </div>
        </div>

        <!-- Profile Tabs -->
        <div class="flex justify-center gap-6 sm:gap-12 text-xs font-bold tracking-wider text-[#737373] border-b border-[#dbdbdb] dark:border-[#262626]">
          <button id="profile-subtab-posts" onclick="switchProfileSubTab('posts')" class="flex items-center gap-2 py-3 border-t-2 border-black dark:border-white text-black dark:text-white transition cursor-pointer">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            GÖNDERİLER
          </button>
          <button id="profile-subtab-saved" onclick="switchProfileSubTab('saved')" class="flex items-center gap-2 py-3 border-t-2 border-transparent hover:text-black dark:hover:text-white transition cursor-pointer">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
            KAYDEDİLENLER 🔖
          </button>
          <button id="profile-subtab-reels" onclick="switchProfileSubTab('reels')" class="flex items-center gap-2 py-3 border-t-2 border-transparent hover:text-black dark:hover:text-white transition cursor-pointer">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
            REELS
          </button>
        </div>

        <!-- Profile Grid -->
        <div id="profile-grid" class="grid grid-cols-3 gap-1 md:gap-4">
          <!-- Dynamically populated via JS -->
        </div>

        <!-- Profile Saved Grid (Initially Hidden) -->
        <div id="profile-saved-grid" class="hidden grid grid-cols-3 gap-1 md:gap-4">
          <!-- Dynamically populated via JS -->
        </div>

      </div>

    
      <!-- ================= POODLE SORU-CEVAP & YARDIMLAŞMA KULÜBÜ TAB ================= -->
      <div id="tab-community" class="hidden w-full max-w-[850px] pt-2 md:pt-6 px-2 sm:px-4 flex flex-col gap-5">
        
        <!-- Header Hero & Action Banner -->
        <div class="bg-gradient-to-r from-amber-500/15 via-rose-500/10 to-purple-500/15 border border-amber-500/30 rounded-3xl p-4 sm:p-6 shadow-sm">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-2xl sm:text-3xl">🐾</span>
                <h2 class="text-lg sm:text-xl font-black text-gray-900 dark:text-white">Poodle Soru-Cevap & Yardımlaşma Alanı</h2>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30">Canlı Dayanışma</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-300 mt-1.5 max-w-xl leading-relaxed">
                Poodle'ınızın sağlığı, aşıları, beslenmesi, tıraşı ve eğitimiyle ilgili sorularınızı sorun; deneyimli Poodle aileleri ve veterinerler yanıtlasın.
              </p>
              
              <!-- Community Highlights -->
              <div class="flex items-center gap-2 flex-wrap mt-3 text-[11px] font-bold text-gray-600 dark:text-gray-300">
                <span class="px-2 py-0.5 rounded-lg bg-white/70 dark:bg-[#1a1a1a]/70 border border-gray-200 dark:border-[#333]">💬 1.400+ Yanıtlanmış Soru</span>
                <span class="px-2 py-0.5 rounded-lg bg-white/70 dark:bg-[#1a1a1a]/70 border border-gray-200 dark:border-[#333]">🩺 Uzman & Vet Destekli</span>
                <span class="px-2 py-0.5 rounded-lg bg-amber-500/20 text-amber-700 dark:text-amber-300">🐾 Soruya +25, Cevaba +10 Pati</span>
              </div>
            </div>

            <!-- Ask Question Button -->
            <button onclick="openCreateTopicModal()" class="w-full sm:w-auto px-5 py-3 bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 hover:from-amber-600 hover:to-purple-700 text-white font-extrabold text-xs sm:text-sm rounded-2xl shadow-lg transition transform active:scale-95 flex items-center justify-center gap-2 shrink-0 cursor-pointer">
              <span class="text-base">➕</span>
              <span>Soru Sor (+25 Pati 🐾)</span>
            </button>
          </div>
        </div>

        <!-- Filter Controls: Search & Category Pills -->
        <div class="flex flex-col gap-3 bg-white dark:bg-[#141414] border border-[#dbdbdb] dark:border-[#262626] rounded-2xl p-4 shadow-xs">
          <!-- Search Row -->
          <div class="flex items-center gap-2.5">
            <div class="relative flex-1">
              <svg class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="community-search-input" type="text" oninput="filterCommunityTopics()" placeholder="Kafana takılan soruyu ara (örn: karma aşı, göz lekesi, patella, tıraş, tuvalet eğitimi)..." class="w-full pl-9 pr-3 py-2.5 bg-gray-50 dark:bg-[#1e1e1e] border border-gray-200 dark:border-[#333] rounded-xl text-xs outline-none focus:border-[#0095f6] text-gray-900 dark:text-white placeholder-gray-400">
            </div>
            <button onclick="loadCommunityTopics()" class="px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 dark:bg-[#222] dark:hover:bg-[#2c2c2c] rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer active:scale-95 shrink-0" title="Yenile">
              <span>🔄</span>
              <span class="hidden sm:inline">Yenile</span>
            </button>
          </div>

          <!-- Category Pills Row (No native scrollbar) -->
          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 text-xs pt-1 border-t border-gray-100 dark:border-[#222]">
            <button onclick="setCommunityCategory('all', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-black dark:bg-white text-white dark:text-black shrink-0 transition active:scale-95 cursor-pointer">Tüm Sorular</button>
            <button onclick="setCommunityCategory('saglik', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer">🩺 Sağlık & Aşı</button>
            <button onclick="setCommunityCategory('beslenme', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer">🥩 Beslenme & Mama</button>
            <button onclick="setCommunityCategory('bakim', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer">✂️ Bakım & Tıraş</button>
            <button onclick="setCommunityCategory('egitim', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer">🎾 Eğitim & Tuvalet</button>
            <button onclick="setCommunityCategory('tanisma', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer">👋 Tanışma & Deneyim</button>
            <button onclick="setCommunityCategory('topluluk', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer">📍 Şehir Buluşmaları</button>
          </div>

          <!-- Poodle Variety Filter Row -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs pt-1">
            <span class="text-[10px] font-extrabold text-gray-400 shrink-0 uppercase tracking-wider">Poodle Cinsi:</span>
            <button onclick="setCommunityVariety('all', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-[#0095f6] text-white shrink-0 transition active:scale-95 cursor-pointer">Tümü</button>
            <button onclick="setCommunityVariety('toy', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 shrink-0 transition active:scale-95 cursor-pointer">🐩 Toy</button>
            <button onclick="setCommunityVariety('miniature', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 shrink-0 transition active:scale-95 cursor-pointer">🐕 Miniature</button>
            <button onclick="setCommunityVariety('standard', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 shrink-0 transition active:scale-95 cursor-pointer">👑 Standard</button>
          </div>
        </div>

        <!-- Topics List Container -->
        <div id="community-topics-list" class="flex flex-col gap-3.5 pb-8">
          <!-- Dynamically populated via JS -->
          <div class="py-12 text-center text-xs text-gray-500 flex items-center justify-center gap-2">
            <span>🔄</span>
            <span>Sorular ve deneyimler yükleniyor... 🐾</span>
          </div>
        </div>

      </div>
</main>

    <!-- MOBILE BOTTOM NAVIGATION (Instagram Mobile Style) -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 h-12 bg-white dark:bg-black border-t border-[#dbdbdb] dark:border-[#262626] z-50 flex items-center justify-around px-2">
      <!-- Home -->
      <button onclick="switchTab('home')" class="p-2" aria-label="Home">
        <svg id="m-nav-home" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.1l9.9 8.9-1.4 1.5L19 11.2V20c0 1.1-.9 2-2 2h-4v-6h-2v6H7c-1.1 0-2-.9-2-2v-8.8l-1.5 1.3-1.4-1.5L12 2.1z"/></svg>
      </button>

      <!-- Explore -->
      <button onclick="switchTab('explore')" class="p-2" aria-label="Explore">
        <svg id="m-nav-explore" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9 12 2"/></svg>
      </button>

      <!-- Reels -->
      <!-- Community Mobile -->
      <button onclick="switchTab('community')" class="p-2" aria-label="Community" id="m-nav-community" title="Topluluk">
        <span class="text-xl">🐩</span>
      </button>

      <button onclick="switchTab('reels')" class="p-2" aria-label="Reels">
        <svg id="m-nav-reels" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="m10 9 5 3-5 3V9z"/><line x1="2" y1="7" x2="22" y2="7"/></svg>
      </button>

      <!-- Create (+) -->
      <button onclick="openCreateModal()" class="p-2" aria-label="Create">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      </button>

      <!-- Profile -->
      <button onclick="handleProfileNavClick()" class="p-1" aria-label="Profile">
        <div id="m-avatar-container" class="size-6 rounded-full overflow-hidden border border-[#dbdbdb] dark:border-[#262626]">
          <img id="m-avatar-img" src="/images/poodle_mochi.jpg" alt="Profile" class="size-full object-cover">
        </div>
      </button>
    </nav>

  </div>

  <!-- Realtime DM Notification Banner (Instagram Style Popdown) -->
  <div id="realtime-dm-banner" onclick="handleRealtimeBannerClick()" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 max-w-sm w-[92%] bg-white/95 dark:bg-[#1a1a1a]/95 backdrop-blur-md border border-[#dbdbdb] dark:border-[#333] rounded-2xl shadow-2xl p-3 flex items-center justify-between gap-3 transition-all duration-300 -translate-y-28 opacity-0 pointer-events-none cursor-pointer">
    <div class="flex items-center gap-3 min-w-0">
      <img id="realtime-banner-avatar" src="/images/poodle_mochi.jpg" class="size-10 rounded-full object-cover shrink-0 border border-amber-500">
      <div class="flex flex-col min-w-0">
        <div class="flex items-center gap-1.5">
          <span id="realtime-banner-name" class="font-bold text-xs truncate">@mochi</span>
          <span class="text-[10px] text-amber-500 bg-amber-500/10 px-1.5 py-0.5 rounded-full font-bold">Yeni Mesaj 💬</span>
        </div>
        <p id="realtime-banner-text" class="text-xs text-[#737373] truncate">Mesaj içeriği...</p>
      </div>
    </div>
    <span class="text-xs text-[#0095f6] font-bold shrink-0">Aç ➔</span>
  </div>

  <!-- ================= PATİ PUANI (PAW POINTS) CÜZDAN & ÖDÜL MODALI ================= -->
  <div id="paw-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-[460px] bg-white dark:bg-[#141414] border border-[#dbdbdb] dark:border-[#262626] rounded-2xl shadow-2xl p-6 flex flex-col gap-5 max-h-[90vh] overflow-y-auto no-scrollbar">
      
      <!-- Close Button -->
      <button onclick="closePawPointsModal()" class="absolute top-4 right-4 text-2xl font-light hover:opacity-70">&times;</button>

      <!-- Modal Header -->
      <div class="flex items-center gap-2">
        <span class="text-2xl">🐾</span>
        <div>
          <h2 class="font-bold text-base">Pati Puanı Cüzdanı</h2>
          <p class="text-xs text-[#737373]">Etkileşimde bulun, puan biriktir, seviye atla!</p>
        </div>
      </div>

      <!-- Golden Paw Points Card -->
      <div class="bg-gradient-to-br from-amber-500 via-orange-500 to-pink-600 rounded-2xl p-5 text-white flex flex-col gap-4 shadow-lg relative overflow-hidden">
        <div class="absolute -right-6 -bottom-6 text-9xl opacity-15 pointer-events-none">🐾</div>
        
        <div class="flex items-center justify-between">
          <span class="text-xs uppercase tracking-wider font-semibold opacity-90">Toplam Biriken Puan</span>
          <span id="paw-modal-rank-badge" class="px-2.5 py-1 bg-white/25 backdrop-blur-md text-[11px] font-extrabold rounded-full">Kıvırcık Kaşif 🎾</span>
        </div>

        <div class="flex items-baseline gap-2">
          <span id="paw-modal-points-display" class="text-5xl font-extrabold tracking-tight">125</span>
          <span class="text-lg font-bold">Pati 🐾</span>
        </div>

        <!-- Level Progress Bar -->
        <div class="flex flex-col gap-1.5 pt-1">
          <div class="flex justify-between text-[11px] font-semibold opacity-90">
            <span>İlerleme (Sonraki Seviye: Park Yıldızı ⭐)</span>
            <span id="paw-modal-progress-label">125 / 500</span>
          </div>
          <div class="h-2.5 bg-black/25 rounded-full overflow-hidden p-0.5">
            <div id="paw-modal-progress-bar" class="h-full bg-white rounded-full transition-all duration-500" style="width: 25%;"></div>
          </div>
        </div>
      </div>

      <!-- How to Earn Points Section -->
      <div class="flex flex-col gap-2.5">
        <h4 class="text-xs font-bold text-[#737373] uppercase tracking-wider">Nasıl Pati Puanı Kazanılır?</h4>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="p-3 bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl flex items-center gap-2.5">
            <span class="text-xl">📸</span>
            <div class="flex flex-col">
              <span class="font-bold">Yeni Gönderi</span>
              <span class="text-amber-600 dark:text-amber-400 font-extrabold">+50 Pati</span>
            </div>
          </div>
          <div class="p-3 bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl flex items-center gap-2.5">
            <span class="text-xl">💬</span>
            <div class="flex flex-col">
              <span class="font-bold">Yorum Yapma</span>
              <span class="text-amber-600 dark:text-amber-400 font-extrabold">+10 Pati</span>
            </div>
          </div>
          <div class="p-3 bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl flex items-center gap-2.5">
            <span class="text-xl">❤️</span>
            <div class="flex flex-col">
              <span class="font-bold">Beğeni Alma</span>
              <span class="text-amber-600 dark:text-amber-400 font-extrabold">+5 Pati</span>
            </div>
          </div>
          <div class="p-3 bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl flex items-center gap-2.5">
            <span class="text-xl">🎉</span>
            <div class="flex flex-col">
              <span class="font-bold">Yeni Üyelik</span>
              <span class="text-amber-600 dark:text-amber-400 font-extrabold">+100 Pati</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Paws Rewards / Badges Section -->
      <div class="flex flex-col gap-2.5">
        <h4 class="text-xs font-bold text-[#737373] uppercase tracking-wider">Pati Seviyeleri & Ayrıcalıklar</h4>
        <div class="flex flex-col gap-2 text-xs">
          <div class="p-2.5 bg-gray-50 dark:bg-[#1c1c1c] rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span>🐾</span>
              <span class="font-bold">Yavru Pati</span>
              <span class="text-[#737373] text-[10px]">(0 - 99 Puan)</span>
            </div>
            <span class="text-[11px] font-bold text-gray-500">Başlangıç</span>
          </div>
          <div class="p-2.5 bg-amber-500/10 border border-amber-500/30 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span>🎾</span>
              <span class="font-bold text-amber-600 dark:text-amber-400">Kıvırcık Kaşif</span>
              <span class="text-[#737373] text-[10px]">(100 - 499 Puan)</span>
            </div>
            <span class="text-[10px] font-bold px-2 py-0.5 bg-amber-500 text-white rounded-full">Aktif Seviye</span>
          </div>
          <div class="p-2.5 bg-gray-50 dark:bg-[#1c1c1c] rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span>⭐</span>
              <span class="font-bold">Park Yıldızı</span>
              <span class="text-[#737373] text-[10px]">(500 - 999 Puan)</span>
            </div>
            <span class="text-[11px] font-semibold text-gray-400">Vitrinde Öne Çıkma</span>
          </div>
          <div class="p-2.5 bg-gray-50 dark:bg-[#1c1c1c] rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span>👑</span>
              <span class="font-bold">Poodle Fenomeni</span>
              <span class="text-[#737373] text-[10px]">(1000+ Puan)</span>
            </div>
            <span class="text-[11px] font-semibold text-gray-400">Altın VIP Rozet</span>
          </div>
        </div>
      </div>

      <!-- Point History List -->
      <div class="flex flex-col gap-2">
        <h4 class="text-xs font-bold text-[#737373] uppercase tracking-wider">Son Puan Hareketleri</h4>
        <div id="paw-history-list" class="flex flex-col gap-1.5 text-xs max-h-40 overflow-y-auto no-scrollbar">
          <!-- Populated by JS -->
        </div>
      </div>

    </div>
  </div>

  <!-- ================= AUTHENTICATION MODAL (PHONE & NETGSM 4-DIGIT OTP) ================= -->
  <div id="auth-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">
    <div class="relative w-full max-w-[420px] bg-white dark:bg-[#161616] border border-[#dbdbdb] dark:border-[#2a2a2a] rounded-3xl shadow-2xl p-6 flex flex-col gap-4 text-gray-900 dark:text-gray-100">
      <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-2xl font-light hover:opacity-75">&times;</button>

      <div class="flex flex-col items-center text-center gap-1.5 pt-1">
        <div class="flex items-center gap-2">
          <span class="text-3xl">🐩</span>
          <h1 class="font-logo text-3xl font-bold tracking-wide">YourPoodle</h1>
        </div>
        <p id="auth-subtitle" class="text-xs text-[#737373] px-2 font-medium">Telefon numaranıza SMS ile gelen 4 haneli kod ile anında bağlanın.</p>
      </div>

      <!-- Standard Phone & OTP View -->
      <div id="auth-main-view" class="flex flex-col gap-4">
        <!-- Mode Switcher Tabs (Kayıt Ol / Giriş Yap) -->
      <div id="auth-mode-pills" class="grid grid-cols-2 p-1 bg-gray-100 dark:bg-[#202020] rounded-xl text-xs font-bold">
        <button type="button" id="auth-tab-signup" onclick="switchAuthModeTab('signup')" class="py-2 rounded-lg bg-white dark:bg-[#2a2a2a] text-black dark:text-white shadow-xs transition">
          🐾 Kayıt Ol (+100 Pati)
        </button>
        <button type="button" id="auth-tab-login" onclick="switchAuthModeTab('login')" class="py-2 rounded-lg text-gray-500 hover:text-black dark:hover:text-white transition">
          📲 Giriş Yap
        </button>
      </div>

      <!-- Main Form -->
      <form id="auth-form" onsubmit="handleAuthSubmit(event)" class="flex flex-col gap-3">
        
        <!-- Phone Input Container -->
        <div id="auth-phone-container" class="space-y-1">
          <label class="text-[11px] font-bold text-gray-600 dark:text-gray-300 block">
            Türkiye Cep Telefonu Numaranız
          </label>
          <div class="flex items-center rounded-xl bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] focus-within:border-amber-500 transition overflow-hidden">
            <span class="px-3 py-2.5 bg-gray-100 dark:bg-[#262626] border-r border-[#dbdbdb] dark:border-[#333] text-xs font-extrabold flex items-center gap-1 shrink-0 select-none">
              <span>🇹🇷</span>
              <span>+90</span>
            </span>
            <input id="auth-input-phone" type="tel" placeholder="5XX XXX XX XX" maxlength="14" oninput="formatPhoneInput(this)" class="w-full bg-transparent px-3 py-2.5 text-xs sm:text-sm font-bold tracking-wider outline-none placeholder:font-normal placeholder:tracking-normal placeholder:text-gray-400" required>
          </div>
          <button type="button" id="btn-quick-pattern-mode" onclick="switchToPatternLoginMode()" class="w-full mt-2 py-2 px-3 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 text-xs font-bold transition flex items-center justify-center gap-1.5 border border-dashed border-amber-500/30 cursor-pointer">
            <span>🔒</span>
            <span>Güvenlik Sembolüm ile Hızlı Giriş Yap</span>
          </button>
          <span class="text-[10px] text-gray-400 block pl-1">4 haneli doğrulama kodu Netgsm SMS ile gönderilecektir.</span>
        </div>

        <!-- Signup Specific Fields -->
        <div id="auth-signup-fields" class="flex flex-col gap-2.5">
          <div>
            <label class="text-[11px] font-bold text-gray-600 dark:text-gray-300 block mb-1">Poodle Bilgileri</label>
            <input id="auth-input-poodlename" type="text" placeholder="Poodle'ının Adı (Örn: Mochi)" class="w-full bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl px-3 py-2 text-xs outline-none focus:border-amber-500 transition">
          </div>
          <input id="auth-input-username" type="text" placeholder="Kullanıcı Adı (Örn: mochi_toypoodle)" class="w-full bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl px-3 py-2 text-xs outline-none focus:border-amber-500 transition">
          
          <div class="grid grid-cols-2 gap-2">
            <select id="auth-input-variety" class="bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl px-2.5 py-2 text-xs outline-none focus:border-amber-500">
              <option value="Toy Poodle">Toy Poodle</option>
              <option value="Miniature Poodle">Miniature Poodle</option>
              <option value="Standard Poodle">Standard Poodle</option>
            </select>
            <select id="auth-input-color" class="bg-gray-50 dark:bg-[#1f1f1f] border border-[#dbdbdb] dark:border-[#333] rounded-xl px-2.5 py-2 text-xs outline-none focus:border-amber-500">
              <option value="Red Apricot">Red / Apricot (Kızıl)</option>
              <option value="White">White (Beyaz)</option>
              <option value="Silver">Silver (Gümüş)</option>
              <option value="Black">Black (Siyah)</option>
              <option value="Phantom">Phantom / Parti</option>
            </select>
          </div>
        </div>

        <!-- 4-Digit OTP Code Verification Screen (Hidden until SMS is sent) -->
        <div id="auth-otp-field" class="hidden flex flex-col gap-3 py-1">
          <!-- Info box -->
          <div class="p-3 bg-amber-500/10 border border-amber-500/25 rounded-2xl flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-xl shrink-0">📲</span>
              <div class="min-w-0">
                <span id="auth-otp-phone-display" class="text-xs font-bold text-amber-700 dark:text-amber-400 block truncate">+90 532 *** ** 67</span>
                <span class="text-[10px] text-gray-500 block">4 haneli SMS kodu gönderildi</span>
              </div>
            </div>
            <button type="button" onclick="changeAuthPhone()" class="text-[11px] font-bold text-[#0095f6] hover:underline shrink-0">
              Değiştir ✏️
            </button>
          </div>

          <!-- 4-Digit Input -->
          <div class="flex flex-col items-center gap-1.5">
            <label class="text-xs font-bold text-gray-700 dark:text-gray-300">4 Haneli SMS Doğrulama Kodu</label>
            <input id="auth-input-otp" type="text" maxlength="4" inputmode="numeric" pattern="[0-9]*" placeholder="• • • •" oninput="handleOtpInput(this)" class="w-48 text-center text-3xl font-black tracking-[0.4em] bg-gray-50 dark:bg-[#1f1f1f] border-2 border-amber-500 rounded-2xl py-2.5 outline-none shadow-sm focus:ring-4 focus:ring-amber-500/20 transition">
          </div>

          <!-- Resend & Expiry timer -->
          <div class="flex items-center justify-between text-xs px-1">
            <span id="auth-otp-countdown" class="text-gray-500 font-medium text-[11px]">⏳ Kalan Süre: <strong>03:00</strong></span>
            <button type="button" id="auth-resend-btn" onclick="resendOtpCode()" disabled class="text-[11px] font-bold text-gray-400 disabled:opacity-50 enabled:text-[#0095f6] enabled:hover:underline transition">
              Tekrar Kod Gönder (45s)
            </button>
          </div>
        </div>

        <button id="auth-submit-btn" type="submit" class="w-full py-3 bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 hover:from-amber-600 hover:to-orange-600 text-white text-xs sm:text-sm font-black rounded-xl shadow-md transition active:scale-95 flex items-center justify-center gap-2">
          <span>SMS Doğrulama Kodu Gönder 📲</span>
        </button>
      </form>

      <!-- Alternative Social Logins -->
      <div id="auth-social-box" class="pt-1">
        <div class="flex items-center gap-3 my-2">
          <div class="flex-1 h-px bg-[#dbdbdb] dark:bg-[#262626]"></div>
          <span class="text-[10px] text-[#737373] font-bold uppercase tracking-wider">Veya</span>
          <div class="flex-1 h-px bg-[#dbdbdb] dark:bg-[#262626]"></div>
        </div>

        <div class="grid grid-cols-2 gap-2">
          <button onclick="handleGoogleLoginClick()" class="h-9 border border-[#dbdbdb] dark:border-[#333] hover:bg-gray-50 dark:hover:bg-[#202020] rounded-xl flex items-center justify-center gap-2 text-xs font-semibold transition">
            <svg class="size-3.5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
            <span>Google</span>
          </button>
          <button onclick="handleAppleLoginClick()" class="h-9 bg-black text-white hover:bg-neutral-800 rounded-xl flex items-center justify-center gap-2 text-xs font-semibold transition border border-black dark:border-neutral-700">
            <svg class="size-3.5 fill-current" viewBox="0 0 170 170"><path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.08-7.71-7.91-12.04-14.49-6.3-9.61-11.27-20.44-14.91-32.47-3.64-12.03-5.46-23.23-5.46-33.6 0-14.73 3.65-26.69 10.96-35.88 7.31-9.19 16.51-13.88 27.6-14.07 4.89 0 10.42 1.34 16.6 4.02 6.18 2.68 10.12 4.08 11.83 4.2 1.71-.12 5.92-1.58 12.63-4.37 6.71-2.79 12.07-4.08 16.08-3.87 11.41.67 20.67 4.96 27.78 12.87-9.84 5.97-14.67 14.33-14.49 25.08.2 8.35 3.51 15.48 9.94 21.41 6.43 5.93 14.19 9.38 23.28 10.36-2.16 6.83-4.87 13.82-8.13 20.97zM119.22 33.15c0-7.39 2.67-14.38 8.01-20.97 5.34-6.59 11.96-10.99 19.86-13.18.23 1.25.35 2.45.35 3.6 0 7.39-2.73 14.46-8.19 21.21-5.46 6.75-12.28 11.12-20.46 13.11-.46-1.25-.69-2.51-.69-3.77z"/></svg>
            <span>Apple</span>
          </button>
        </div>
      </div>

      <div class="text-center text-xs text-[#737373] pt-1">
        <span id="auth-switch-text">Zaten bir hesabın var mı?</span>
        <button id="auth-switch-btn" type="button" onclick="toggleAuthMode()" class="text-[#0095f6] font-bold hover:underline ml-1">Giriş Yap</button>
      </div>
      </div>
      
      <!-- ================= PATTERN LOCK (SEMBOL / DESEN KİLİDİ) VIEW ================= -->
      <div id="auth-pattern-view" class="hidden flex flex-col items-center gap-3 animate-scale-up">
        
        <!-- Header Info -->
        <div class="flex flex-col items-center text-center gap-1 pt-1">
          <div id="pattern-avatar-container" class="hidden size-14 rounded-full overflow-hidden border-2 border-amber-500 shadow-md mb-1">
            <img id="pattern-avatar-img" src="/images/poodle_mochi.jpg" class="size-full object-cover">
          </div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">🔒</span>
            <h3 id="pattern-title" class="font-extrabold text-base text-gray-900 dark:text-white">Güvenlik Sembolünü Çiz</h3>
          </div>
          <p id="pattern-subtitle" class="text-xs text-[#737373] max-w-xs leading-snug">
            Parmağınızla en az 4 noktayı birleştirerek sembolünüzü çizin.
          </p>
        </div>

        <!-- Status / Feedback Pill -->
        <div id="pattern-feedback" class="px-3.5 py-1 rounded-full text-xs font-bold text-amber-700 dark:text-amber-400 bg-amber-500/15 border border-amber-500/30 text-center transition">
          En az 4 noktayı birleştirin
        </div>

        <!-- 3x3 SVG Pattern Board -->
        <div id="pattern-lock-board" class="relative w-[280px] h-[280px] mx-auto select-none touch-none bg-gray-50 dark:bg-[#1a1a1a] rounded-3xl border-2 border-gray-200 dark:border-[#333] shadow-inner p-1 cursor-crosshair">
          <svg id="pattern-svg" viewBox="0 0 280 280" class="size-full">
            <defs>
              <linearGradient id="patternGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#f59e0b" />
                <stop offset="100%" stop-color="#ea580c" />
              </linearGradient>
              <filter id="patternGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Connecting Polyline -->
            <polyline id="pattern-polyline" points="" stroke="url(#patternGrad)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none" filter="url(#patternGlow)"/>
            
            <!-- Live Tracking Line -->
            <line id="pattern-track-line" x1="0" y1="0" x2="0" y2="0" stroke="#f59e0b" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="5,4" fill="none" opacity="0"/>

            <!-- 9 Interactive Nodes (Row 1) -->
            <g id="svg-node-1" class="pattern-svg-node" data-id="1">
              <circle cx="47" cy="47" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="47" cy="47" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="47" cy="47" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
            <g id="svg-node-2" class="pattern-svg-node" data-id="2">
              <circle cx="140" cy="47" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="140" cy="47" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="140" cy="47" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
            <g id="svg-node-3" class="pattern-svg-node" data-id="3">
              <circle cx="233" cy="47" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="233" cy="47" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="233" cy="47" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>

            <!-- Row 2 -->
            <g id="svg-node-4" class="pattern-svg-node" data-id="4">
              <circle cx="47" cy="140" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="47" cy="140" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="47" cy="140" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
            <g id="svg-node-5" class="pattern-svg-node" data-id="5">
              <circle cx="140" cy="140" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="140" cy="140" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="140" cy="140" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
            <g id="svg-node-6" class="pattern-svg-node" data-id="6">
              <circle cx="233" cy="140" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="233" cy="140" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="233" cy="140" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>

            <!-- Row 3 -->
            <g id="svg-node-7" class="pattern-svg-node" data-id="7">
              <circle cx="47" cy="233" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="47" cy="233" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="47" cy="233" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
            <g id="svg-node-8" class="pattern-svg-node" data-id="8">
              <circle cx="140" cy="233" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="140" cy="233" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="140" cy="233" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
            <g id="svg-node-9" class="pattern-svg-node" data-id="9">
              <circle cx="233" cy="233" r="22" fill="none" stroke="rgba(150,150,150,0.3)" stroke-width="2" class="p-ring transition-all"/>
              <circle cx="233" cy="233" r="7" fill="#888" class="p-dot transition-all"/>
              <circle cx="233" cy="233" r="36" fill="transparent" class="p-hit pointer-events-none"/>
            </g>
          </svg>
        </div>

        <!-- Pattern Controls & Fallbacks -->
        <div class="w-full flex flex-col gap-2 pt-1 text-xs">
          <div class="flex items-center justify-between w-full px-1">
            <button type="button" onclick="clearPatternBoard()" class="text-gray-400 hover:text-black dark:hover:text-white font-bold transition flex items-center gap-1 cursor-pointer">
              <span>↺</span> Temizle
            </button>
            <button type="button" id="btn-forgot-pattern" onclick="startForgotPatternFlow()" class="text-rose-500 hover:underline font-bold transition cursor-pointer">
              Sembolümü Unuttum ❓
            </button>
          </div>

          <!-- Switch back to SMS OTP -->
          <button type="button" onclick="switchToSmsOtpMode()" class="w-full py-2.5 bg-gray-100 dark:bg-[#252525] hover:bg-gray-200 dark:hover:bg-[#303030] rounded-xl font-bold text-gray-700 dark:text-gray-300 transition flex items-center justify-center gap-1.5 cursor-pointer">
            <span>📲 SMS Kodu ile Giriş Yap</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= STORY VIEWER MODAL ================= -->
  <div id="story-modal" class="fixed inset-0 z-50 bg-black/90 hidden flex items-center justify-center">
    <button onclick="closeStoryViewer()" class="absolute top-4 right-4 text-white text-3xl font-light hover:opacity-75 z-50">&times;</button>
    
    <div class="relative w-full max-w-[420px] h-[90vh] bg-black rounded-2xl overflow-hidden flex flex-col justify-between shadow-2xl">
      <div class="absolute top-3 inset-x-3 flex gap-1 z-30">
        <div class="h-1 flex-1 bg-white/30 rounded-full overflow-hidden">
          <div id="story-progress" class="h-full bg-white transition-all duration-100 ease-linear" style="width: 0%;"></div>
        </div>
      </div>

      <div class="absolute top-6 inset-x-4 flex items-center justify-between text-white z-30">
        <div class="flex items-center gap-2 cursor-pointer group" onclick="closeStoryViewer(); viewUserProfile(document.getElementById('story-username').innerText);">
          <img id="story-avatar" src="/images/poodle_mochi.jpg" class="size-8 rounded-full border border-white object-cover">
          <span id="story-username" class="font-bold text-xs group-hover:underline">mochi_toypoodle</span>
          <span class="text-xs text-white/70">· 2s</span>
        </div>
        <button onclick="closeStoryViewer()" class="text-white text-lg font-bold">&times;</button>
      </div>

      <img id="story-image" src="/images/poodle_mochi.jpg" class="size-full object-cover">

      <!-- Interactive Story Sticker Layer -->
      <div id="story-sticker-container" class="absolute inset-x-6 top-1/2 -translate-y-1/2 z-30 pointer-events-auto"></div>

      <div onclick="prevStory()" class="absolute left-0 top-16 bottom-20 w-1/3 z-20 cursor-pointer"></div>
      <div onclick="nextStory()" class="absolute right-0 top-16 bottom-20 w-2/3 z-20 cursor-pointer"></div>

      <div class="absolute bottom-4 inset-x-4 z-30 flex items-center gap-3">
        <input type="text" placeholder="Yanıt gönder..." onkeydown="if(event.key==='Enter'){storyReply(this)}" class="flex-1 bg-white/20 backdrop-blur-md text-white text-xs px-4 py-2.5 rounded-full outline-none placeholder-white/70 border border-white/30">
        <button onclick="storyReact('❤️')" class="text-xl hover:scale-125 transition">❤️</button>
        <button onclick="storyReact('🔥')" class="text-xl hover:scale-125 transition">🔥</button>
        <button onclick="storyReact('😍')" class="text-xl hover:scale-125 transition">😍</button>
      </div>
    </div>
  </div>

  <!-- ================= 3D DISNEY / PIXAR POODLE AVATAR MODAL ================= -->
  <div id="pixar-avatar-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-md bg-white dark:bg-[#121212] rounded-3xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800 p-6 space-y-5 animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between pb-3 border-b border-gray-100 dark:border-gray-800">
        <div class="flex items-center gap-2.5">
          <div class="size-10 rounded-2xl bg-gradient-to-tr from-purple-600 via-pink-600 to-amber-500 flex items-center justify-center text-xl text-white shadow-md">
            🎨
          </div>
          <div>
            <h3 class="font-black text-base text-gray-900 dark:text-white">Disney / Pixar 3D Avatar</h3>
            <p class="text-xs text-gray-500">Köpeğinizi 3 saniyede 3D Pixar karakterine dönüştürün ✨</p>
          </div>
        </div>
        <button onclick="closePixarModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl font-light">&times;</button>
      </div>

      <!-- Upload or Select -->
      <div class="space-y-3">
        <input type="file" id="site-pixar-file" accept="image/*" class="hidden" onchange="previewSitePixarFile(this)">
        <button onclick="document.getElementById('site-pixar-file').click()" class="w-full py-3 px-4 rounded-2xl border-2 border-dashed border-purple-300 dark:border-purple-800/60 hover:border-purple-500 bg-purple-500/5 hover:bg-purple-500/10 text-xs font-bold text-purple-700 dark:text-purple-300 transition flex items-center justify-center gap-2 cursor-pointer">
          <span>📷</span>
          <span>Galeriden Fotoğraf Seç veya Çek</span>
        </button>
      </div>

      <!-- Preview & Result Area -->
      <div id="site-pixar-preview-area" class="grid grid-cols-2 gap-3 hidden">
        <div class="flex flex-col items-center">
          <span class="text-[11px] font-bold text-gray-400 mb-1">Orijinal</span>
          <img id="site-pixar-orig" src="" class="size-36 object-cover rounded-2xl border border-gray-200 dark:border-gray-800 shadow">
        </div>
        <div class="flex flex-col items-center">
          <span class="text-[11px] font-bold text-purple-600 dark:text-purple-400 mb-1">✨ 3D Pixar Dönüşümü</span>
          <div class="relative size-36">
            <img id="site-pixar-res" src="" class="size-full object-cover rounded-2xl border-2 border-purple-500 shadow-lg">
            <div id="site-pixar-loading" class="absolute inset-0 bg-black/70 backdrop-blur-sm rounded-2xl hidden flex flex-col items-center justify-center text-white">
              <span class="animate-spin text-2xl">🪄</span>
              <span class="text-[10px] font-bold mt-1">Dönüştürülüyor...</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div id="site-pixar-actions" class="hidden flex flex-col sm:flex-row gap-2 pt-2">
        <button onclick="applyPixarAsMyAvatar()" class="flex-1 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 text-white font-extrabold text-xs rounded-xl shadow-md transition active:scale-95 flex items-center justify-center gap-1.5">
          <span>👤 Profil Fotoğrafım Yap</span>
        </button>
        <button onclick="sharePixarToFeed()" class="flex-1 py-3 bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-700 text-white font-extrabold text-xs rounded-xl shadow-md transition active:scale-95 flex items-center justify-center gap-1.5">
          <span>🚀 Akışta Paylaş (+25 Pati)</span>
        </button>
        <a id="site-pixar-dl" href="#" download="yourpoodle_3d_pixar.jpg" class="p-3 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 font-bold text-xs rounded-xl transition flex items-center justify-center" title="İndir">
          💾
        </a>
      </div>
    </div>
  </div>

  <!-- ================= SHOPPABLE PRODUCT TAG DETAIL MODAL ================= -->
  <div id="product-tag-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-sm bg-white dark:bg-[#161616] rounded-3xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800 p-5 space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl">🛍️</span>
          <h4 id="prod-modal-title" class="font-extrabold text-sm text-gray-900 dark:text-white">Poodle Yağmurluğu</h4>
        </div>
        <button onclick="closeProductTagModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
      </div>

      <div class="space-y-2 text-xs">
        <div class="flex items-center justify-between p-3 rounded-2xl bg-amber-500/10 border border-amber-500/30">
          <span class="font-bold text-gray-600 dark:text-gray-300">Fiyat:</span>
          <span id="prod-modal-price" class="text-base font-black text-amber-600 dark:text-amber-400">380 ₺</span>
        </div>
        <div class="flex items-center justify-between p-2.5 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-700 dark:text-purple-300 font-bold">
          <span>Pati İndirimi:</span>
          <span id="prod-modal-paws">50 Paw Puanı</span>
        </div>
      </div>

      <div class="pt-2 flex gap-2">
        <button onclick="claimPawDiscountAndShop()" class="flex-1 py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-extrabold text-xs rounded-xl shadow-md transition active:scale-95 flex items-center justify-center gap-1.5">
          <span>🐾 İndirimle Satın Al / İncele</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= CREATE POST MODAL (LIVE CAMERA & GALLERY UPLOAD) ================= -->
  <div id="create-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-3 md:p-4">
    <div class="relative w-full max-w-[640px] bg-white dark:bg-[#1e1e1e] border border-[#dbdbdb] dark:border-[#333] rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[92vh]">
      <!-- Header -->
      <div class="p-3.5 border-b border-[#dbdbdb] dark:border-[#333] flex items-center justify-between shrink-0">
        <button onclick="closeCreateModal()" class="text-sm font-semibold hover:opacity-70">&times; Kapat</button>
        <div class="flex items-center gap-1.5">
          <h3 class="font-bold text-sm">Yeni Gönderi Paylaş</h3>
          <span class="text-[11px] font-extrabold text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded-full">+50 Pati 🐾</span>
        </div>
        <button id="create-submit-btn" onclick="submitNewPost()" class="text-sm font-bold text-[#0095f6] hover:text-[#1877f2] flex items-center gap-1">
          <span>Paylaş</span>
        </button>
      </div>

      <!-- Upload Progress Overlay (Hidden by default) -->
      <div id="upload-progress-container" class="hidden p-4 bg-amber-50 dark:bg-amber-950/40 border-b border-amber-200 dark:border-amber-900/50 flex flex-col gap-2">
        <div class="flex items-center justify-between text-xs font-bold text-amber-800 dark:text-amber-200">
          <span id="upload-progress-status">Fotoğraf / Video sunucuya yükleniyor... 🐾</span>
          <span id="upload-progress-percent">0%</span>
        </div>
        <div class="w-full h-2 bg-amber-200 dark:bg-amber-900/50 rounded-full overflow-hidden">
          <div id="upload-progress-bar" class="h-full bg-gradient-to-r from-amber-500 to-pink-500 transition-all duration-300" style="width: 15%;"></div>
        </div>
      </div>

      <div class="p-4 md:p-6 flex flex-col md:flex-row gap-5 overflow-y-auto">
        <!-- Media Upload & Preview Column -->
        <div class="w-full md:w-64 flex flex-col items-center gap-3 shrink-0">
          <!-- Live Preview Container -->
          <div class="size-64 bg-gray-100 dark:bg-[#141414] rounded-xl overflow-hidden relative border-2 border-dashed border-[#dbdbdb] dark:border-[#444] flex items-center justify-center group shadow-inner">
            <img id="create-preview-img" src="/images/poodle_teddy.jpg" class="size-full object-cover transition-all">
            <video id="create-preview-video" class="size-full object-cover hidden" controls playsinline loop muted autoplay></video>
            
            <!-- Type badge -->
            <div id="create-media-badge" class="absolute top-2 left-2 px-2 py-0.5 bg-black/60 backdrop-blur-md text-white text-[10px] font-bold rounded-full">
              📷 Fotoğraf
            </div>

            <!-- Hover overlay -->
            <div onclick="triggerGalleryUpload()" class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition flex flex-col items-center justify-center text-white text-xs font-bold gap-1 cursor-pointer">
              <span>🔄 Medyayı Değiştir</span>
              <span class="text-[10px] text-gray-300">Kamera veya Galeri</span>
            </div>
          </div>

          <!-- Hidden Native Inputs for Camera and Gallery -->
          <input type="file" id="camera-file-input" accept="image/*,video/*" capture="environment" class="hidden" onchange="handleLiveMediaSelected(event)">
          <input type="file" id="gallery-file-input" accept="image/*,video/*" class="hidden" onchange="handleLiveMediaSelected(event)">

          <!-- Phone Camera & Gallery Trigger Buttons -->
          <div class="grid grid-cols-2 gap-2 w-full">
            <button type="button" onclick="triggerCameraCapture()" class="py-2.5 px-3 bg-gradient-to-r from-pink-500 to-rose-500 text-white hover:opacity-90 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm active:scale-95">
              <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <span>Kamera Çek</span>
            </button>
            <button type="button" onclick="triggerGalleryUpload()" class="py-2.5 px-3 bg-gray-100 hover:bg-gray-200 dark:bg-[#2a2a2a] dark:hover:bg-[#333] text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 active:scale-95 border border-[#dbdbdb] dark:border-[#444]">
              <svg class="size-4 text-[#0095f6]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>Galeriden Seç</span>
            </button>
          </div>

          <!-- Quick Filter Selector for Image -->
          <div id="image-filters-bar" class="w-full flex items-center justify-between text-[10px] font-semibold text-[#737373] pt-1">
            <button type="button" onclick="applyImageFilter('none')" class="filter-btn active text-[#0095f6]">Normal</button>
            <button type="button" onclick="applyImageFilter('glow')" class="filter-btn hover:text-black dark:hover:text-white">Glow ✨</button>
            <button type="button" onclick="applyImageFilter('warm')" class="filter-btn hover:text-black dark:hover:text-white">Sıcak ☀️</button>
            <button type="button" onclick="applyImageFilter('sepia')" class="filter-btn hover:text-black dark:hover:text-white">Retro 🎞️</button>
            <button type="button" onclick="applyImageFilter('bw')" class="filter-btn hover:text-black dark:hover:text-white">B&W 🖤</button>
          </div>
        </div>

        <!-- Form Details Column -->
        <div class="flex-1 w-full flex flex-col gap-3.5">
          <!-- User / Poodle Info -->
          <div class="flex items-center gap-2.5 pb-1">
            <img id="create-user-avatar" src="/images/poodle_mochi.jpg" class="size-8 rounded-full object-cover border border-[#dbdbdb] dark:border-[#333]">
            <div class="flex flex-col">
              <span id="create-user-name" class="font-bold text-xs">Mochi The Red Toy</span>
              <span class="text-[10px] text-[#737373]">Poodle Profiliyle Paylaşılıyor</span>
            </div>
          </div>

          <!-- Caption Textarea -->
          <div class="flex flex-col gap-1">
            <textarea id="create-caption" rows="3" placeholder="Poodle'ın hakkında bir açıklama yaz... 🐾 #toypoodle #poodlelove" class="w-full bg-transparent text-sm p-3 border border-[#dbdbdb] dark:border-[#444] rounded-xl outline-none resize-none focus:border-[#0095f6] dark:focus:border-[#0095f6] transition"></textarea>
            
            <!-- Quick Emojis -->
            <div class="flex items-center gap-1.5 text-sm pt-0.5">
              <button type="button" onclick="insertEmoji('🐩')" class="hover:scale-125 transition">🐩</button>
              <button type="button" onclick="insertEmoji('🐾')" class="hover:scale-125 transition">🐾</button>
              <button type="button" onclick="insertEmoji('❤️')" class="hover:scale-125 transition">❤️</button>
              <button type="button" onclick="insertEmoji('🎾')" class="hover:scale-125 transition">🎾</button>
              <button type="button" onclick="insertEmoji('🧸')" class="hover:scale-125 transition">🧸</button>
              <button type="button" onclick="insertEmoji('🐶')" class="hover:scale-125 transition">🐶</button>
              <button type="button" onclick="insertEmoji('✨')" class="hover:scale-125 transition">✨</button>
            </div>
          </div>

          <!-- Location Input -->
          <div class="relative">
            <input id="create-location" type="text" placeholder="Konum ekle (Örn: Bebek Parkı, İstanbul)" class="w-full bg-transparent text-xs p-3 pl-8 border border-[#dbdbdb] dark:border-[#444] rounded-xl outline-none focus:border-[#0095f6] dark:focus:border-[#0095f6] transition">
            <svg class="size-4 text-[#737373] absolute left-2.5 top-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>

          <!-- Quick Location Shortcuts -->
          <div class="flex gap-1.5 flex-wrap text-[11px] text-[#737373]">
            <span class="font-semibold text-[10px] self-center">Önerilen:</span>
            <button type="button" onclick="selectLocationPreset('Bebek Parkı, İstanbul')" class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full">Bebek Parkı</button>
            <button type="button" onclick="selectLocationPreset('Nişantaşı, İstanbul')" class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full">Nişantaşı</button>
            <button type="button" onclick="selectLocationPreset('Caddebostan Sahil')" class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-full">Caddebostan</button>
          </div>

          <!-- Or Choose from Featured Poodles -->
          <div class="pt-2 border-t border-gray-100 dark:border-gray-800 flex flex-col gap-1.5">
            <label class="text-[11px] font-bold text-[#737373]">Veya Hazır Toy Poodle Fotoğraflarından Seç:</label>
            <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
              <img onclick="selectPresetPhoto('/images/poodle_teddy.jpg')" src="/images/poodle_teddy.jpg" class="size-11 rounded-lg object-cover cursor-pointer hover:ring-2 ring-[#0095f6] shrink-0">
              <img onclick="selectPresetPhoto('/images/poodle_luna.jpg')" src="/images/poodle_luna.jpg" class="size-11 rounded-lg object-cover cursor-pointer hover:ring-2 ring-[#0095f6] shrink-0">
              <img onclick="selectPresetPhoto('/images/poodle_coco.jpg')" src="/images/poodle_coco.jpg" class="size-11 rounded-lg object-cover cursor-pointer hover:ring-2 ring-[#0095f6] shrink-0">
              <img onclick="selectPresetPhoto('/images/poodle_bella.jpg')" src="/images/poodle_bella.jpg" class="size-11 rounded-lg object-cover cursor-pointer hover:ring-2 ring-[#0095f6] shrink-0">
              <img onclick="selectPresetPhoto('/images/poodle_oliver.jpg')" src="/images/poodle_oliver.jpg" class="size-11 rounded-lg object-cover cursor-pointer hover:ring-2 ring-[#0095f6] shrink-0">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= NOTIFICATIONS & PUSH MODAL ================= -->
  <div id="notif-modal" class="fixed inset-0 z-50 bg-black/60 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg bg-white dark:bg-[#1a1a1a] rounded-3xl overflow-hidden shadow-2xl p-4 sm:p-5 flex flex-col gap-3.5 max-h-[88vh] border border-[#dbdbdb] dark:border-[#2e2e2e]">
      
      <!-- Modern Header -->
      <div class="flex items-center justify-between border-b border-gray-100 dark:border-[#282828] pb-3">
        <div class="flex items-center gap-2.5">
          <div class="size-9 rounded-2xl bg-gradient-to-tr from-rose-500 via-pink-500 to-amber-500 text-white flex items-center justify-center text-base shadow-sm">
            ❤️
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-extrabold text-base text-gray-900 dark:text-white">Bildirimler</h3>
              <span id="notif-badge-pill" class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/25">Canlı</span>
            </div>
            <p class="text-[11px] text-[#737373]">Beğeni, yorum ve takip hareketleriniz</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="markAllNotificationsRead()" class="px-3 py-1.5 rounded-xl bg-sky-50 hover:bg-sky-100 dark:bg-sky-950/40 text-[#0095f6] text-xs font-bold transition active:scale-95 cursor-pointer select-none" title="Tümünü Okundu Say">
            ✓ Okundu Say
          </button>
          <button type="button" onclick="closeNotificationsModal()" class="size-8 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-[#282828] dark:hover:bg-[#333] text-gray-500 hover:text-black dark:hover:text-white flex items-center justify-center text-lg font-bold transition active:scale-90 cursor-pointer select-none" title="Kapat">
            &times;
          </button>
        </div>
      </div>

      <!-- Compact Live Push Notification Bar -->
      <div class="p-2.5 sm:p-3 bg-gradient-to-r from-purple-500/10 via-pink-500/10 to-amber-500/10 border border-pink-500/20 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 shadow-xs">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">📲</span>
          <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
              <span class="font-bold text-xs text-gray-900 dark:text-white">Canlı Telefon Bildirimleri</span>
              <span id="push-status-badge" class="px-1.5 py-0.2 text-[9px] font-extrabold rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">Aktif 🔔</span>
            </div>
            <span class="text-[10px] text-[#737373]">Kilit ekranı ve bildirim çubuğunda anlık uyarılar</span>
          </div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0 justify-end">
          <button type="button" onclick="testPhoneNotification('like')" class="px-3 py-1.5 bg-white dark:bg-[#222] hover:bg-rose-50 dark:hover:bg-rose-950/40 border border-gray-200 dark:border-[#383838] rounded-xl text-[11px] font-bold text-gray-700 dark:text-gray-200 shadow-xs transition active:scale-95 cursor-pointer select-none flex items-center gap-1" title="Beğeni Bildirimi Gönder">
            <span>❤️</span>
            <span>Beğeni Testi</span>
          </button>
          <button type="button" onclick="testPhoneNotification('message')" class="px-3 py-1.5 bg-white dark:bg-[#222] hover:bg-sky-50 dark:hover:bg-sky-950/40 border border-gray-200 dark:border-[#383838] rounded-xl text-[11px] font-bold text-gray-700 dark:text-gray-200 shadow-xs transition active:scale-95 cursor-pointer select-none flex items-center gap-1" title="Mesaj Bildirimi Gönder">
            <span>💬</span>
            <span>Mesaj Testi</span>
          </button>
        </div>
      </div>

      <!-- Notification Filter Tabs (No scrollbar, smooth pills) -->
      <div class="flex items-center justify-between gap-2 border-b border-gray-100 dark:border-[#262626] pb-2">
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 max-w-full">
          <button type="button" onclick="filterNotificationList('all', this)" class="notif-tab-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-[#0095f6] text-white shadow-xs shrink-0 cursor-pointer transition active:scale-95 select-none">Tümü</button>
          <button type="button" onclick="filterNotificationList('like', this)" class="notif-tab-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 hover:bg-gray-200 dark:bg-[#252525] dark:hover:bg-[#303030] text-gray-700 dark:text-gray-300 shrink-0 cursor-pointer transition active:scale-95 select-none flex items-center gap-1">
            <span>❤️</span>
            <span>Beğeni</span>
          </button>
          <button type="button" onclick="filterNotificationList('comment', this)" class="notif-tab-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 hover:bg-gray-200 dark:bg-[#252525] dark:hover:bg-[#303030] text-gray-700 dark:text-gray-300 shrink-0 cursor-pointer transition active:scale-95 select-none flex items-center gap-1">
            <span>💬</span>
            <span>Yorum</span>
          </button>
          <button type="button" onclick="filterNotificationList('follow', this)" class="notif-tab-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 hover:bg-gray-200 dark:bg-[#252525] dark:hover:bg-[#303030] text-gray-700 dark:text-gray-300 shrink-0 cursor-pointer transition active:scale-95 select-none flex items-center gap-1">
            <span>👤</span>
            <span>Takip</span>
          </button>
          <button type="button" onclick="filterNotificationList('community', this)" class="notif-tab-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 hover:bg-gray-200 dark:bg-[#252525] dark:hover:bg-[#303030] text-gray-700 dark:text-gray-300 shrink-0 cursor-pointer transition active:scale-95 select-none flex items-center gap-1">
            <span>🐩</span>
            <span>Topluluk</span>
          </button>
        </div>
        <button type="button" onclick="openNotifPreferencesModal()" class="px-2.5 py-1.5 rounded-xl text-xs font-bold text-gray-600 dark:text-gray-300 bg-gray-100 hover:bg-gray-200 dark:bg-[#252525] dark:hover:bg-[#303030] flex items-center gap-1 shrink-0 transition active:scale-95 cursor-pointer shadow-xs select-none" title="Bildirim Ayarları">
          <span>⚙️</span>
          <span class="hidden sm:inline">Ayarlar</span>
        </button>
      </div>

      <!-- Dynamic Notifications Feed -->
      <div id="notifications-list-container" class="flex flex-col gap-2.5 overflow-y-auto max-h-[52vh] pr-1 no-scrollbar">
        <!-- Rendered via JS renderNotifications() -->
      </div>
    </div>
  </div>

  <!-- ================= NOTIFICATION PERMISSION PROMPT MODAL ================= -->
  <div id="notif-permission-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-6 flex flex-col items-center text-center gap-4">
      <div class="size-16 rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 p-0.5 flex items-center justify-center shadow-lg">
        <div class="size-full bg-white dark:bg-[#1a1a1a] rounded-full flex items-center justify-center text-2xl">
          🔔
        </div>
      </div>

      <div class="flex flex-col gap-1.5">
        <h3 class="font-bold text-base">YourPoodle Bildirimlerini Aç</h3>
        <p class="text-xs text-[#737373] leading-relaxed">
          Telefonuna <strong>"Luna senin fotoğrafını beğendi"</strong> veya <strong>"Yeni bir mesajın var"</strong> canlı bildirimlerinin düşmesi için izin ver.
        </p>
      </div>

      <div class="flex flex-col gap-2 w-full pt-1">
        <button onclick="enablePushNotifications()" class="w-full py-2.5 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-bold rounded-xl transition shadow-md active:scale-95">
          Bildirimleri Aç (İzin Ver) 🐾
        </button>
        <button onclick="dismissNotifPermission()" class="w-full py-2 bg-transparent text-[#737373] hover:text-black dark:hover:text-white text-xs font-semibold rounded-xl transition">
          Şimdi Değil
        </button>
      </div>
  </div>

  <!-- ================= OTHER USER / POODLE PROFILE MODAL ================= -->
  <div id="user-profile-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-2 sm:p-4">
    <div class="relative w-full max-w-[700px] bg-white dark:bg-[#121212] border border-[#dbdbdb] dark:border-[#262626] rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[92vh]">
      <!-- Header -->
      <div class="p-3.5 border-b border-[#dbdbdb] dark:border-[#262626] flex items-center justify-between shrink-0">
        <button onclick="closeUserProfileModal()" class="text-xs font-semibold flex items-center gap-1 hover:opacity-70">
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          <span>Geri</span>
        </button>
        <div class="flex items-center gap-1">
          <h3 id="other-profile-title-user" class="font-bold text-sm">luna_apricot</h3>
          <span id="other-profile-verified" title="Doğrulanmış Poodle (Mavi Pati) 🐾">
            <svg class="size-3.5 text-[#0095f6]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
              <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
              <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
              <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
              <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
              <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
            </svg>
          </span>
        </div>
        <button onclick="showToast('Profil bağlantısı kopyalandı!')" class="text-xs font-semibold hover:opacity-70">
          <svg class="size-5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1.5"/><circle cx="6" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/></svg>
        </button>
      </div>

      <!-- Profile Content Scrollable -->
      <div class="p-4 sm:p-6 overflow-y-auto flex flex-col gap-6">
        <!-- Top Profile Info -->
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
          <!-- Avatar -->
          <div class="size-20 sm:size-24 p-1 rounded-full ig-gradient-ring shrink-0 cursor-pointer">
            <img id="other-profile-avatar" src="/images/poodle_luna.jpg" class="size-full object-cover rounded-full border-2 border-white dark:border-black">
          </div>

          <!-- Stats & Bio -->
          <div class="flex-1 flex flex-col gap-3 text-center sm:text-left w-full">
            <div class="flex items-center justify-center sm:justify-start gap-6 text-xs sm:text-sm">
              <span><strong id="other-profile-posts">34</strong> gönderi</span>
              <span><strong id="other-profile-followers">62.4B</strong> takipçi</span>
              <span><strong id="other-profile-following">185</strong> takip</span>
            </div>

            <!-- Name & Badges -->
            <div class="flex flex-col gap-1">
              <div class="flex items-center justify-center sm:justify-start gap-1.5 flex-wrap">
                <span id="other-profile-name" class="font-bold text-sm">Luna & Leo 🐾</span>
                <span id="other-profile-variety" class="px-2 py-0.5 bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-[10px] rounded-full border border-amber-500/20">Toy Poodle</span>
                <span id="other-profile-color" class="px-2 py-0.5 bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-[10px] rounded-full border border-purple-500/20">Apricot</span>
                <span id="other-profile-rank" class="px-2 py-0.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] rounded-full border border-emerald-500/20">Park Yıldızı ⭐</span>
              </div>
              <p id="other-profile-bio" class="text-xs text-gray-700 dark:text-gray-300">Teddy Bear tıraş aşığı minik prenses 🐩🎀</p>
              <p id="other-profile-location" class="text-[11px] text-[#737373]">📍 Nişantaşı, İstanbul</p>
            </div>

            <!-- Action Buttons: Follow, Message, Treat Paw Points -->
            <div class="flex gap-2 pt-1 w-full">
              <button id="other-profile-follow-btn" onclick="toggleOtherProfileFollow()" class="flex-1 py-1.5 px-4 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-semibold rounded-lg transition active:scale-95">
                Takip Et
              </button>
              <button onclick="sendDirectMessageToOther()" class="flex-1 py-1.5 px-4 bg-gray-100 dark:bg-[#262626] hover:bg-gray-200 dark:hover:bg-[#333] text-black dark:text-white text-xs font-semibold rounded-lg transition flex items-center justify-center gap-1 active:scale-95">
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <span>Mesaj</span>
              </button>
              <button onclick="giftPawPointsToOther()" class="py-1.5 px-3 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-bold rounded-lg transition flex items-center gap-1 active:scale-95" title="10 Pati Puanı Hediye Et">
                <span>🐾</span>
                <span class="hidden sm:inline">Pati Maması</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Story Highlights -->
        <div id="other-profile-highlights" class="flex items-center gap-4 overflow-x-auto no-scrollbar pb-2 border-b border-[#dbdbdb] dark:border-[#262626]">
          <!-- Rendered via JS -->
        </div>

        <!-- Tabs Header -->
        <div class="flex justify-center gap-8 text-[11px] font-bold tracking-wider text-[#737373] border-b border-[#dbdbdb] dark:border-[#262626]">
          <button class="flex items-center gap-1.5 py-2.5 border-t-2 border-black dark:border-white text-black dark:text-white">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            GÖNDERİLER
          </button>
          <button class="flex items-center gap-1.5 py-2.5 hover:text-black dark:hover:text-white">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><polygon points="10 9 15 12 10 15 10 9"/></svg>
            REELS
          </button>
        </div>

        <!-- Photo Grid -->
        <div id="other-profile-grid" class="grid grid-cols-3 gap-1 md:gap-2">
          <!-- Rendered via JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- ================= POODLE / ACCOUNT SWITCHER MODAL ================= -->
  <div id="poodle-switcher-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white dark:bg-[#1e1e1e] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#dbdbdb] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🐩</span>
          <h3 class="font-bold text-sm">Poodle Profilleri</h3>
        </div>
        <button onclick="closePoodleSwitcherModal()" class="text-xl font-bold leading-none">&times;</button>
      </div>

      <!-- Dynamic Poodle List from Server -->
      <div id="poodle-switcher-list" class="flex flex-col gap-2 max-h-64 overflow-y-auto pr-1">
        <div class="py-4 text-center text-xs text-gray-500">Poodle profilleri yükleniyor...</div>
      </div>

      <button onclick="closePoodleSwitcherModal(); openAddPoodleModal();" class="w-full py-2.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 border border-dashed border-amber-500/40">
        <span>➕ Yeni Poodle Profili Ekle</span>
      </button>
    </div>
  </div>

  <!-- ================= ADD NEW POODLE MODAL ================= -->
  <div id="add-poodle-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white dark:bg-[#1a1a1a] text-gray-900 dark:text-gray-100 rounded-2xl overflow-hidden shadow-2xl border border-[#dbdbdb] dark:border-[#333] flex flex-col max-h-[90vh]">
      <div class="p-4 border-b border-[#efefef] dark:border-[#2a2a2a] flex items-center justify-between bg-gray-50 dark:bg-[#202020]">
        <div class="flex items-center gap-2">
          <span class="text-xl">🐾</span>
          <h3 class="font-bold text-sm sm:text-base">Yeni Poodle Profili Ekle</h3>
        </div>
        <button onclick="closeAddPoodleModal()" class="text-gray-400 hover:text-black dark:hover:text-white p-1 rounded-lg text-lg leading-none">&times;</button>
      </div>

      <form id="add-poodle-form" onsubmit="submitAddPoodle(event)" class="p-5 space-y-3.5 overflow-y-auto flex-1">
        <div>
          <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Poodle Adı *</label>
          <input type="text" id="new-poodle-name" required placeholder="Örn: Bella, Charlie, Coco..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs sm:text-sm font-bold focus:outline-none focus:border-[#0095f6]">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Irk Varyasyonu</label>
            <select id="new-poodle-variety" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
              <option value="Toy Poodle">Toy Poodle</option>
              <option value="Minyatür Poodle">Minyatür Poodle</option>
              <option value="Standart Poodle">Standart Poodle</option>
              <option value="Medium Poodle">Moyen Poodle</option>
            </select>
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Kürk Rengi</label>
            <select id="new-poodle-color" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
              <option value="Red Apricot">Red Apricot</option>
              <option value="Apricot Cream">Apricot Cream</option>
              <option value="Chocolate Brown">Chocolate Brown</option>
              <option value="Black">Black</option>
              <option value="White">White</option>
              <option value="Silver Grey">Silver Grey</option>
              <option value="Parti Color">Parti Color</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Ağırlık (kg)</label>
            <input type="text" id="new-poodle-weight" placeholder="Örn: 2.80" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Doğum Tarihi</label>
            <input type="date" id="new-poodle-birth" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
        </div>

        <div>
          <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Mikroçip No (Opsiyonel)</label>
          <input type="text" id="new-poodle-chip" placeholder="TR-98200..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-mono font-semibold focus:outline-none focus:border-[#0095f6]">
        </div>

        <div class="pt-3 border-t border-gray-100 dark:border-[#2a2a2a] flex items-center justify-end gap-2">
          <button type="button" onclick="closeAddPoodleModal()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 dark:hover:bg-[#252525] rounded-xl transition">Vazgeç</button>
          <button type="submit" id="btn-save-new-poodle" class="px-5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold rounded-xl shadow-md transition flex items-center gap-1.5">
            <span>🐾 Poodle'ı Ekle ve Aktif Yap</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= EDIT POODLE & OWNER PROFILE MODAL ================= -->
  <div id="edit-profile-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg bg-white dark:bg-[#1a1a1a] text-gray-900 dark:text-gray-100 rounded-2xl overflow-hidden shadow-2xl border border-[#dbdbdb] dark:border-[#333] flex flex-col max-h-[90vh]">
      <div class="p-4 border-b border-[#efefef] dark:border-[#2a2a2a] flex items-center justify-between bg-gray-50 dark:bg-[#202020]">
        <div class="flex items-center gap-2">
          <span class="text-xl">✏️</span>
          <h3 class="font-bold text-sm sm:text-base">Poodle & Profil Bilgilerini Düzenle</h3>
        </div>
        <button onclick="closeEditProfileModal()" class="text-gray-400 hover:text-black dark:hover:text-white p-1 rounded-lg text-lg leading-none">&times;</button>
      </div>

      <form id="edit-profile-form" onsubmit="submitEditProfile(event)" class="p-5 space-y-4 overflow-y-auto flex-1">
        <!-- Poodle Photo & Display Name -->
        <div class="flex items-center gap-4 pb-3 border-b border-gray-100 dark:border-[#2a2a2a]">
          <div class="relative group cursor-pointer" onclick="document.getElementById('edit-profile-avatar-input').click()" title="Fotoğraf Değiştir">
            <img id="edit-avatar-preview" src="/images/poodle_mochi.jpg" class="size-16 rounded-full object-cover border-2 border-[#0095f6]">
            <div class="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition text-white text-xs font-bold">
              📷
            </div>
            <input type="file" id="edit-profile-avatar-input" accept="image/*" class="hidden" onchange="handleEditAvatarChange(event)">
          </div>
          <div class="flex-1">
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Poodle Adı *</label>
            <input type="text" id="edit-poodle-name" required class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs sm:text-sm font-bold focus:outline-none focus:border-[#0095f6]">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Sahip Adı</label>
            <input type="text" id="edit-owner-name" placeholder="Örn: Emre Yılmaz" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Şehir / Lokasyon</label>
            <input type="text" id="edit-poodle-city" placeholder="Örn: İstanbul, Moda" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
        </div>

        <div>
          <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Biyografi & Hikaye</label>
          <textarea id="edit-poodle-bio" rows="2" placeholder="Poodle'ınız hakkında kısa bilgi..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs focus:outline-none focus:border-[#0095f6]"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Irk Varyasyonu</label>
            <select id="edit-poodle-variety" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
              <option value="Toy Poodle">Toy Poodle (24-28 cm)</option>
              <option value="Minyatür Poodle">Minyatür Poodle (28-35 cm)</option>
              <option value="Standart Poodle">Standart Poodle (38-60 cm)</option>
              <option value="Medium (Moyen) Poodle">Moyen Poodle (35-45 cm)</option>
            </select>
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Kürk Rengi</label>
            <select id="edit-poodle-color" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
              <option value="Red Apricot">Red Apricot</option>
              <option value="Apricot Cream">Apricot Cream</option>
              <option value="Chocolate Brown">Chocolate Brown</option>
              <option value="Black">Black (Kuzguni Siyah)</option>
              <option value="White">White (Kar Beyaz)</option>
              <option value="Silver Grey">Silver Grey (Gümüş Gri)</option>
              <option value="Phantom / Parti">Phantom / Parti Color</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Ağırlık (kg)</label>
            <input type="text" id="edit-poodle-weight" placeholder="2.85" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Doğum Tarihi</label>
            <input type="date" id="edit-poodle-birth" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-500 uppercase block mb-1">Mikroçip No</label>
            <input type="text" id="edit-poodle-chip" placeholder="TR-98200..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl text-xs font-mono font-semibold focus:outline-none focus:border-[#0095f6]">
          </div>
        </div>

        <div class="pt-3 border-t border-gray-100 dark:border-[#2a2a2a] flex items-center justify-end gap-2">
          <button type="button" onclick="closeEditProfileModal()" class="px-4 py-2 text-xs font-bold text-gray-500 hover:bg-gray-100 dark:hover:bg-[#252525] rounded-xl transition">Vazgeç</button>
          <button type="submit" id="btn-save-profile" class="px-5 py-2 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-bold rounded-xl shadow-md transition flex items-center gap-1.5">
            <span>💾 Değişiklikleri Kaydet</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= SEARCH DRAWER / MODAL ================= -->
  <div id="search-drawer-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-start justify-center p-3 sm:p-6 backdrop-blur-sm">
    <div class="w-full max-w-lg bg-white dark:bg-[#1a1a1a] text-gray-900 dark:text-gray-100 rounded-2xl overflow-hidden shadow-2xl border border-[#dbdbdb] dark:border-[#333] flex flex-col max-h-[85vh] mt-8 sm:mt-12">
      <div class="p-4 border-b border-[#efefef] dark:border-[#2a2a2a] flex items-center gap-3">
        <svg class="size-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="search-live-input" oninput="handleLiveSearch(this.value)" placeholder="Poodle, sahip, ırk, mikroçip veya konu ara..." class="w-full bg-transparent text-sm font-semibold outline-none placeholder-gray-400" autocomplete="off" autofocus>
        <button onclick="closeSearchModal()" class="text-gray-400 hover:text-black dark:hover:text-white p-1 rounded-lg text-lg leading-none">&times;</button>
      </div>

      <!-- Quick category pills -->
      <div class="px-4 py-2 border-b border-gray-100 dark:border-[#252525] flex items-center gap-1.5 overflow-x-auto no-scrollbar text-[11px]">
        <button onclick="setSearchFilter('all')" class="search-filter-pill px-3 py-1 rounded-full font-bold bg-[#0095f6] text-white">Tümü</button>
        <button onclick="setSearchFilter('Toy Poodle')" class="search-filter-pill px-3 py-1 rounded-full font-bold bg-gray-100 dark:bg-[#262626] text-gray-600 dark:text-gray-300 hover:bg-gray-200">Toy Poodle</button>
        <button onclick="setSearchFilter('Minyatür')" class="search-filter-pill px-3 py-1 rounded-full font-bold bg-gray-100 dark:bg-[#262626] text-gray-600 dark:text-gray-300 hover:bg-gray-200">Minyatür</button>
        <button onclick="setSearchFilter('Sağlık')" class="search-filter-pill px-3 py-1 rounded-full font-bold bg-gray-100 dark:bg-[#262626] text-gray-600 dark:text-gray-300 hover:bg-gray-200">Aşı & Bakım</button>
        <button onclick="setSearchFilter('Eğitim')" class="search-filter-pill px-3 py-1 rounded-full font-bold bg-gray-100 dark:bg-[#262626] text-gray-600 dark:text-gray-300 hover:bg-gray-200">Eğitim</button>
      </div>

      <!-- Search Results Area -->
      <div id="search-results-container" class="flex-1 overflow-y-auto p-3 divide-y divide-gray-100 dark:divide-[#252525] min-h-[240px]">
        <div class="py-10 text-center text-gray-400 text-xs">
          <span class="text-3xl block mb-2">🔍</span>
          Aramak istediğin Poodle dostunu, sahibini veya konuyu yazmaya başla...
        </div>
      </div>
    </div>
  </div>

  <!-- ================= SHARE / DIRECT SEND MODAL ================= -->
  <div id="share-post-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-4">
    <div class="relative w-full max-w-[420px] bg-white dark:bg-[#141414] border border-[#dbdbdb] dark:border-[#262626] rounded-2xl shadow-2xl p-5 flex flex-col gap-4 max-h-[85vh] overflow-y-auto no-scrollbar">
      
      <!-- Close Button -->
      <button onclick="closeSharePostModal()" class="absolute top-4 right-4 text-2xl font-light hover:opacity-70">&times;</button>

      <!-- Modal Header -->
      <div class="flex items-center gap-2">
        <svg class="size-5 text-[#0095f6]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        <h3 class="font-bold text-sm">Gönderiyi Paylaş & DM Gönder</h3>
      </div>

      <!-- Post Mini Preview -->
      <div id="share-post-preview" class="p-2.5 bg-gray-50 dark:bg-[#1e1e1e] rounded-xl flex items-center gap-3 border border-[#dbdbdb] dark:border-[#333]">
        <img id="share-preview-thumb" src="/images/poodle_mochi.jpg" class="size-12 rounded-lg object-cover shrink-0">
        <div class="flex-1 min-w-0">
          <h4 id="share-preview-author" class="font-bold text-xs truncate">@mochi_toypoodle</h4>
          <p id="share-preview-caption" class="text-[11px] text-[#737373] truncate">Açıklama yükleniyor...</p>
        </div>
      </div>

      <!-- DM Quick Send Section -->
      <div>
        <h4 class="text-xs font-bold text-[#737373] uppercase tracking-wider mb-2">Hızlı Mesaj Gönder</h4>
        <div id="share-contacts-list" class="flex flex-col gap-1.5 max-h-48 overflow-y-auto pr-1">
          <!-- Dynamically populated contacts -->
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-2 border-t border-[#efefef] dark:border-[#262626] flex flex-col gap-2">
        <button onclick="copySharePostLink()" class="w-full py-2.5 bg-gray-100 hover:bg-gray-200 dark:bg-[#262626] dark:hover:bg-[#333] text-xs font-bold rounded-xl transition flex items-center justify-center gap-2">
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Bağlantıyı Kopyala</span>
        </button>
        <button onclick="triggerNativeShare()" class="w-full py-2.5 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-bold rounded-xl transition flex items-center justify-center gap-2">
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          <span>Diğer Uygulamalarda Paylaş</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= PATİ KOMUTA MERKEZİ & POODLE PASAPORT MODAL ================= -->
  <div id="poodle-dashboard-modal" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-2 sm:p-4 backdrop-blur-sm">
    <div class="bg-white dark:bg-[#161616] text-gray-900 dark:text-gray-100 rounded-3xl w-full max-w-3xl overflow-hidden flex flex-col max-h-[92vh] shadow-2xl border border-amber-500/30">
      
      <!-- Modal Header with Multi-Poodle Switcher -->
      <div class="p-4 sm:p-5 border-b border-gray-100 dark:border-[#262626] flex items-center justify-between gap-3 bg-gradient-to-r from-amber-500/10 via-orange-500/5 to-purple-500/10">
        <div class="flex items-center gap-3 min-w-0">
          <div class="size-11 rounded-2xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center text-2xl shadow-inner shrink-0">
            🪪
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h2 class="font-black text-base sm:text-lg tracking-tight truncate">Pati Komuta Merkezi</h2>
              <span class="px-2 py-0.5 bg-amber-500 text-white dark:text-black font-extrabold text-[10px] rounded-full uppercase tracking-wider">Resmi</span>
            </div>
            <p id="dash-modal-header-sub" class="text-xs text-[#737373] dark:text-gray-400 truncate">Mochi · Toy Poodle (Red Apricot) · 2.85 kg</p>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <!-- Multi-Poodle Switcher Pill -->
          <div class="relative">
            <button onclick="toggleDashboardPoodleDropdown()" id="dash-active-poodle-btn" class="flex items-center gap-1.5 px-3 py-1.5 bg-white dark:bg-[#222] border border-[#dbdbdb] dark:border-[#333] hover:border-amber-500 rounded-xl text-xs font-bold shadow-xs transition">
              <img id="dash-modal-poodle-thumb" src="/images/poodle_mochi.jpg" class="size-5 rounded-full object-cover">
              <span id="dash-modal-poodle-name">Mochi</span>
              <svg class="size-3 text-gray-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <!-- Dropdown Menu -->
            <div id="dash-poodle-dropdown" class="hidden absolute right-0 mt-1 w-48 bg-white dark:bg-[#202020] rounded-xl shadow-xl border border-[#dbdbdb] dark:border-[#333] p-1.5 z-50 flex flex-col gap-1">
              <button onclick="switchPoodleFromHub('Mochi', 'Toy Poodle', 'Red Apricot', 2.85, '/images/poodle_mochi.jpg')" class="flex items-center gap-2 p-2 rounded-lg hover:bg-amber-500/10 text-left text-xs font-bold transition">
                <img src="/images/poodle_mochi.jpg" class="size-6 rounded-full object-cover">
                <div class="flex-1 min-w-0">
                  <div class="truncate">Mochi 🐾</div>
                  <div class="text-[10px] text-gray-500">2.85 kg · Aktif</div>
                </div>
              </button>
              <button onclick="switchPoodleFromHub('Luna', 'Toy Poodle', 'Apricot', 2.70, '/images/poodle_luna.jpg')" class="flex items-center gap-2 p-2 rounded-lg hover:bg-amber-500/10 text-left text-xs font-bold transition">
                <img src="/images/poodle_luna.jpg" class="size-6 rounded-full object-cover">
                <div class="flex-1 min-w-0">
                  <div class="truncate">Luna 🧸</div>
                  <div class="text-[10px] text-gray-500">2.70 kg · Beyaz</div>
                </div>
              </button>
              <button onclick="switchPoodleFromHub('Teddy', 'Toy Poodle', 'Chocolate', 3.40, '/images/poodle_teddy.jpg')" class="flex items-center gap-2 p-2 rounded-lg hover:bg-amber-500/10 text-left text-xs font-bold transition">
                <img src="/images/poodle_teddy.jpg" class="size-6 rounded-full object-cover">
                <div class="flex-1 min-w-0">
                  <div class="truncate">Teddy 🐻</div>
                  <div class="text-[10px] text-gray-500">3.40 kg · Chocolate</div>
                </div>
              </button>
              <button onclick="openAuthModal('signup'); closePoodleDashboardModal();" class="mt-1 pt-1 border-t border-gray-100 dark:border-[#333] flex items-center justify-center gap-1 p-1.5 text-[11px] font-bold text-amber-600 dark:text-amber-400 hover:opacity-80">
                <span>➕ Yeni Poodle Ekle</span>
              </button>
            </div>
          </div>

          <!-- Close Modal -->
          <button onclick="closePoodleDashboardModal()" class="p-2 text-gray-400 hover:text-black dark:hover:text-white rounded-xl hover:bg-gray-100 dark:hover:bg-[#252525] transition">
            <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- 4 Navigation Tabs -->
      <div class="flex border-b border-gray-200 dark:border-[#262626] bg-gray-50/70 dark:bg-[#1a1a1a] px-3 sm:px-6 overflow-x-auto no-scrollbar">
        <button id="hub-tab-btn-passport" onclick="switchDashboardModalTab('passport')" class="flex items-center gap-2 py-3 px-3 text-xs sm:text-sm font-bold border-b-2 border-amber-500 text-amber-600 dark:text-amber-400 shrink-0 transition">
          <span>🪪</span>
          <span>Pasaport & QR Künye</span>
        </button>
        <button id="hub-tab-btn-health" onclick="switchDashboardModalTab('health')" class="flex items-center gap-2 py-3 px-3 text-xs sm:text-sm font-bold border-b-2 border-transparent text-gray-500 hover:text-black dark:hover:text-white shrink-0 transition">
          <span>💉</span>
          <span>Sağlık, Aşı & Kilo</span>
        </button>
        <button id="hub-tab-btn-social" onclick="switchDashboardModalTab('social')" class="flex items-center gap-2 py-3 px-3 text-xs sm:text-sm font-bold border-b-2 border-transparent text-gray-500 hover:text-black dark:hover:text-white shrink-0 transition">
          <span>💬</span>
          <span>Sosyal Nabız</span>
          <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
        </button>
        <button id="hub-tab-btn-settings" onclick="switchDashboardModalTab('settings')" class="flex items-center gap-2 py-3 px-3 text-xs sm:text-sm font-bold border-b-2 border-transparent text-gray-500 hover:text-black dark:hover:text-white shrink-0 transition">
          <span>⚙️</span>
          <span>Gizlilik & Ayarlar</span>
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6">

        <!-- ================= SUB-TAB 1: PASAPORT & QR KÜNYE ================= -->
        <div id="hub-content-passport" class="space-y-6">
          
          <!-- Deluxe Digital Poodle Passport Card -->
          <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-neutral-900 via-neutral-950 to-stone-900 text-white p-5 sm:p-7 shadow-2xl border border-amber-500/40">
            <!-- Hologram & Crest Background Watermark -->
            <div class="absolute -right-8 -bottom-8 text-9xl opacity-5 pointer-events-none select-none">🐩</div>
            <div class="absolute top-0 right-0 p-4 opacity-30 text-amber-400 text-xs font-mono tracking-widest uppercase">YOURPOODLE CERTIFIED</div>

            <!-- Card Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-5">
              <div class="flex items-center gap-2">
                <span class="text-2xl">🇹🇷</span>
                <div>
                  <h4 class="font-black text-xs sm:text-sm tracking-wider uppercase text-amber-400">Resmi Dijital Poodle Pasaportu</h4>
                  <p class="text-[10px] text-gray-400 font-mono">T.C. Uyumlu Pet Kimlik Kartı · YP-TR-2026-84920</p>
                </div>
              </div>
              <span class="px-2.5 py-1 bg-amber-500/20 border border-amber-400/40 text-amber-300 font-black text-[10px] rounded-full uppercase tracking-wider">
                Toy Sınıfı ✅
              </span>
            </div>

            <!-- Passport Body Grid -->
            <div class="flex flex-col sm:flex-row gap-5 items-center sm:items-start">
              <!-- Avatar with Passport Gold Ring -->
              <div class="flex flex-col items-center gap-2 shrink-0">
                <div class="size-28 sm:size-32 rounded-2xl p-1 bg-gradient-to-tr from-amber-400 via-yellow-200 to-amber-600 shadow-xl">
                  <img id="hub-passport-avatar" src="/images/poodle_mochi.jpg" alt="Mochi" class="size-full object-cover rounded-xl border border-black/40">
                </div>
                <span class="px-2.5 py-0.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full font-bold text-[10px]">
                  ✓ Çipli & Kayıtlı
                </span>
                <button onclick="openVerificationModal(); closePoodleDashboardModal();" id="hub-passport-verified-badge" class="px-2.5 py-0.5 bg-sky-500/20 text-[#38bdf8] hover:bg-sky-500/30 border border-[#38bdf8]/40 rounded-full font-bold text-[10px] flex items-center gap-1 transition cursor-pointer" title="Mavi Pati Doğrulama Durumu">
                  <span>🐾</span>
                  <span id="hub-passport-verified-text">Mavi Pati: Başvur</span>
                </button>
              </div>

              <!-- Info Details Grid -->
              <div class="flex-1 grid grid-cols-2 gap-x-4 gap-y-3 text-xs w-full">
                <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
                  <span class="text-[10px] uppercase font-bold text-gray-400 block">Poodle Adı</span>
                  <strong id="hub-passport-name" class="text-sm font-black text-white">Mochi 🐾</strong>
                </div>
                <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
                  <span class="text-[10px] uppercase font-bold text-gray-400 block">Irk / Varyasyon</span>
                  <strong id="hub-passport-variety" class="text-xs font-bold text-amber-300">Toy Poodle</strong>
                </div>
                <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
                  <span class="text-[10px] uppercase font-bold text-gray-400 block">Kürk Rengi</span>
                  <strong id="hub-passport-color" class="text-xs font-bold text-white">Red Apricot</strong>
                </div>
                <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
                  <span class="text-[10px] uppercase font-bold text-gray-400 block">Doğum Tarihi / Yaş</span>
                  <strong id="hub-passport-age" class="text-xs font-bold text-white">15.07.2025 (1 yıl 3 ay)</strong>
                </div>
                <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
                  <span class="text-[10px] uppercase font-bold text-gray-400 block">Güncel Ağırlık</span>
                  <strong id="hub-passport-weight" class="text-xs font-bold text-emerald-400">2.85 kg (İdeal)</strong>
                </div>
                <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
                  <span class="text-[10px] uppercase font-bold text-gray-400 block">Kayıtlı Sahip</span>
                  <strong id="hub-passport-owner" class="text-xs font-bold text-white">Emre & Zeynep</strong>
                </div>
              </div>
            </div>

            <!-- Microchip Copy Strip -->
            <div class="mt-5 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 bg-black/30 -mx-5 -mb-5 sm:-mx-7 sm:-mb-7 p-4">
              <div class="flex items-center gap-2 text-xs">
                <span class="text-amber-400 font-bold">📡 Mikroçip No:</span>
                <code id="hub-passport-chip" class="font-mono text-xs bg-white/10 px-2 py-0.5 rounded text-amber-200 font-bold tracking-wider">TR-982009104829104</code>
              </div>
              <button onclick="copyMicrochipNumber()" class="px-3 py-1 bg-white/10 hover:bg-white/20 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 active:scale-95">
                <span>📋</span>
                <span>Çip Numarasını Kopyala</span>
              </button>
            </div>
          </div>

          <!-- Smart QR Collar Tag Section -->
          <div class="bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-yellow-500/10 dark:bg-[#1a1a1a] rounded-3xl p-5 sm:p-6 border border-amber-500/30 flex flex-col md:flex-row items-center gap-6">
            <!-- QR Code Container -->
            <div class="size-44 bg-white p-2.5 rounded-2xl shadow-xl flex flex-col items-center justify-center shrink-0 border-2 border-amber-500/40">
              <img id="hub-qr-img" src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=https%3A%2F%2Fwww.yourpoodle.com%2Fp%2Fsenin_poodlein" alt="Poodle QR Tag" class="size-36 object-contain">
              <span class="text-[9px] font-black tracking-widest text-gray-500 uppercase mt-1">YOURPOODLE SMART TAG</span>
            </div>

            <!-- Tag Actions & Info -->
            <div class="flex-1 space-y-3 text-center md:text-left">
              <div class="flex items-center justify-center md:justify-start gap-2">
                <span class="text-xl">🏷️</span>
                <h4 class="font-black text-sm sm:text-base">Akıllı Tasma Künyesi & QR Kod</h4>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">
                Köpeğinizin tasmasına takılacak resmi akıllı QR künyedir. Kaybolması durumunda telefonu olan herkes bu kodu kamera ile okutarak anında sizinle iletişime geçebilir.
              </p>

              <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5 pt-1">
                <button onclick="printQrTag()" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center gap-1.5 active:scale-95">
                  <span>🖨️</span>
                  <span>Tasma Künyesini Yazdır / İndir (PNG)</span>
                </button>
                <button onclick="openLostTagPreview()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-[#252525] dark:hover:bg-[#303030] text-xs font-bold rounded-xl transition flex items-center gap-1.5 border border-gray-200 dark:border-[#3a3a3a] active:scale-95">
                  <span>👁️</span>
                  <span>Tarayanın Ekranını Önizle</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Emergency Lost Dog Mode Switch -->
          <div class="bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 rounded-3xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="text-3xl animate-pulse">🚨</span>
              <div>
                <h4 class="font-black text-sm text-rose-700 dark:text-rose-400">Acil Kayıp Modu (Lost Dog Mode)</h4>
                <p class="text-xs text-rose-600/80 dark:text-rose-300/80">Aktif edildiğinde QR künyeyi okutan kişiye acil iletişim butonu, 5.000 TL ödül bilgisi ve GPS haritası gösterilir.</p>
              </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
              <input type="checkbox" id="hub-lost-mode-toggle" onchange="toggleLostDogMode(this.checked)" class="sr-only peer">
              <div class="w-12 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>

