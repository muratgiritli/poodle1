        <span>🔗</span>
        <span>Bağlantıyı Kopyala</span>
      </button>

      <!-- Cancel -->
      <button onclick="closePostOptionsModal()" class="w-full py-3 px-4 text-gray-500 hover:bg-gray-100 dark:hover:bg-[#282828] font-normal transition cursor-pointer">
        Vazgeç
      </button>
    </div>
  </div>

  <!-- ================= REPORT MODAL ================= -->
  <div id="report-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#efefef] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🛡️</span>
          <h3 class="font-bold text-sm">İçerik Şikayeti</h3>
        </div>
        <button onclick="closeReportModal()" class="text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <p class="text-xs text-gray-600 dark:text-gray-400">Bu içeriğin topluluk kurallarını ihlal ettiğini düşünüyorsanız lütfen sebebi seçin:</p>
      
      <div class="space-y-2 text-xs">
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Spam / İstenmeyen Reklam" checked class="text-[#0095f6]">
          <span>Spam veya İstenmeyen Reklam</span>
        </label>
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Yanıltıcı veya Zararlı Bilgi" class="text-[#0095f6]">
          <span>Yanıltıcı veya Köpek Sağlığına Zararlı Bilgi</span>
        </label>
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Uygunsuz Görsel veya Hakaret" class="text-[#0095f6]">
          <span>Uygunsuz Görsel, Taciz veya Hakaret</span>
        </label>
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Telif Hakkı / İzinsiz Fotoğraf" class="text-[#0095f6]">
          <span>Telif Hakkı / İzinsiz Poodle Fotoğrafı</span>
        </label>
      </div>

      <button onclick="submitContentReport()" class="w-full py-2.5 bg-[#ed4956] hover:bg-red-600 text-white font-bold text-xs rounded-xl transition shadow-xs cursor-pointer">
        Moderasyon Ekibine İlet 🛡️
      </button>
    </div>
  </div>

  <!-- ================= EDIT POST MODAL ================= -->
  <div id="edit-post-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#efefef] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">✏️</span>
          <h3 class="font-bold text-sm">Gönderi Açıklamasını Düzenle</h3>
        </div>
        <button onclick="closeEditPostModal()" class="text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <textarea id="edit-post-caption-input" rows="4" class="w-full p-3 bg-gray-50 dark:bg-[#222] border border-gray-200 dark:border-[#333] rounded-xl text-xs outline-none focus:border-[#0095f6]"></textarea>

      <button onclick="saveEditedPost()" class="w-full py-2.5 bg-[#0095f6] hover:bg-[#1877f2] text-white font-bold text-xs rounded-xl transition shadow-xs cursor-pointer">
        Değişiklikleri Kaydet
      </button>
    </div>
  </div>

  <!-- ================= NOTIFICATION PREFERENCES MODAL ================= -->
  <div id="notif-preferences-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#efefef] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">⚙️</span>
          <h3 class="font-bold text-sm">Bildirim Tercihleri</h3>
        </div>
        <button onclick="closeNotifPreferencesModal()" class="text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <p class="text-xs text-gray-500">Hangi durumlarda anında bildirim almak istediğinizi belirleyin:</p>

      <div class="space-y-3 text-xs">
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">❤️ Beğeniler</span>
          <input type="checkbox" id="pref-likes" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">💬 Yorumlar & Yanıtlar</span>
          <input type="checkbox" id="pref-comments" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">👤 Yeni Takipçiler</span>
          <input type="checkbox" id="pref-follows" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">✉️ Özel Mesajlar (DM)</span>
          <input type="checkbox" id="pref-messages" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">🐾 Topluluk & Forum Yanıtları</span>
          <input type="checkbox" id="pref-forum" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
      </div>

      <button onclick="saveNotificationPreferences()" class="w-full py-2.5 bg-[#0095f6] hover:bg-[#1877f2] text-white font-bold text-xs rounded-xl transition shadow-xs cursor-pointer">
        Tercihleri Kaydet
      </button>
    </div>
  </div>
</body>
</html>
