                  <input type="number" step="0.05" min="1.0" max="15.0" id="new-weight-input" placeholder="2.85" class="w-full px-3 py-1.5 bg-gray-100 dark:bg-[#202020] rounded-xl text-xs font-bold outline-none border border-transparent focus:border-amber-500">
