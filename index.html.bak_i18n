  <!-- ================= LOST TAG FINDER PREVIEW MODAL ================= -->
  <div id="lost-tag-preview-modal" class="fixed inset-0 bg-black/85 z-50 hidden flex items-center justify-center p-3 backdrop-blur-md">
    <div class="bg-white dark:bg-[#1a1a1a] rounded-3xl w-full max-w-sm overflow-hidden flex flex-col shadow-2xl border-2 border-rose-500 text-center animate-scale-up">
      <div class="bg-rose-600 text-white p-4">
        <span class="text-3xl animate-bounce inline-block">🚨</span>
        <h3 class="font-black text-sm uppercase tracking-wide">Kayıp Köpek Künyesi</h3>
        <p class="text-[11px] opacity-90">Bu ekran tasmadaki QR kodu okutan kişiye görünür</p>
      </div>

      <div class="p-5 space-y-4">
        <div class="size-28 mx-auto rounded-2xl overflow-hidden border-2 border-rose-500 shadow-md">
          <img id="lost-preview-avatar" src="/images/poodle_mochi.jpg" class="size-full object-cover">
        </div>

        <div>
          <h4 id="lost-preview-name" class="font-black text-lg">Mochi 🐾</h4>
          <p id="lost-preview-info" class="text-xs text-gray-500 font-bold">Toy Poodle · Red Apricot · 2.85 kg</p>
          <p class="text-xs text-gray-700 dark:text-gray-300 mt-2 bg-rose-500/10 p-2.5 rounded-xl border border-rose-500/20">
            "Merhaba! Ben Mochi. Ailemden uzaklaştım ve kayboldum. Lütfen aileme haber ver, beni çok merak ediyorlar!"
          </p>
        </div>

        <div class="p-3 bg-amber-500/15 border border-amber-500/30 rounded-xl">
