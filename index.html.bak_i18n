        <!-- ================= VIEW A: APPLICATION FORM ================= -->
        <div id="view-verify-apply" class="space-y-5">
          <!-- Benefits Banner -->
          <div class="rounded-2xl p-4 bg-gradient-to-r from-sky-500/10 via-blue-500/5 to-indigo-500/10 border border-[#0095f6]/20 space-y-2.5">
            <h4 class="text-xs font-black uppercase text-[#0095f6] tracking-wider flex items-center gap-1.5">
              <span>🌟</span>
              <span>Mavi Pati Rozetinin Ayrıcalıkları</span>
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">💎</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">Resmi Güvenilirlik</strong>
                  <span class="text-[11px] text-gray-500">Adının yanında orijinal tescil rozeti</span>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">🚀</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">Keşfet & Akış Önceliği</strong>
                  <span class="text-[11px] text-gray-500">Gönderiler vitrinde öne çıkar</span>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">🛡️</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">Klon Hesap Koruması</strong>
                  <span class="text-[11px] text-gray-500">Taklitçilere karşı tam koruma</span>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">🎁</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">+100 Pati Puanı Bonusu</strong>
                  <span class="text-[11px] text-gray-500">Anında cüzdanına tanımlanır</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Application Form -->
          <form onsubmit="handleVerificationSubmit(event)" class="space-y-4">
            
            <!-- User & Poodle Quick Summary Box -->
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200/80 dark:border-[#2a2a2a]">
              <img id="verify-avatar-preview" src="/images/poodle_mochi.jpg" class="size-12 rounded-full object-cover border-2 border-[#0095f6] shrink-0">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <span id="verify-poodle-display-name" class="font-bold text-sm">Mochi</span>
                  <span class="text-xs text-gray-500" id="verify-username-handle">@senin_poodlein</span>
                </div>
                <div class="flex items-center gap-2 text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
                  <span id="verify-poodle-variety-chip">Toy Poodle</span>
                  <span>·</span>
                  <span id="verify-poodle-color-chip">Red Apricot</span>
                </div>
              </div>
              <span class="px-2.5 py-1 bg-sky-500/10 text-[#0095f6] border border-[#0095f6]/20 font-bold text-[10px] rounded-lg shrink-0">
                Aday Hesap
              </span>
            </div>

            <!-- Verification Category -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                1. Başvuru Kategorisi <span class="text-rose-500">*</span>
              </label>
              <select id="verify-category" required class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6] text-gray-800 dark:text-gray-200">
                <option value="Popüler Poodle & İçerik Üreticisi">🐩 Popüler Poodle & Sosyal İçerik Üreticisi</option>
                <option value="Şampiyon & Yarışma Dereceli (Show Dog)">🏆 Şampiyon & Yarışma Dereceli (Show Dog)</option>
                <option value="FCI / KIF / AKC Soy Kütüğü (Pedigree)">📜 FCI / KIF / AKC Soy Kütüğü (Pedigree)</option>
                <option value="Resmi Terapi & Hizmet Köpeği">🩺 Resmi Terapi & Hizmet Köpeği</option>
                <option value="Doğrulanmış Aktif Topluluk Üyesi">🐾 Doğrulanmış Aktif Topluluk Üyesi</option>
              </select>
            </div>

            <!-- Microchip & Registration Info -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                  2. Mikroçip veya Karne No <span class="text-rose-500">*</span>
                </label>
                <input id="verify-chip-input" type="text" required value="TR-982009104829104" placeholder="Örn: TR-982009104829104" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs font-mono font-bold focus:outline-none focus:border-[#0095f6]">
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                  3. Kayıtlı Veteriner Kliniği
                </label>
                <input id="verify-vet-input" type="text" placeholder="Örn: Bebek Veteriner Kliniği" value="Bebek Veteriner Polikliniği" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs focus:outline-none focus:border-[#0095f6]">
              </div>
            </div>

            <!-- Document Upload Field -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                4. Doğrulama Belgesi Yükle (Aşı Karnesi, Çip Belgesi veya Soy Kütüğü) <span class="text-rose-500">*</span>
              </label>
              
              <div onclick="document.getElementById('verify-file-input').click()" class="border-2 border-dashed border-[#0095f6]/40 hover:border-[#0095f6] rounded-2xl p-4 text-center cursor-pointer bg-sky-50/50 dark:bg-sky-950/20 transition group">
                <input type="file" id="verify-file-input" accept="image/*,.pdf" class="hidden" onchange="handleVerifyFileSelect(event)">
                
                <div id="verify-upload-empty" class="flex flex-col items-center justify-center gap-2">
                  <div class="size-10 rounded-full bg-sky-500/20 text-[#0095f6] flex items-center justify-center text-xl group-hover:scale-110 transition">
                    📸
                  </div>
                  <div>
                    <span class="text-xs font-bold text-gray-800 dark:text-gray-200 block">Belge fotoğrafını seç veya buraya tıkla</span>
                    <span class="text-[11px] text-gray-500">Veteriner aşı karnesi ilk sayfası veya çip barkodu (JPG, PNG)</span>
                  </div>
                </div>

                <div id="verify-upload-selected" class="hidden flex items-center justify-center gap-3">
                  <span class="text-2xl">📑</span>
                  <div class="text-left">
                    <span id="verify-filename" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 block truncate max-w-xs">asi_karnesi_mochi.jpg</span>
                    <span class="text-[10px] text-gray-500">Belge hazır · Değiştirmek için tıkla</span>
                  </div>
                  <span class="px-2 py-0.5 bg-emerald-500/20 text-emerald-500 text-[10px] font-bold rounded-full">✓ Yüklendi</span>
                </div>
              </div>
            </div>

            <!-- Statement / Note -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                5. Başvuru Notu & Gerekçe
              </label>
              <textarea id="verify-note-input" rows="2" placeholder="Poodle'ınız hakkında belirtmek istediğiniz ek detaylar..." class="w-full px-3.5 py-2 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs focus:outline-none focus:border-[#0095f6]">YourPoodle topluluğunda doğrulanmış aktif bir Toy Poodle profili olarak yer almak istiyorum.</textarea>
            </div>

            <!-- Declaration Checkbox -->
            <div class="flex items-start gap-2.5 p-3 rounded-xl bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200/70 dark:border-[#2a2a2a]">
              <input type="checkbox" id="verify-agree-checkbox" required checked class="mt-0.5 rounded text-[#0095f6] focus:ring-[#0095f6] size-4">
              <label for="verify-agree-checkbox" class="text-[11px] text-gray-600 dark:text-gray-400 cursor-pointer select-none leading-relaxed">
                Beyan ettiğim kimlik, aşı ve mikroçip belgelerinin gerçeği yansıttığını, YourPoodle Topluluk Kuralları'na ve hayvan refahı ilkelerine sadık kalacağımı taahhüt ederim.
              </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="btn-submit-verification" class="w-full py-3 bg-gradient-to-r from-sky-500 via-blue-600 to-indigo-600 hover:from-sky-600 hover:to-indigo-700 text-white font-extrabold text-sm rounded-xl shadow-lg transition transform active:scale-98 flex items-center justify-center gap-2">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
              </svg>
              <span>Mavi Pati Başvurusunu Tamamla ve Rozeti Al</span>
            </button>
          </form>

          <!-- Animated Review Verification Modal Simulation -->
          <div id="verify-review-progress" class="hidden rounded-2xl p-5 bg-gradient-to-r from-sky-500/10 via-blue-500/10 to-indigo-500/10 border border-[#0095f6]/30 text-center space-y-3">
            <div class="size-14 rounded-full bg-gradient-to-tr from-[#0095f6] to-sky-400 mx-auto flex items-center justify-center animate-bounce shadow-md">
              <span class="text-2xl text-white">🐾</span>
            </div>
            <div class="space-y-1">
              <h4 id="verify-progress-title" class="font-bold text-sm text-gray-900 dark:text-gray-100">Belgeler Doğrulanıyor...</h4>
              <p id="verify-progress-desc" class="text-xs text-gray-500">Veteriner çip ve ırk tescil kaydı taranıyor</p>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 h-2 rounded-full overflow-hidden">
              <div id="verify-progress-bar" class="h-full bg-gradient-to-r from-sky-400 to-[#0095f6] transition-all duration-500 w-1/4"></div>
            </div>
          </div>
        </div>

                  <!-- ================= VIEW C: PENDING REVIEW ================= -->
          <div id="view-verify-pending" class="hidden space-y-5">
            <div class="rounded-2xl p-6 bg-gradient-to-r from-amber-500/10 via-sky-500/10 to-indigo-500/10 border border-amber-500/30 text-center space-y-4">
              <div class="size-16 rounded-full bg-amber-500 text-white mx-auto flex items-center justify-center text-3xl shadow-lg animate-pulse">⏳</div>
              <div>
                <h4 class="font-extrabold text-base text-gray-900 dark:text-gray-100">Mavi Pati Başvurunuz İncelemede</h4>
                <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">Başvurunuz ve yüklediğiniz veteriner belgeleri yönetici onay havuzuna iletildi. Uzman ekibimiz belgeleri onayladığında Mavi Pati rozetiniz otomatik olarak profilinize tanımlanacaktır.</p>
              </div>

              <div class="p-3 bg-white dark:bg-[#202020] rounded-xl text-xs space-y-2 border border-gray-200 dark:border-[#333] text-left">
                <div class="flex justify-between items-center pb-1.5 border-b border-gray-100 dark:border-[#2a2a2a]">
                  <span class="text-gray-500">Durum:</span>
                  <span class="font-bold text-amber-500 flex items-center gap-1">⏳ Beklemede (Yönetici Onayı Bekleniyor)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Poodle:</span>
                  <span id="pending-poodle-name" class="font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Mikroçip No:</span>
                  <span id="pending-chip-no" class="font-mono font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Kategori:</span>
                  <span id="pending-category" class="font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Başvuru Tarihi:</span>
                  <span id="pending-date" class="font-bold text-gray-400">Bugün</span>
                </div>
              </div>

              <div class="p-3 bg-sky-500/10 rounded-xl text-[11px] text-sky-700 dark:text-sky-300">
                💡 İncelemeler genellikle 24 saat içerisinde sonuçlandırılır. Belgeniz onaylandığında bildirim alacaksınız.
              </div>
            </div>
          </div>

          <!-- ================= VIEW B: ACTIVE VERIFIED CERTIFICATE ================= -->
