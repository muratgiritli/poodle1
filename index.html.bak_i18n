        <span>🚫</span>
        <span>İlgilenmiyorum (Bu Gönderiyi Gizle)</span>
      </button>

      <!-- Report Button -->
      <button onclick="handleReportPostAction()" class="w-full py-3.5 px-4 text-[#ed4956] hover:bg-red-500/10 font-bold transition flex items-center justify-center gap-2 cursor-pointer">
        <span>🚩</span>
        <span>Gönderiyi Şikayet Et</span>
      </button>

      <!-- Author Only: Edit -->
