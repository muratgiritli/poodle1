  <!-- ================= MAVİ PATİ DOĞRULAMA (VERIFIED BLUE PAW) MODAL ================= -->
  <div id="verified-badge-modal" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-2 sm:p-4 backdrop-blur-sm">
    <div class="bg-white dark:bg-[#161616] text-gray-900 dark:text-gray-100 rounded-3xl w-full max-w-xl overflow-hidden flex flex-col max-h-[92vh] shadow-2xl border border-sky-500/40">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-gray-100 dark:border-[#262626] flex items-center justify-between gap-3 bg-gradient-to-r from-sky-500/15 via-blue-500/10 to-indigo-500/15">
        <div class="flex items-center gap-3 min-w-0">
          <div class="size-11 rounded-2xl bg-gradient-to-tr from-[#0095f6] to-sky-400 text-white flex items-center justify-center shadow-md shrink-0">
            <svg class="size-6 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
