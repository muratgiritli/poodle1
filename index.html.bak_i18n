<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>YourPoodle • Akıllı Poodle Topluluğu & Sosyal Ağ</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#000000">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="YourPoodle">
  <link rel="apple-touch-icon" href="/images/poodle_mochi.jpg">
  <!-- Google Fonts: Inter and Grand Hotel for Instagram Script Logo -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Grand+Hotel&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Identity Services SDK -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <!-- HLS.js for Adaptive Bitrate Video Streaming -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.8/dist/hls.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
            logo: ['"Grand Hotel"', 'cursive', 'sans-serif'],
          },
          colors: {
            ig: {
              red: '#ed4956',
              blue: '#0095f6',
              blueHover: '#1877f2',
              border: '#dbdbdb',
              borderDark: '#262626',
              bgLight: '#fafafa',
              cardLight: '#ffffff',
              textLight: '#262626',
              textMuted: '#737373',
              darkBg: '#000000',
              darkCard: '#121212',
              darkBorder: '#262626',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Global Button Hover & Click/Touch Feedback */
    button, [role="button"], .cursor-pointer {
      cursor: pointer !important;
      -webkit-tap-highlight-color: rgba(245, 158, 11, 0.25);
    }
    button:active, [role="button"]:active {
      transform: scale(0.96) !important;
      transition: transform 0.08s ease-in-out !important;
    }

    /* Instagram Gradient Ring */
    .ig-gradient-ring {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }
    .ig-gradient-text {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .ig-gradient-bg {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }

    /* Golden Paw Points Glow */
    .paw-gold-glow {
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.35);
    }

    /* Hide scrollbars */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Double Tap Heart Animation */
    @keyframes heartPop {
      0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
      50% { transform: translate(-50%, -50%) scale(1.25); opacity: 0.95; }
      70% { transform: translate(-50%, -50%) scale(0.95); opacity: 0.95; }
      100% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
    }
    .animate-heart-pop {
      animation: heartPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    /* Floating Paw Point Badge Pop */
    @keyframes pawPop {
      0% { transform: translateY(0) scale(0.8); opacity: 0; }
      30% { transform: translateY(-12px) scale(1.15); opacity: 1; }
      75% { transform: translateY(-24px) scale(1); opacity: 1; }
      100% { transform: translateY(-40px) scale(0.9); opacity: 0; }
    }
    .animate-paw-pop {
      animation: pawPop 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    /* Spinning vinyl record in Reels */
    @keyframes spinDisc {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
      animation: spinDisc 4s linear infinite;
    }

    ::selection {
      background: #e1306c;
      color: #ffffff;
    }
  </style>
</head>
<body class="bg-[#fafafa] dark:bg-black text-[#262626] dark:text-[#f5f5f5] antialiased min-h-screen transition-colors duration-200">

  <!-- APP CONTAINER -->
  <div id="app" class="flex flex-col md:flex-row min-h-screen max-w-[1920px] mx-auto relative">

    <!-- DESKTOP LEFT SIDEBAR (Instagram Web Style) -->
    <aside class="hidden md:flex flex-col fixed top-0 left-0 h-screen w-[72px] xl:w-[244px] border-r border-[#dbdbdb] dark:border-[#262626] bg-white dark:bg-black z-40 px-3 py-6 justify-between transition-all duration-200">
      <div class="flex flex-col gap-6">
        <!-- Logo -->
        <a href="#" onclick="switchTab('home')" class="flex items-center px-3 py-2 cursor-pointer">
          <span class="hidden xl:inline font-logo text-3xl font-bold tracking-wide">YourPoodle</span>
          <span class="inline xl:hidden text-2xl font-bold">🐩</span>
        </a>

        <!-- Nav Items -->
        <nav class="flex flex-col gap-1">
          <!-- Home -->
          <button onclick="switchTab('home')" id="nav-btn-home" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all font-semibold">
            <svg class="w-6 h-6 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.1l9.9 8.9-1.4 1.5L19 11.2V20c0 1.1-.9 2-2 2h-4v-6h-2v6H7c-1.1 0-2-.9-2-2v-8.8l-1.5 1.3-1.4-1.5L12 2.1z"/></svg>
            <span class="hidden xl:inline text-sm">Ana Sayfa</span>
          </button>

          <!-- Search -->
          <button onclick="openSearchModal()" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span class="hidden xl:inline text-sm">Ara</span>
          </button>

          <!-- Explore -->
          <button onclick="switchTab('explore')" id="nav-btn-explore" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9 12 2"/></svg>
            <span class="hidden xl:inline text-sm">Keşfet</span>
          </button>

          <!-- Reels -->
          <!-- Community & Forum -->
          <button onclick="switchTab('community')" id="nav-btn-community" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
            <span class="text-xl shrink-0">🐩</span>
            <span class="hidden xl:inline text-sm">Topluluk</span>
          </button>

          <button onclick="switchTab('reels')" id="nav-btn-reels" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="m10 9 5 3-5 3V9z"/><line x1="2" y1="7" x2="22" y2="7"/></svg>
            <span class="hidden xl:inline text-sm">Reels</span>
          </button>

          <!-- Messages / DM -->
          <button onclick="switchTab('messages')" id="nav-btn-messages" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all relative">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span class="hidden xl:inline text-sm">Mesajlar</span>
            <span id="desktop-dm-badge" class="hidden absolute top-2 left-6 xl:left-auto xl:right-3 bg-[#ed4956] text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full"></span>
          </button>

          <!-- Notifications -->
          <button onclick="openNotificationsModal()" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all relative">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span class="hidden xl:inline text-sm">Bildirimler</span>
            <span class="absolute top-2.5 left-6 xl:left-auto xl:right-3 size-2 bg-[#ed4956] rounded-full"></span>
          </button>

          <!-- Create Post (+) -->
          <button onclick="openCreateModal()" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <span class="hidden xl:inline text-sm">Oluştur</span>
          </button>

          <!-- Pati Puanı Cüzdanım (Sidebar Nav) -->
          <button onclick="openPawPointsModal()" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-amber-500/10 transition-all group">
            <span class="text-xl group-hover:scale-125 transition shrink-0">🐾</span>
            <span class="hidden xl:flex items-center gap-1.5 text-sm font-bold text-amber-600 dark:text-amber-400">
              Pati Puanı: <strong id="sidebar-paw-points">125</strong>
            </span>
          </button>

          <!-- Pati Paneli & Pasaport (Sidebar Nav) -->
          <button onclick="openPoodleDashboardModal()" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-purple-500/10 transition-all group">
            <span class="text-xl group-hover:scale-125 transition shrink-0">🪪</span>
            <span class="hidden xl:inline text-sm font-bold text-purple-600 dark:text-purple-400">Pati Paneli & Pasaport</span>
          </button>

          <!-- Profile / Login button -->
          <button onclick="handleProfileNavClick()" id="nav-btn-profile" class="nav-item flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
            <div id="sidebar-avatar-container" class="size-6 rounded-full overflow-hidden shrink-0 border border-[#dbdbdb] dark:border-[#262626]">
              <img id="sidebar-avatar-img" src="/images/poodle_mochi.jpg" alt="Profile" class="size-full object-cover">
            </div>
            <span id="sidebar-profile-text" class="hidden xl:inline text-sm">Profil</span>
          </button>
        </nav>
      </div>

      <!-- Bottom Settings & Auth Status -->
      <div class="flex flex-col gap-2">
        <!-- Auth Login/Logout Indicator with Paw Points badge -->
        <div id="auth-sidebar-box" class="hidden xl:flex flex-col gap-2 p-3 bg-gray-50 dark:bg-[#141414] border border-[#dbdbdb] dark:border-[#262626] rounded-xl text-xs">
          <div class="flex items-center justify-between">
            <span id="auth-user-status" class="font-bold truncate">Misafir Kullanıcı</span>
            <span onclick="openPawPointsModal()" class="cursor-pointer px-2 py-0.5 bg-amber-500/20 text-amber-600 dark:text-amber-400 font-extrabold text-[10px] rounded-full flex items-center gap-1">
              <span>🐾</span>
              <span id="sidebar-box-paw-points">125</span>
            </span>
          </div>
          <button id="auth-sidebar-btn" onclick="openAuthModal('login')" class="w-full py-1.5 bg-[#0095f6] hover:bg-[#1877f2] text-white font-bold rounded-lg transition text-center">Giriş Yap / Kaydol</button>
        </div>



        <button onclick="toggleDarkMode()" class="flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-[#f2f2f2] dark:hover:bg-[#1a1a1a] transition-all">
          <svg class="w-6 h-6 shrink-0 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="w-6 h-6 shrink-0 hidden dark:inline text-yellow-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <span class="hidden xl:inline text-sm">Görünüm Değiştir</span>
        </button>
      </div>
    </aside>

    <!-- MOBILE TOP BAR -->
    <header class="md:hidden sticky top-0 z-40 bg-white/95 dark:bg-black/95 backdrop-blur-md border-b border-[#dbdbdb] dark:border-[#262626] px-4 h-14 flex items-center justify-between">
      <a href="#" onclick="switchTab('home')" class="font-logo text-2xl font-bold tracking-wide">YourPoodle</a>
      <div class="flex items-center gap-2">
        <!-- Poodle Hub / Passport Quick Pill (Only shown after login) -->
        <button id="mobile-passport-pill" onclick="openPoodleDashboardModal()" class="hidden p-1 hover:scale-110 active:scale-95 transition" title="Pati Paneli & Pasaport 🪪">
          <span class="text-xl">🪪</span>
        </button>
        <!-- Paw Points Pill on Mobile (Only shown after login) -->
        <button id="mobile-paw-points-pill" onclick="openPawPointsModal()" class="hidden flex items-center gap-1 px-2.5 py-1 bg-amber-500/15 border border-amber-500/30 rounded-full text-amber-600 dark:text-amber-400 font-extrabold text-xs">
          <span>🐾</span>
          <span id="mobile-paw-points">125</span>
        </button>
        <!-- Login button on mobile if logged out -->
        <button id="mobile-login-pill" onclick="openAuthModal('login')" class="px-3 py-1 bg-[#0095f6] text-white text-xs font-bold rounded-full">Giriş</button>
        <!-- Notification Heart -->
        <button onclick="openNotificationsModal()" class="relative p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="absolute top-1 right-1 size-2 bg-[#ed4956] rounded-full"></span>
        </button>
        <!-- DM Paperplane -->
        <button onclick="switchTab('messages')" class="relative p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          <span id="mobile-dm-badge" class="hidden absolute -top-0.5 -right-1 bg-[#ed4956] text-white text-[10px] font-bold px-1 rounded-full"></span>
        </button>
      </div>
    </header>

    <!-- MAIN CONTENT VIEW AREA -->
    <main class="flex-1 md:ml-[72px] xl:ml-[244px] pb-16 md:pb-8 flex justify-center min-h-screen">

      <!-- ================= TAB 1: HOME FEED ================= -->
      <div id="tab-home" class="w-full max-w-[975px] pt-4 md:pt-6 px-2 sm:px-4 flex justify-center gap-8">
        
        <!-- Left: Stories & Feed (max 470px) -->
        <div class="w-full max-w-[470px] flex flex-col gap-4">

          <!-- Welcome Banner / Call to Action for Poodle owners -->
          <div id="guest-welcome-card" class="bg-gradient-to-r from-amber-500/10 via-pink-500/10 to-purple-500/10 border border-[#dbdbdb] dark:border-[#333] rounded-xl p-4 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="text-3xl">🐾</span>
              <div>
                <h4 class="font-bold text-xs">Poodle'ın için hesap aç, +100 Pati Puanı kazan!</h4>
                <p class="text-[11px] text-[#737373]">Fotoğraflarını paylaş, puan topla, vitrinde öne çık ✨</p>
              </div>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button onclick="openPoodleDashboardModal()" class="px-2.5 py-1.5 bg-purple-500/10 hover:bg-purple-500/20 text-purple-600 dark:text-purple-400 font-bold text-xs rounded-lg transition" title="Pati Panelini İncele">🪪 İncele</button>
              <button onclick="openAuthModal('signup')" class="px-3.5 py-1.5 bg-[#0095f6] hover:bg-[#1877f2] text-white font-bold text-xs rounded-lg shadow-sm">Hemen Katıl</button>
            </div>
          </div>

          <!-- USER DASHBOARD / PATİ KOMUTA MERKEZİ (FEED WIDGET) -->
          <div id="user-dashboard-card" class="hidden bg-white dark:bg-[#141414] border border-amber-500/25 dark:border-amber-500/25 rounded-2xl p-4 shadow-sm space-y-3.5 transition-all">
            <!-- 1. Karşılama, Günlük Seri (Streak) Header -->
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3 min-w-0">
                <div class="relative size-12 shrink-0 cursor-pointer" onclick="openPoodleDashboardModal('passport')" title="Pasaportu Gör">
                  <img id="dash-avatar" src="/images/poodle_mochi.jpg" alt="Mochi" class="size-full object-cover rounded-full border-2 border-amber-500 p-0.5">
                  <span id="dash-live-dot" class="absolute bottom-0 right-0 size-3 bg-emerald-500 border-2 border-white dark:border-black rounded-full" title="Çevrim İçi"></span>
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <h3 id="dash-greeting" class="font-black text-sm tracking-tight truncate">Günaydın, Emre!</h3>
                    <span id="dash-verified-badge" onclick="openVerificationModal()" class="hidden items-center cursor-pointer transition hover:scale-110" title="Doğrulanmış Poodle Hesabı (Mavi Pati) 🐾">
                      <svg class="size-3.5 text-[#0095f6]" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                        <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                        <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                        <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                        <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                        <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
                      </svg>
                    </span>
                    <span id="dash-greeting-icon" class="text-xs">☀️</span>
                  </div>
                  <p id="dash-subtext" class="text-xs text-[#737373] dark:text-gray-400 truncate">Mochi bugün 1 yıl 3 aylık ve harika görünüyor 🐾</p>
                </div>
              </div>

              <!-- Streak Flame Badge -->
              <div onclick="claimDailyStreak()" id="dash-streak-badge" class="flex items-center gap-2 bg-gradient-to-r from-amber-500/10 via-orange-500/15 to-rose-500/10 hover:from-amber-500/20 hover:to-orange-500/20 border border-amber-500/30 px-3 py-1.5 rounded-xl cursor-pointer hover:scale-105 active:scale-95 transition shrink-0 select-none" title="Günlük Giriş Bonusu Al">
                <span class="text-xl animate-bounce">🔥</span>
                <div class="flex flex-col text-right">
                  <span id="dash-streak-days" class="text-xs font-black text-amber-600 dark:text-amber-400">5 Günlük Seri</span>
                  <span id="dash-streak-action" class="text-[9px] font-bold text-orange-500">+10 Pati Bonusu Al</span>
                </div>
              </div>
            </div>

            <!-- Hızlı Butonlar (📸 Paylaş, 🎬 Reels, 🐾 Hikaye, 🎨 3D Avatar, 📍 Parktayım) -->
            <div class="grid grid-cols-5 gap-1.5 pt-1">
              <button onclick="openCreateModal()" class="flex flex-col items-center justify-center p-2 rounded-xl bg-gray-50 dark:bg-[#1c1c1c] hover:bg-gray-100 dark:hover:bg-[#252525] border border-gray-200/70 dark:border-[#2a2a2a] transition group active:scale-95">
                <span class="text-base group-hover:scale-110 transition">📸</span>
                <span class="text-[9px] font-bold text-gray-700 dark:text-gray-300 mt-0.5">Paylaş</span>
              </button>
              <button onclick="switchTab('reels')" class="flex flex-col items-center justify-center p-2 rounded-xl bg-gradient-to-tr from-pink-500/10 to-red-500/10 hover:from-pink-500/20 hover:to-red-500/20 border border-pink-500/25 transition group active:scale-95">
                <span class="text-base group-hover:scale-110 transition">🎬</span>
                <span class="text-[9px] font-black text-pink-600 dark:text-pink-400 mt-0.5">Reels</span>
              </button>
              <button onclick="handleUserStoryClick()" class="flex flex-col items-center justify-center p-2 rounded-xl bg-gray-50 dark:bg-[#1c1c1c] hover:bg-gray-100 dark:hover:bg-[#252525] border border-gray-200/70 dark:border-[#2a2a2a] transition group active:scale-95">
                <span class="text-base group-hover:scale-110 transition">🐾</span>
                <span class="text-[9px] font-bold text-gray-700 dark:text-gray-300 mt-0.5">+ Hikaye</span>
              </button>
              <button onclick="openPixarModal()" class="flex flex-col items-center justify-center p-2 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 transition group active:scale-95">
                <span class="text-base group-hover:scale-110 transition">🎨</span>
                <span class="text-[9px] font-black text-purple-600 dark:text-purple-400 mt-0.5">3D Pixar</span>
              </button>
              <button id="dash-park-btn" onclick="toggleParkStatus()" class="flex flex-col items-center justify-center p-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 transition group active:scale-95">
                <span id="dash-park-icon" class="text-base group-hover:scale-110 transition">📍</span>
                <span id="dash-park-label" class="text-[9px] font-bold text-amber-700 dark:text-amber-400 mt-0.5">Park</span>
              </button>
            </div>

            <!-- Health & QR Passport Quick Ribbon (Compact, Mobile-Perfect Fit) -->
            <div class="grid grid-cols-3 gap-1.5 pt-2 border-t border-gray-100 dark:border-[#222] text-xs">
              <!-- Vaccine Chip -->
              <button onclick="openPoodleDashboardModal('health')" class="flex items-center justify-center gap-1 px-1.5 py-1 bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 border border-amber-500/30 rounded-lg text-[10px] sm:text-[11px] font-bold transition active:scale-95 cursor-pointer truncate" title="Aşı & Parazit Takvimini Aç">
                <span class="shrink-0">💧</span>
                <span id="dash-vaccine-chip" class="truncate">Parazit: 4 gün</span>
              </button>
              <!-- Weight Chip -->
              <button onclick="openPoodleDashboardModal('health')" class="flex items-center justify-center gap-1 px-1.5 py-1 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 rounded-lg text-[10px] sm:text-[11px] font-bold transition active:scale-95 cursor-pointer truncate" title="Kilo Grafiğini Aç">
                <span class="shrink-0">⚖️</span>
                <span id="dash-weight-chip" class="truncate">2.85 kg · İdeal</span>
              </button>
              <!-- Open Full Hub button -->
              <button onclick="openPoodleDashboardModal('passport')" class="flex items-center justify-center gap-1 px-1.5 py-1 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white rounded-lg text-[10px] sm:text-[11px] font-bold shadow-xs transition active:scale-95 cursor-pointer truncate" title="Pasaport ve Sağlık Kartı">
                <span>🪪 Pasaport</span>
                <svg class="size-2.5 sm:size-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <!-- STORIES CAROUSEL -->
          <div class="bg-white dark:bg-[#121212] border border-[#dbdbdb] dark:border-[#262626] rounded-xl py-3 px-2 flex items-center gap-3 overflow-x-auto no-scrollbar shadow-xs">
            
            <!-- User Story (+) -->
            <button onclick="handleUserStoryClick()" class="flex flex-col items-center gap-1 shrink-0 group">
              <div class="relative size-16 p-0.5 rounded-full">
                <img id="user-story-thumb" src="/images/poodle_mochi.jpg" alt="Senin Hikayen" class="size-full object-cover rounded-full border border-white dark:border-black">
                <span class="absolute bottom-0 right-0 size-5 bg-[#0095f6] text-white rounded-full flex items-center justify-center text-xs font-bold border-2 border-white dark:border-black">+</span>
              </div>
              <span id="user-story-label" class="text-[11px] text-[#737373] group-hover:text-black dark:group-hover:text-white truncate w-16 text-center">Hikayen</span>
              <input type="file" id="user-story-file-input" accept="image/*,video/*" class="hidden" onchange="handleUserStorySelected(event)">
            </button>

            <!-- Stories List -->
            <div id="stories-tray" class="flex items-center gap-3">
              <!-- Dynamically rendered via JS -->
            </div>
          </div>

          <!-- POODLE COLOR & BREED FILTER CHIPS -->
          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
            <button onclick="filterPostsFeed('all', this)" class="feed-chip px-3.5 py-1.5 bg-black text-white dark:bg-white dark:text-black rounded-full text-xs font-bold shrink-0 transition shadow-xs">🐾 Tümü</button>
            <button onclick="filterPostsFeed('red', this)" class="feed-chip px-3 py-1.5 bg-gray-100 dark:bg-[#1f1f1f] hover:bg-gray-200 dark:hover:bg-[#282828] text-xs font-semibold rounded-full shrink-0 transition">🔴 Red Apricot</button>
            <button onclick="filterPostsFeed('toy', this)" class="feed-chip px-3 py-1.5 bg-gray-100 dark:bg-[#1f1f1f] hover:bg-gray-200 dark:hover:bg-[#282828] text-xs font-semibold rounded-full shrink-0 transition">🧸 Toy Poodle</button>
            <button onclick="filterPostsFeed('white', this)" class="feed-chip px-3 py-1.5 bg-gray-100 dark:bg-[#1f1f1f] hover:bg-gray-200 dark:hover:bg-[#282828] text-xs font-semibold rounded-full shrink-0 transition">⚪ Beyaz & Krem</button>
            <button onclick="filterPostsFeed('silver', this)" class="feed-chip px-3 py-1.5 bg-gray-100 dark:bg-[#1f1f1f] hover:bg-gray-200 dark:hover:bg-[#282828] text-xs font-semibold rounded-full shrink-0 transition">⚫ Gümüş & Siyah</button>
            <button onclick="filterPostsFeed('chocolate', this)" class="feed-chip px-3 py-1.5 bg-gray-100 dark:bg-[#1f1f1f] hover:bg-gray-200 dark:hover:bg-[#282828] text-xs font-semibold rounded-full shrink-0 transition">🍫 Çikolata</button>
            <button onclick="filterPostsFeed('standard', this)" class="feed-chip px-3 py-1.5 bg-gray-100 dark:bg-[#1f1f1f] hover:bg-gray-200 dark:hover:bg-[#282828] text-xs font-semibold rounded-full shrink-0 transition">🐩 Standart</button>
          </div>

          <!-- POSTS FEED CONTAINER -->
          <div id="posts-feed" class="flex flex-col gap-4">
            <!-- Dynamically rendered via JS -->
          </div>

          <!-- FEED BOTTOM INDICATOR -->
          <div class="py-8 flex flex-col items-center justify-center gap-2 text-[#737373] text-sm">
            <span class="text-2xl">✨</span>
            <p class="font-medium">Hepsini gördün!</p>
            <p class="text-xs">Son 3 gündeki tüm yeni YourPoodle gönderilerini inceledin.</p>
          </div>
        </div>

        <!-- Right: Suggested Users Sidebar (Desktop Only, ~320px) -->
        <aside class="hidden lg:block w-[320px] pt-4 shrink-0">
          <!-- Current User Profile snippet with Paw Points widget -->
          <div class="flex items-center justify-between mb-6 p-3 bg-white dark:bg-[#121212] border border-[#dbdbdb] dark:border-[#262626] rounded-xl shadow-xs">
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('profile')">
              <div class="size-11 rounded-full overflow-hidden border border-[#dbdbdb] dark:border-[#262626]">
                <img id="sidebar-snippet-avatar" src="/images/poodle_mochi.jpg" alt="Avatar" class="size-full object-cover">
              </div>
              <div class="flex flex-col text-xs">
                <span id="sidebar-snippet-username" class="font-bold cursor-pointer hover:underline">senin_poodlein</span>
                <span id="sidebar-snippet-tag" class="text-[#737373]">Toy Poodle Sever 🐾</span>
              </div>
            </div>
            <button onclick="openPawPointsModal()" class="flex items-center gap-1 px-2.5 py-1 bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 rounded-full text-amber-600 dark:text-amber-400 font-extrabold text-xs transition">
              <span>🐾</span>
              <span id="sidebar-snippet-points">125</span>
            </button>
          </div>

          <!-- Suggestions Header -->
