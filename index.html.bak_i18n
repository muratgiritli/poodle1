    <div class="w-full max-w-sm bg-white dark:bg-[#1e1e1e] rounded-2xl overflow-hidden shadow-2xl divide-y divide-[#efefef] dark:divide-[#2d2d2d] text-xs font-semibold text-center">
      <!-- Hide Button (Always Visible) -->
