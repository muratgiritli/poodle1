# YourPoodle Environment Variables — copy to .env and fill in real values
# NEVER commit .env to version control

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Admin access control (comma-separated IPs, leave empty to allow all)
ADMIN_ALLOWED_IPS=

# CAPTCHA (Cloudflare Turnstile or hCaptcha)
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=

# AI / LLM
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# SMS (NetGSM)
NETGSM_USERCODE=
NETGSM_PASSWORD=

# Rate limiting Redis (optional; falls back to in-memory)
RATE_LIMIT_REDIS_URL=

# Web Push / VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Database
DATABASE_URL=
