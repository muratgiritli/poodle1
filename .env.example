# YourPoodle Environment Variables — copy to .env and fill in real values
# NEVER commit .env to version control

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Admin access control (comma-separated IPs, leave empty to allow all)
ADMIN_ALLOWED_IPS=

# CAPTCHA (Cloudflare Turnstile or hCaptcha)
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=

# AI / LLM
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# SMS (NetGSM)
NETGSM_USERCODE=
NETGSM_PASSWORD=

# Rate limiting / OTP store Redis (optional).
# Prefers Redis when set; otherwise uses Postgres tables (otp_codes, rate_limit_counters).
# Memory is last-resort fallback only.
RATE_LIMIT_REDIS_URL=
# REDIS_URL=

# Web Push / VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Database (local example: postgresql://postgres:petshop123@127.0.0.1:5433/petshop)
DATABASE_URL=

# On yourpoodle.com production host, routes are root-level (/magaza).
# On localhost/dev, client prefixes with /yourpoodle (see IS_YP in client/src/lib/store).

# ── Online Payment Gateways ──────────────────────────────────────────────────
# These env vars override the matching admin-panel DB settings when present.
# Set them via Replit Secrets (never commit real keys to version control).

# iyzico (Iyzipay) — https://merchant.iyzipay.com
# Sandbox base URL: https://sandbox-api.iyzipay.com
# Production base URL: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Tosla (Aktif Bank) — https://www.tosla.com
# Sandbox base URL: https://prepentegrasyon.tosla.com
# Production base URL: https://entegrasyon.tosla.com
TOSLA_CLIENT_ID=
TOSLA_CLIENT_SECRET=
TOSLA_API_USER=
TOSLA_BASE_URL=https://prepentegrasyon.tosla.com
