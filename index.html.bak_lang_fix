      <!-- ================= TAB 2: EXPLORE (KEŞFET) ================= -->
      <div id="tab-explore" class="hidden w-full max-w-[975px] pt-4 md:pt-6 px-2 sm:px-4">
        <!-- Explore Grid (3 Columns) -->
        <div id="explore-grid" class="grid grid-cols-3 gap-1 md:gap-4">
          <!-- Dynamically populated via JS -->
        </div>
      </div>

      <!-- ================= TAB 3: REELS (TIKTOK / IG REELS) ================= -->
      <div id="tab-reels" class="hidden w-full max-w-[500px] py-2 md:py-6 flex flex-col items-center">
        <div id="reels-container" class="w-full flex flex-col gap-6 items-center">
          <!-- Dynamically populated via JS -->
        </div>
      </div>

      <!-- ================= TAB 4: MESSAGES (DIRECT) ================= -->
      <div id="tab-messages" class="hidden w-full max-w-[975px] pt-4 md:pt-6 px-2 sm:px-4">
        <div class="bg-white dark:bg-[#121212] border border-[#dbdbdb] dark:border-[#262626] rounded-xl h-[80vh] flex overflow-hidden">
          
          <!-- Chats list -->
          <div id="dm-conversations-panel" class="w-full md:w-[350px] border-r border-[#dbdbdb] dark:border-[#262626] flex flex-col shrink-0">
            <div class="p-4 border-b border-[#dbdbdb] dark:border-[#262626] flex items-center justify-between">
              <span id="dm-username-header" class="font-bold text-base flex items-center gap-2">senin_poodlein <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></span>
              <button onclick="showToast('Yeni mesaj oluştur')" class="p-1 hover:opacity-70"><svg class="size-6 cursor-pointer" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
            </div>
            <div class="flex-1 overflow-y-auto" id="dm-list">
              <!-- DM Conversations populated by JS -->
            </div>
          </div>

          <!-- Active Chat Window -->
          <div id="dm-chat-panel" class="hidden md:flex flex-1 flex-col justify-between bg-white dark:bg-black">
            <!-- Chat Header -->
            <div class="p-4 border-b border-[#dbdbdb] dark:border-[#262626] flex items-center justify-between">
              <div class="flex items-center gap-3">
                <button onclick="closeMobileDmChat()" class="md:hidden text-xs font-bold text-[#0095f6] flex items-center gap-1 cursor-pointer mr-1">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                  <span>Geri</span>
                </button>
                <img id="dm-header-avatar" src="/images/poodle_luna.jpg" alt="Avatar" class="size-9 rounded-full object-cover">
                <div>
                  <h4 id="dm-header-name" class="font-bold text-sm">luna_parisienne</h4>
                  <p id="dm-header-status" class="text-[11px] text-[#737373] flex items-center gap-1">
                    <span class="inline-block size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Şu anda aktif</span>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-3 text-gray-600 dark:text-gray-300">
                <span class="hidden sm:inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20" title="Uçtan Uca Şifreli Mesajlaşma">
                  <span>🔒</span><span>Şifreli DM</span>
                </span>
                <button onclick="showToast('Sesli arama özelliği yakında!')" class="hover:opacity-70"><svg class="size-6 cursor-pointer" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></button>
                <button onclick="showToast('Görüntülü arama özelliği yakında!')" class="hover:opacity-70"><svg class="size-6 cursor-pointer" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg></button>
              </div>
            </div>

            <!-- Messages Stream -->
            <div id="dm-messages" class="flex-1 p-4 overflow-y-auto flex flex-col gap-3">
              <!-- Messages populated by JS -->
            </div>

            <!-- Realtime Typing Indicator Bar -->
            <div id="dm-typing-indicator" class="hidden px-4 py-1.5 flex items-center gap-2 text-xs text-[#737373] bg-gray-50/90 dark:bg-[#161616]/90 border-t border-[#efefef] dark:border-[#262626]">
              <span id="dm-typing-text" class="font-medium text-[11px]">luna_parisienne yazıyor</span>
              <div class="flex items-center gap-1">
                <span class="size-1.5 bg-[#0095f6] rounded-full animate-bounce" style="animation-delay: 0ms;"></span>
                <span class="size-1.5 bg-[#0095f6] rounded-full animate-bounce" style="animation-delay: 150ms;"></span>
                <span class="size-1.5 bg-[#0095f6] rounded-full animate-bounce" style="animation-delay: 300ms;"></span>
              </div>
            </div>

            <!-- Pending Media Preview Tray (Photo / View Once) -->
            <div id="dm-media-tray" class="hidden px-4 py-2 border-t border-[#efefef] dark:border-[#262626] bg-gray-50/90 dark:bg-[#181818]/90 flex items-center justify-between gap-3 animate-fade-in">
              <div class="flex items-center gap-2.5 min-w-0">
                <img id="dm-media-thumb" src="" alt="Önizleme" class="size-10 rounded-lg object-cover border border-gray-300 dark:border-gray-700 shrink-0">
                <div class="min-w-0 text-xs">
                  <span id="dm-media-tray-label" class="font-bold block truncate">Fotoğraf seçildi</span>
                  <span class="text-[10px] text-gray-400">1440px WebP olarak optimize edilecek</span>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <!-- Toggle View Once Button -->
                <button type="button" id="dm-toggle-viewonce-btn" onclick="toggleDmViewOnceMode()" class="px-2.5 py-1 rounded-full text-xs font-bold border transition flex items-center gap-1.5 border-amber-500 bg-amber-500/10 text-amber-600 dark:text-amber-400 shadow-xs cursor-pointer active:scale-95" title="Tek Seferlik Görüntüleme Modu">
                  <span class="inline-flex items-center justify-center size-4 rounded-full bg-amber-500 text-white text-[10px] font-black">1</span>
                  <span id="dm-viewonce-label">1 Kez Görüntüle: Açık</span>
                </button>
                <button type="button" onclick="cancelDmMediaSelection()" class="size-7 rounded-full bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 text-gray-700 dark:text-gray-200 flex items-center justify-center text-sm transition cursor-pointer" title="İptal">✕</button>
              </div>
            </div>

            <!-- Voice Recording Active Bar -->
            <div id="dm-voice-recording-bar" class="hidden px-4 py-2.5 border-t border-[#efefef] dark:border-[#262626] bg-rose-50/95 dark:bg-rose-950/30 flex items-center justify-between gap-3 animate-fade-in">
              <div class="flex items-center gap-2">
                <span class="size-2.5 rounded-full bg-rose-500 animate-ping"></span>
                <span class="text-xs font-bold text-rose-600 dark:text-rose-400">Ses Kaydediliyor...</span>
                <span id="dm-voice-duration" class="text-xs font-mono font-bold text-gray-700 dark:text-gray-300">00:00</span>
              </div>
              <!-- Waveform visualization bars -->
              <div class="flex items-center gap-1 h-4">
                <span class="w-0.5 h-3 bg-rose-500 rounded-full animate-pulse" style="animation-delay: 0ms"></span>
                <span class="w-0.5 h-5 bg-rose-500 rounded-full animate-pulse" style="animation-delay: 150ms"></span>
                <span class="w-0.5 h-2 bg-rose-500 rounded-full animate-pulse" style="animation-delay: 300ms"></span>
                <span class="w-0.5 h-4 bg-rose-500 rounded-full animate-pulse" style="animation-delay: 450ms"></span>
                <span class="w-0.5 h-3 bg-rose-500 rounded-full animate-pulse" style="animation-delay: 200ms"></span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" onclick="cancelVoiceRecording()" class="px-3 py-1 rounded-xl text-xs font-bold bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 transition active:scale-95 cursor-pointer">İptal</button>
                <button type="button" onclick="stopAndSendVoiceRecording()" class="px-3.5 py-1 rounded-xl text-xs font-bold bg-rose-500 text-white hover:bg-rose-600 transition shadow-xs active:scale-95 flex items-center gap-1 cursor-pointer">
                  <span>Gönder</span><span>🎙️</span>
                </button>
              </div>
            </div>

            <!-- Message Input -->
            <div class="p-3 border-t border-[#dbdbdb] dark:border-[#262626]">
              <input type="file" id="dm-media-input" accept="image/*" class="hidden" onchange="handleDmMediaSelected(event)">
              <form onsubmit="sendDmMessage(event)" class="flex items-center gap-2 border border-[#dbdbdb] dark:border-[#333] rounded-full px-3 py-1.5">
                <!-- Photo / View Once Trigger -->
                <button type="button" onclick="document.getElementById('dm-media-input').click()" class="size-8 rounded-full flex items-center justify-center text-gray-500 hover:text-[#0095f6] hover:bg-gray-100 dark:hover:bg-[#202020] transition active:scale-95 cursor-pointer shrink-0" title="Fotoğraf veya Tek Seferlik Fotoğraf Gönder">
                  <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </button>

                <!-- Voice Recording Trigger -->
                <button type="button" id="dm-mic-btn" onclick="toggleVoiceRecording()" class="size-8 rounded-full flex items-center justify-center text-gray-500 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition active:scale-95 cursor-pointer shrink-0" title="Sesli Mesaj Kaydet">
                  <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                </button>

                <input id="dm-input" type="text" placeholder="Mesaj gönder..." oninput="handleDmTypingInput(this)" class="flex-1 bg-transparent text-sm outline-none px-1">
                <button type="submit" class="text-sm font-bold text-[#0095f6] hover:text-[#1877f2] px-2.5 py-1 transition active:scale-95 cursor-pointer">Gönder</button>
              </form>
            </div>
          </div>

        </div>
      </div>

      <!-- ================= TAB 5: PROFILE ================= -->
      <div id="tab-profile" class="hidden w-full max-w-[935px] pt-2 md:pt-6 px-4 flex flex-col gap-6 md:gap-8">
        
        <!-- Back Bar when viewing other user's profile -->
        <div id="profile-back-bar" class="hidden flex items-center justify-between pb-3 border-b border-[#dbdbdb] dark:border-[#262626]">
          <button onclick="switchTab('home')" class="text-xs font-bold text-[#0095f6] hover:underline flex items-center gap-1.5 cursor-pointer">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            <span>← Akışa Geri Dön</span>
          </button>
          <div class="flex items-center gap-1 font-bold text-sm">
            <span id="profile-back-title">@luna_apricot</span>
            <span class="text-[10px] text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded-full">Poodle Profili</span>
          </div>
          <button onclick="showToast('Profil bağlantısı kopyalandı!')" class="text-xs font-semibold hover:opacity-70 p-1">
            <svg class="size-5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="1.5"/><circle cx="6" cy="12" r="1.5"/><circle cx="18" cy="12" r="1.5"/></svg>
          </button>
        </div>

        <!-- Profile Header -->
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8 border-b border-[#dbdbdb] dark:border-[#262626] pb-8">
          <!-- Avatar with Gradient Ring -->
          <div id="profile-avatar-wrapper" class="size-24 sm:size-36 p-1 rounded-full ig-gradient-ring shrink-0 cursor-pointer relative group" onclick="handleProfileAvatarClick()">
            <img id="profile-main-avatar" src="/images/poodle_mochi.jpg" alt="Poodle Avatar" class="size-full object-cover rounded-full border-2 border-white dark:border-black">
            <span id="profile-avatar-edit-overlay" class="absolute inset-0 bg-black/40 rounded-full flex items-center justify-center text-white text-xs opacity-0 group-hover:opacity-100 transition font-bold">Değiştir 📸</span>
            <input type="file" id="poodle-avatar-input" accept="image/*" class="hidden" onchange="handlePoodleAvatarUpload(event)">
          </div>

          <!-- Details -->
          <div class="flex-1 flex flex-col gap-4 text-center md:text-left">
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <div class="flex items-center gap-1.5 flex-wrap justify-center sm:justify-start">
                <div onclick="openPoodleSwitcherModal()" class="flex items-center gap-1.5 cursor-pointer hover:opacity-80 group" title="Poodle Değiştir 🐩">
                  <h2 id="profile-main-username" class="text-xl font-bold">yourpoodle_official</h2>
                  <div id="profile-switcher-indicator" class="flex items-center gap-1">
                    <svg class="size-4 text-[#737373] group-hover:text-black dark:group-hover:text-white transition" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    <span class="text-[10px] font-bold text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded-full ml-1">Değiştir 🐩</span>
                  </div>
                </div>

                <!-- Mavi Pati Rozeti (Instagram Style Verified Blue Paw Badge) -->
                <span id="profile-verified-badge" onclick="openVerificationModal()" class="hidden items-center ml-1 cursor-pointer transition hover:scale-110 active:scale-95" title="Doğrulanmış Poodle Hesabı (Mavi Pati) 🐾">
                  <svg class="size-4 text-[#0095f6]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                    <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                    <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                    <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                    <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                    <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
                  </svg>
                </span>
                <!-- AI Topluluk Rehberi Rozeti (Official AI Community Guide Badge) -->
                <span id="profile-ai-badge" class="hidden items-center ml-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30 select-none align-middle" title="YourPoodle AI Topluluk Rehberi — Bilgilendirici ve eğitici içerik asistanı">
                  <span>🤖 AI Topluluk Rehberi</span>
                </span>
              </div>

              <!-- Own Profile Action Buttons -->
              <div id="profile-own-actions" class="flex items-center gap-2 flex-wrap justify-center sm:justify-start">
                <button type="button" onclick="openVerificationModal()" id="btn-apply-verified" class="px-3.5 py-1.5 bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-600 hover:to-blue-700 text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5 active:scale-95 cursor-pointer select-none" title="Mavi Pati Doğrulama Başvurusu">
                  <span id="btn-apply-verified-icon">🐾</span>
                  <span id="btn-apply-verified-label">Mavi Pati Başvurusu</span>
                </button>
                <button type="button" onclick="openPoodleDashboardModal('passport')" class="px-3.5 py-1.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5 active:scale-95 cursor-pointer select-none" title="Dijital Pasaport & Sağlık Karnesi">
                  <span>🪪</span>
                  <span>Dijital Pasaport & Sağlık</span>
                </button>
                <button type="button" onclick="openPatternSetupFromProfile()" id="btn-profile-pattern" class="px-3.5 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5 active:scale-95 cursor-pointer select-none" title="Hızlı Giriş Sembolünü Tanımla veya Değiştir">
                  <span>🔒</span>
                  <span>Giriş Sembolü</span>
                </button>
                <button type="button" onclick="openEditProfileModal()" class="px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 dark:bg-[#262626] dark:hover:bg-[#333] border border-gray-300 dark:border-[#444] text-xs font-semibold rounded-lg transition active:scale-95 cursor-pointer select-none flex items-center gap-1.5" title="Profili Düzenle">
                  <span>✏️</span>
                  <span>Poodle Profilini Düzenle</span>
                </button>
                <button type="button" onclick="handleLogout()" class="px-3.5 py-1.5 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900/50 text-rose-600 dark:text-rose-400 text-xs font-semibold rounded-lg transition active:scale-95 cursor-pointer select-none flex items-center gap-1.5" title="Oturumu Kapat">
                  <span>🚪</span>
                  <span>Çıkış Yap</span>
                </button>
              </div>

              <!-- Guest Viewing Banner/Button -->
              <div id="profile-guest-actions" class="hidden flex items-center gap-2 flex-wrap justify-center sm:justify-start">
                <button type="button" onclick="openAuthModal('login')" class="px-4 py-1.5 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-bold rounded-lg transition shadow-sm flex items-center gap-1.5 cursor-pointer">
                  <span>🐾</span>
                  <span data-i18n="nav.login">Giriş Yap / Kaydol</span>
                </button>
              </div>

              <!-- Guest Viewing Banner/Button -->
              <div id="profile-guest-actions" class="hidden flex items-center gap-2 flex-wrap justify-center sm:justify-start">
                <button type="button" onclick="openAuthModal('login')" class="px-4 py-1.5 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-bold rounded-lg transition shadow-sm flex items-center gap-1.5 cursor-pointer">
                  <span>🐾</span>
                  <span data-i18n="nav.login">Giriş Yap / Kaydol</span>
                </button>
              </div>

              <!-- Other User's Profile Action Buttons -->
              <div id="profile-other-actions" class="hidden flex items-center gap-2 flex-wrap justify-center sm:justify-start">
                <button id="profile-main-follow-btn" onclick="toggleMainProfileFollow()" class="px-5 py-1.5 bg-[#0095f6] hover:bg-[#1877f2] text-white text-xs font-semibold rounded-lg transition active:scale-95 shadow-sm">
                  Takip Et
                </button>
                <button onclick="sendDirectMessageFromProfile()" class="px-4 py-1.5 bg-gray-100 hover:bg-gray-200 dark:bg-[#262626] dark:hover:bg-[#333] text-xs font-semibold rounded-lg transition flex items-center gap-1.5 active:scale-95 border border-[#dbdbdb] dark:border-[#444]">
                  <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                  <span>Mesaj Gönder</span>
                </button>
                <button onclick="giftPawPointsFromProfile()" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-bold rounded-lg transition flex items-center gap-1 active:scale-95" title="10 Pati Puanı Hediye Et">
                  <span>🐾</span>
                  <span>Pati Maması İkram Et</span>
                </button>
              </div>
            </div>

            <!-- Stats & Pati Puanı Button -->
            <div class="flex items-center justify-center md:justify-start gap-4 sm:gap-6 text-sm">
              <span><strong id="profile-posts-count">18</strong> gönderi</span>
              <button onclick="openFollowersModal('followers')" class="hover:opacity-80 transition cursor-pointer text-left">
                <span><strong id="profile-followers-count">48.6B</strong> takipçi</span>
              </button>
              <button onclick="openFollowersModal('following')" class="hover:opacity-80 transition cursor-pointer text-left">
                <span><strong id="profile-following-count">294</strong> takip</span>
              </button>
              
              <!-- Pati Puanı Badge (Clickable) -->
              <button onclick="openPawPointsModal()" class="flex items-center gap-1.5 px-3 py-1 bg-gradient-to-r from-amber-500/20 via-orange-500/20 to-pink-500/20 hover:from-amber-500/30 hover:to-pink-500/30 border border-amber-500/40 rounded-full transition shadow-xs group cursor-pointer">
                <span class="text-base group-hover:scale-125 transition">🐾</span>
                <span class="font-extrabold text-xs text-amber-600 dark:text-amber-400"><strong id="profile-paw-points">125</strong> Pati</span>
              </button>
            </div>

            <!-- Bio & Poodle Passport Info -->
            <div class="text-sm flex flex-col gap-1">
              <div class="flex items-center justify-center md:justify-start gap-2 flex-wrap">
                <span id="profile-main-name" class="font-bold text-base">Mochi 🐾</span>
                <span id="profile-badge-variety" class="px-2 py-0.5 bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-[10px] rounded-full border border-amber-500/20">Toy Poodle</span>
                <span id="profile-badge-color" class="px-2 py-0.5 bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-[10px] rounded-full border border-purple-500/20">Red Apricot</span>
                <span id="profile-badge-rank" class="px-2 py-0.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-[10px] rounded-full border border-emerald-500/20">Kıvırcık Kaşif 🎾</span>
                <span id="profile-badge-verified-pill" onclick="openVerificationModal()" class="hidden items-center gap-1 px-2.5 py-0.5 bg-sky-500/10 hover:bg-sky-500/20 text-[#0095f6] font-bold text-[10px] rounded-full border border-[#0095f6]/30 cursor-pointer transition active:scale-95" title="Mavi Pati Onaylı Poodle">
                  <svg class="size-3 text-[#0095f6]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                    <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                    <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                    <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                    <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                    <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
                  </svg>
                  <span>Mavi Pati Onaylı</span>
                </span>
              </div>
              <p id="profile-main-bio" class="text-gray-700 dark:text-gray-300">Park delisi, ödül maması aşığı bir minik prens 🦴👑</p>
              <p id="profile-main-location" class="text-xs text-[#737373] flex items-center justify-center md:justify-start gap-1">📍 İstanbul, Bebek</p>
            </div>
          </div>
        </div>

        <!-- Story Highlights -->
        <div id="profile-highlights-tray" class="flex items-center gap-6 overflow-x-auto no-scrollbar pb-4 border-b border-[#dbdbdb] dark:border-[#262626]">
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_teddy.jpg" alt="Kuaför" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Kuaför ✂️</span>
          </div>
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_coco.jpg" alt="Park" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Park 🎾</span>
          </div>
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_bella.jpg" alt="Bebeklik" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Bebeklik 🍼</span>
          </div>
          <div class="flex flex-col items-center gap-1 shrink-0 cursor-pointer group">
            <div class="size-16 p-0.5 rounded-full border border-[#dbdbdb] dark:border-[#333] group-hover:scale-105 transition">
              <img src="/images/poodle_milo.jpg" alt="Seyahat" class="size-full object-cover rounded-full">
            </div>
            <span class="text-xs font-medium">Seyahat ✈️</span>
          </div>
