    <div class="bg-white dark:bg-[#141414] w-full max-w-4xl h-[92vh] max-h-[780px] rounded-2xl md:rounded-3xl border border-gray-200 dark:border-[#262626] shadow-2xl flex flex-col overflow-hidden animate-scale-up select-text">
      
