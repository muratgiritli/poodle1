      <!-- ================= POODLE SORU-CEVAP & YARDIMLAŞMA KULÜBÜ TAB ================= -->
      <div id="tab-community" class="hidden w-full max-w-[850px] pt-2 md:pt-6 px-2 sm:px-4 flex flex-col gap-5">
        
        <!-- Header Hero & Action Banner -->
        <div class="bg-gradient-to-r from-amber-500/15 via-rose-500/10 to-purple-500/15 border border-amber-500/30 rounded-3xl p-4 sm:p-6 shadow-sm">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-2xl sm:text-3xl">🐾</span>
                <h2 class="text-lg sm:text-xl font-black text-gray-900 dark:text-white" data-i18n="comm.title">Poodle Soru-Cevap & Yardımlaşma Alanı</h2>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30" data-i18n="comm.badge">Canlı Dayanışma</span>
              </div>
              <p class="text-xs text-gray-600 dark:text-gray-300 mt-1.5 max-w-xl leading-relaxed">
                <span data-i18n="comm.desc">Poodle'ınızın sağlığı, aşıları, beslenmesi, tıraşı ve eğitimiyle ilgili sorularınızı sorun; deneyimli Poodle aileleri ve veterinerler yanıtlasın.</span>
              </p>
              
              <!-- Community Highlights -->
              <div class="flex items-center gap-2 flex-wrap mt-3 text-[11px] font-bold text-gray-600 dark:text-gray-300">
                <span class="px-2 py-0.5 rounded-lg bg-white/70 dark:bg-[#1a1a1a]/70 border border-gray-200 dark:border-[#333]"><span data-i18n="comm.statAnswered">💬 1.400+ Yanıtlanmış Soru</span></span>
                <span class="px-2 py-0.5 rounded-lg bg-white/70 dark:bg-[#1a1a1a]/70 border border-gray-200 dark:border-[#333]"><span data-i18n="comm.statExperts">🩺 Uzman & Vet Destekli</span></span>
                <span class="px-2 py-0.5 rounded-lg bg-amber-500/20 text-amber-700 dark:text-amber-300"><span data-i18n="comm.statPoints">🐾 Soruya +25, Cevaba +10 Pati</span></span>
              </div>
            </div>

            <!-- Ask Question Button -->
            <button onclick="openCreateTopicModal()" class="w-full sm:w-auto px-5 py-3 bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 hover:from-amber-600 hover:to-purple-700 text-white font-extrabold text-xs sm:text-sm rounded-2xl shadow-lg transition transform active:scale-95 flex items-center justify-center gap-2 shrink-0 cursor-pointer">
              <span class="text-base">➕</span>
              <span data-i18n="comm.askBtn">Soru Sor (+25 Pati 🐾)</span>
            </button>
          </div>
        </div>

        <!-- Filter Controls: Search & Category Pills -->
        <div class="flex flex-col gap-3 bg-white dark:bg-[#141414] border border-[#dbdbdb] dark:border-[#262626] rounded-2xl p-4 shadow-xs">
          <!-- Search Row -->
          <div class="flex items-center gap-2.5">
            <div class="relative flex-1">
              <svg class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="community-search-input" type="text" oninput="filterCommunityTopics()" data-i18n-placeholder="comm.searchPlaceholder" placeholder="Kafana takılan soruyu ara (örn: karma aşı, göz lekesi, patella, tıraş, tuvalet eğitimi)..." class="w-full pl-9 pr-3 py-2.5 bg-gray-50 dark:bg-[#1e1e1e] border border-gray-200 dark:border-[#333] rounded-xl text-xs outline-none focus:border-[#0095f6] text-gray-900 dark:text-white placeholder-gray-400">
            </div>
            <button onclick="loadCommunityTopics()" class="px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 dark:bg-[#222] dark:hover:bg-[#2c2c2c] rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer active:scale-95 shrink-0" title="Yenile">
              <span>🔄</span>
              <span class="hidden sm:inline" data-i18n="comm.refresh">Yenile</span>
            </button>
          </div>

          <!-- Category Pills Row (No native scrollbar) -->
          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 text-xs pt-1 border-t border-gray-100 dark:border-[#222]">
            <button onclick="setCommunityCategory('all', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-extrabold bg-black dark:bg-white text-white dark:text-black shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catAll">Tüm Sorular</button>
            <button onclick="setCommunityCategory('saglik', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catHealth">🩺 Sağlık & Aşı</button>
            <button onclick="setCommunityCategory('beslenme', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catDiet">🥩 Beslenme & Mama</button>
            <button onclick="setCommunityCategory('bakim', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catGrooming">✂️ Bakım & Tıraş</button>
            <button onclick="setCommunityCategory('egitim', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catTraining">🎾 Eğitim & Tuvalet</button>
            <button onclick="setCommunityCategory('tanisma', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catMeetup">👋 Tanışma & Deneyim</button>
            <button onclick="setCommunityCategory('topluluk', this)" class="comm-cat-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-[#2a2a2a] shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.catCity">📍 Şehir Buluşmaları</button>
          </div>

          <!-- Poodle Variety Filter Row -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar text-xs pt-1">
            <span class="text-[10px] font-extrabold text-gray-400 shrink-0 uppercase tracking-wider" data-i18n="comm.breedLabel">Poodle Cinsi:</span>
            <button onclick="setCommunityVariety('all', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-[#0095f6] text-white shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.varAll">Tümü</button>
            <button onclick="setCommunityVariety('toy', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.varToy">🐩 Toy</button>
            <button onclick="setCommunityVariety('miniature', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.varMini">🐕 Miniature</button>
            <button onclick="setCommunityVariety('standard', this)" class="comm-variety-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-gray-100 dark:bg-[#202020] text-gray-700 dark:text-gray-300 hover:bg-gray-200 shrink-0 transition active:scale-95 cursor-pointer" data-i18n="comm.varStd">👑 Standard</button>
          </div>
        </div>

        <!-- Topics List Container -->
        <div id="community-topics-list" class="flex flex-col gap-3.5 pb-8">
          <!-- Dynamically populated via JS -->
          <div class="py-12 text-center text-xs text-gray-500 flex items-center justify-center gap-2">
            <span>🔄</span>
            <span>Sorular ve deneyimler yükleniyor... 🐾</span>
          </div>
        </div>

