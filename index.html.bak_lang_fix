          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-3 border-b border-[#efefef] dark:border-[#333]">
        <div class="relative">
          <svg class="size-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="followers-search-input" oninput="filterFollowersModalList(this.value)" placeholder="Poodle veya sahip ara..." class="w-full pl-9 pr-3 py-1.5 bg-[#efefef] dark:bg-[#1f1f1f] rounded-lg text-xs outline-none">
        </div>
      </div>
      <div id="followers-modal-list" class="flex-1 overflow-y-auto divide-y divide-[#efefef]/50 dark:divide-[#333]/50 p-2">
        <!-- Rendered via JS -->
      </div>
    </div>
  </div>

  <!-- PWA INSTALL BANNER -->
  <div id="pwa-install-banner" class="fixed bottom-16 md:bottom-6 left-4 right-4 md:left-6 md:right-auto md:max-w-md bg-gradient-to-r from-amber-500 via-pink-500 to-purple-600 text-white p-3.5 rounded-2xl shadow-2xl z-40 hidden flex items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="size-11 rounded-xl bg-white/20 backdrop-blur-sm p-1.5 flex items-center justify-center shrink-0">
        <span class="text-2xl">🐩</span>
      </div>
      <div class="flex flex-col text-left">
        <span class="font-extrabold text-xs">YourPoodle Uygulamasını Yükle</span>
        <span class="text-[11px] opacity-90">Ana ekranına ekle, bildirimleri ve DM'leri kaçırma!</span>
      </div>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <button onclick="installPWA()" class="px-3.5 py-1.5 bg-white text-gray-900 font-bold text-xs rounded-xl shadow hover:bg-white/90 active:scale-95 transition">Yükle</button>
      <button onclick="dismissPWABanner()" class="p-1 hover:bg-white/20 rounded-lg text-white/80 hover:text-white transition">
        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- FLOATING CELEBRATION TOAST FOR PAW POINTS -->
  <div id="paw-toast" class="fixed top-6 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-500 via-orange-500 to-pink-500 text-white font-extrabold text-sm px-6 py-3 rounded-full shadow-2xl z-50 transform -translate-y-24 opacity-0 transition-all duration-300 flex items-center gap-3 pointer-events-none">
    <span class="text-2xl animate-bounce">🐾</span>
    <span id="paw-toast-text">+50 Pati Puanı Kazandın!</span>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="fixed bottom-16 md:bottom-6 right-6 bg-[#262626] text-white text-xs px-4 py-3 rounded-lg shadow-xl z-50 transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-2">
    <span>✅</span>
    <span id="toast-text">İşlem başarıyla tamamlandı.</span>
  </div>

  <!-- ================= MAVİ PATİ DOĞRULAMA (VERIFIED BLUE PAW) MODAL ================= -->
  <div id="verified-badge-modal" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-2 sm:p-4 backdrop-blur-sm">
    <div class="bg-white dark:bg-[#161616] text-gray-900 dark:text-gray-100 rounded-3xl w-full max-w-xl overflow-hidden flex flex-col max-h-[92vh] shadow-2xl border border-sky-500/40">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-gray-100 dark:border-[#262626] flex items-center justify-between gap-3 bg-gradient-to-r from-sky-500/15 via-blue-500/10 to-indigo-500/15">
        <div class="flex items-center gap-3 min-w-0">
          <div class="size-11 rounded-2xl bg-gradient-to-tr from-[#0095f6] to-sky-400 text-white flex items-center justify-center shadow-md shrink-0">
            <svg class="size-6 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
              <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
              <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
              <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
              <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
              <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <h3 class="font-extrabold text-base tracking-tight truncate">Mavi Pati Doğrulama Başvurusu</h3>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 truncate">Instagram tarzı doğrulanmış tescilli Poodle rozeti</p>
          </div>
        </div>

        <button onclick="closeVerificationModal()" class="p-2 text-gray-400 hover:text-black dark:hover:text-white rounded-xl hover:bg-gray-100 dark:hover:bg-[#252525] transition">
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">
        
        <!-- ================= VIEW A: APPLICATION FORM ================= -->
        <div id="view-verify-apply" class="space-y-5">
          <!-- Benefits Banner -->
          <div class="rounded-2xl p-4 bg-gradient-to-r from-sky-500/10 via-blue-500/5 to-indigo-500/10 border border-[#0095f6]/20 space-y-2.5">
            <h4 class="text-xs font-black uppercase text-[#0095f6] tracking-wider flex items-center gap-1.5">
              <span>🌟</span>
              <span>Mavi Pati Rozetinin Ayrıcalıkları</span>
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">💎</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">Resmi Güvenilirlik</strong>
                  <span class="text-[11px] text-gray-500">Adının yanında orijinal tescil rozeti</span>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">🚀</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">Keşfet & Akış Önceliği</strong>
                  <span class="text-[11px] text-gray-500">Gönderiler vitrinde öne çıkar</span>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">🛡️</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">Klon Hesap Koruması</strong>
                  <span class="text-[11px] text-gray-500">Taklitçilere karşı tam koruma</span>
                </div>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-xl bg-white/70 dark:bg-[#1e1e1e] border border-gray-100 dark:border-[#2a2a2a]">
                <span class="text-base">🎁</span>
                <div>
                  <strong class="block text-gray-800 dark:text-gray-200">+100 Pati Puanı Bonusu</strong>
                  <span class="text-[11px] text-gray-500">Anında cüzdanına tanımlanır</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Application Form -->
          <form onsubmit="handleVerificationSubmit(event)" class="space-y-4">
            
            <!-- User & Poodle Quick Summary Box -->
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200/80 dark:border-[#2a2a2a]">
              <img id="verify-avatar-preview" src="/images/poodle_mochi.jpg" class="size-12 rounded-full object-cover border-2 border-[#0095f6] shrink-0">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <span id="verify-poodle-display-name" class="font-bold text-sm">Mochi</span>
                  <span class="text-xs text-gray-500" id="verify-username-handle">@senin_poodlein</span>
                </div>
                <div class="flex items-center gap-2 text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
                  <span id="verify-poodle-variety-chip">Toy Poodle</span>
                  <span>·</span>
                  <span id="verify-poodle-color-chip">Red Apricot</span>
                </div>
              </div>
              <span class="px-2.5 py-1 bg-sky-500/10 text-[#0095f6] border border-[#0095f6]/20 font-bold text-[10px] rounded-lg shrink-0">
                Aday Hesap
              </span>
            </div>

            <!-- Verification Category -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                1. Başvuru Kategorisi <span class="text-rose-500">*</span>
              </label>
              <select id="verify-category" required class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs font-semibold focus:outline-none focus:border-[#0095f6] text-gray-800 dark:text-gray-200">
                <option value="Popüler Poodle & İçerik Üreticisi">🐩 Popüler Poodle & Sosyal İçerik Üreticisi</option>
                <option value="Şampiyon & Yarışma Dereceli (Show Dog)">🏆 Şampiyon & Yarışma Dereceli (Show Dog)</option>
                <option value="FCI / KIF / AKC Soy Kütüğü (Pedigree)">📜 FCI / KIF / AKC Soy Kütüğü (Pedigree)</option>
                <option value="Resmi Terapi & Hizmet Köpeği">🩺 Resmi Terapi & Hizmet Köpeği</option>
                <option value="Doğrulanmış Aktif Topluluk Üyesi">🐾 Doğrulanmış Aktif Topluluk Üyesi</option>
              </select>
            </div>

            <!-- Microchip & Registration Info -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                  2. Mikroçip veya Karne No <span class="text-rose-500">*</span>
                </label>
                <input id="verify-chip-input" type="text" required value="TR-982009104829104" placeholder="Örn: TR-982009104829104" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs font-mono font-bold focus:outline-none focus:border-[#0095f6]">
              </div>
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                  3. Kayıtlı Veteriner Kliniği
                </label>
                <input id="verify-vet-input" type="text" placeholder="Örn: Bebek Veteriner Kliniği" value="Bebek Veteriner Polikliniği" class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs focus:outline-none focus:border-[#0095f6]">
              </div>
            </div>

            <!-- Document Upload Field -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                4. Doğrulama Belgesi Yükle (Aşı Karnesi, Çip Belgesi veya Soy Kütüğü) <span class="text-rose-500">*</span>
              </label>
              
              <div onclick="document.getElementById('verify-file-input').click()" class="border-2 border-dashed border-[#0095f6]/40 hover:border-[#0095f6] rounded-2xl p-4 text-center cursor-pointer bg-sky-50/50 dark:bg-sky-950/20 transition group">
                <input type="file" id="verify-file-input" accept="image/*,.pdf" class="hidden" onchange="handleVerifyFileSelect(event)">
                
                <div id="verify-upload-empty" class="flex flex-col items-center justify-center gap-2">
                  <div class="size-10 rounded-full bg-sky-500/20 text-[#0095f6] flex items-center justify-center text-xl group-hover:scale-110 transition">
                    📸
                  </div>
                  <div>
                    <span class="text-xs font-bold text-gray-800 dark:text-gray-200 block">Belge fotoğrafını seç veya buraya tıkla</span>
                    <span class="text-[11px] text-gray-500">Veteriner aşı karnesi ilk sayfası veya çip barkodu (JPG, PNG)</span>
                  </div>
                </div>

                <div id="verify-upload-selected" class="hidden flex items-center justify-center gap-3">
                  <span class="text-2xl">📑</span>
                  <div class="text-left">
                    <span id="verify-filename" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 block truncate max-w-xs">asi_karnesi_mochi.jpg</span>
                    <span class="text-[10px] text-gray-500">Belge hazır · Değiştirmek için tıkla</span>
                  </div>
                  <span class="px-2 py-0.5 bg-emerald-500/20 text-emerald-500 text-[10px] font-bold rounded-full">✓ Yüklendi</span>
                </div>
              </div>
            </div>

            <!-- Statement / Note -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">
                5. Başvuru Notu & Gerekçe
              </label>
              <textarea id="verify-note-input" rows="2" placeholder="Poodle'ınız hakkında belirtmek istediğiniz ek detaylar..." class="w-full px-3.5 py-2 bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200 dark:border-[#2a2a2a] rounded-xl text-xs focus:outline-none focus:border-[#0095f6]">YourPoodle topluluğunda doğrulanmış aktif bir Toy Poodle profili olarak yer almak istiyorum.</textarea>
            </div>

            <!-- Declaration Checkbox -->
            <div class="flex items-start gap-2.5 p-3 rounded-xl bg-gray-50 dark:bg-[#1c1c1c] border border-gray-200/70 dark:border-[#2a2a2a]">
              <input type="checkbox" id="verify-agree-checkbox" required checked class="mt-0.5 rounded text-[#0095f6] focus:ring-[#0095f6] size-4">
              <label for="verify-agree-checkbox" class="text-[11px] text-gray-600 dark:text-gray-400 cursor-pointer select-none leading-relaxed">
                Beyan ettiğim kimlik, aşı ve mikroçip belgelerinin gerçeği yansıttığını, YourPoodle Topluluk Kuralları'na ve hayvan refahı ilkelerine sadık kalacağımı taahhüt ederim.
              </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="btn-submit-verification" class="w-full py-3 bg-gradient-to-r from-sky-500 via-blue-600 to-indigo-600 hover:from-sky-600 hover:to-indigo-700 text-white font-extrabold text-sm rounded-xl shadow-lg transition transform active:scale-98 flex items-center justify-center gap-2">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
              </svg>
              <span>Mavi Pati Başvurusunu Tamamla ve Rozeti Al</span>
            </button>
          </form>

          <!-- Animated Review Verification Modal Simulation -->
          <div id="verify-review-progress" class="hidden rounded-2xl p-5 bg-gradient-to-r from-sky-500/10 via-blue-500/10 to-indigo-500/10 border border-[#0095f6]/30 text-center space-y-3">
            <div class="size-14 rounded-full bg-gradient-to-tr from-[#0095f6] to-sky-400 mx-auto flex items-center justify-center animate-bounce shadow-md">
              <span class="text-2xl text-white">🐾</span>
            </div>
            <div class="space-y-1">
              <h4 id="verify-progress-title" class="font-bold text-sm text-gray-900 dark:text-gray-100">Belgeler Doğrulanıyor...</h4>
              <p id="verify-progress-desc" class="text-xs text-gray-500">Veteriner çip ve ırk tescil kaydı taranıyor</p>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 h-2 rounded-full overflow-hidden">
              <div id="verify-progress-bar" class="h-full bg-gradient-to-r from-sky-400 to-[#0095f6] transition-all duration-500 w-1/4"></div>
            </div>
          </div>
        </div>

                  <!-- ================= VIEW C: PENDING REVIEW ================= -->
          <div id="view-verify-pending" class="hidden space-y-5">
            <div class="rounded-2xl p-6 bg-gradient-to-r from-amber-500/10 via-sky-500/10 to-indigo-500/10 border border-amber-500/30 text-center space-y-4">
              <div class="size-16 rounded-full bg-amber-500 text-white mx-auto flex items-center justify-center text-3xl shadow-lg animate-pulse">⏳</div>
              <div>
                <h4 class="font-extrabold text-base text-gray-900 dark:text-gray-100">Mavi Pati Başvurunuz İncelemede</h4>
                <p class="text-xs text-gray-500 mt-1 max-w-sm mx-auto">Başvurunuz ve yüklediğiniz veteriner belgeleri yönetici onay havuzuna iletildi. Uzman ekibimiz belgeleri onayladığında Mavi Pati rozetiniz otomatik olarak profilinize tanımlanacaktır.</p>
              </div>

              <div class="p-3 bg-white dark:bg-[#202020] rounded-xl text-xs space-y-2 border border-gray-200 dark:border-[#333] text-left">
                <div class="flex justify-between items-center pb-1.5 border-b border-gray-100 dark:border-[#2a2a2a]">
                  <span class="text-gray-500">Durum:</span>
                  <span class="font-bold text-amber-500 flex items-center gap-1">⏳ Beklemede (Yönetici Onayı Bekleniyor)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Poodle:</span>
                  <span id="pending-poodle-name" class="font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Mikroçip No:</span>
                  <span id="pending-chip-no" class="font-mono font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Kategori:</span>
                  <span id="pending-category" class="font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-500">Başvuru Tarihi:</span>
                  <span id="pending-date" class="font-bold text-gray-400">Bugün</span>
                </div>
              </div>

              <div class="p-3 bg-sky-500/10 rounded-xl text-[11px] text-sky-700 dark:text-sky-300">
                💡 İncelemeler genellikle 24 saat içerisinde sonuçlandırılır. Belgeniz onaylandığında bildirim alacaksınız.
              </div>
            </div>
          </div>

          <!-- ================= VIEW B: ACTIVE VERIFIED CERTIFICATE ================= -->
        <div id="view-verify-active" class="hidden space-y-5">
          <!-- Deluxe Certificate Card -->
          <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-sky-950 to-blue-950 text-white p-6 sm:p-7 shadow-2xl border-2 border-sky-400/50">
            <!-- Watermark -->
            <div class="absolute -right-6 -bottom-6 text-9xl opacity-10 pointer-events-none select-none">🐾</div>
            <div class="absolute top-3 right-4 opacity-40 text-sky-300 text-[10px] font-mono tracking-widest uppercase">OFFICIAL VERIFIED BADGE</div>

            <!-- Certificate Header -->
            <div class="flex items-center gap-3 border-b border-white/15 pb-4 mb-5">
              <div class="size-12 rounded-2xl bg-[#0095f6] text-white flex items-center justify-center shadow-lg shrink-0">
                <svg class="size-7" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                  <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                  <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                  <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                  <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                  <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
                </svg>
              </div>
              <div>
                <h4 class="font-black text-sm tracking-wide uppercase text-sky-300">YourPoodle Resmi Doğrulama Sertifikası</h4>
                <p class="text-[11px] text-gray-300">Tescilli Poodle Hesabı ve Mavi Pati Rozeti Tasdiki</p>
              </div>
            </div>

            <!-- Certificate Body -->
            <div class="space-y-4 text-xs">
              <div class="flex items-center gap-3 bg-white/10 p-3 rounded-2xl backdrop-blur-xs">
                <img id="cert-avatar" src="/images/poodle_mochi.jpg" class="size-12 rounded-full object-cover border-2 border-white/60">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span id="cert-display-name" class="font-extrabold text-sm text-white">Mochi</span>
                    <svg class="size-4 text-[#38bdf8]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.79-4-4-4-.495 0-.965.084-1.4.238C14.55 2.475 13.18 1.6 11.6 1.6c-1.58 0-2.95.875-3.6 2.148-.435-.154-.905-.238-1.4-.238-2.21 0-4 1.79-4 4 4 .495 0 .965-.084 1.4-.238.65 1.273 2.02 2.148 3.6 2.148 1.58 0 2.95-.875 3.6-2.148.435.154.905.238 1.4.238 2.21 0 4-1.79 4-4 0-.495-.084-.965-.238-1.4 1.273-.65 2.148-2.02 2.148-3.6z"/>
                      <ellipse cx="11.6" cy="14.3" rx="3.3" ry="2.6" fill="#ffffff"/>
                      <circle cx="7.7" cy="10.8" r="1.15" fill="#ffffff"/>
                      <circle cx="10.2" cy="8.6" r="1.15" fill="#ffffff"/>
                      <circle cx="13.2" cy="8.6" r="1.15" fill="#ffffff"/>
                      <circle cx="15.7" cy="10.8" r="1.15" fill="#ffffff"/>
                    </svg>
                  </div>
                  <span id="cert-username" class="text-xs text-sky-200 font-mono">@senin_poodlein</span>
                </div>
                <span class="px-2.5 py-1 bg-emerald-500/30 text-emerald-300 font-bold text-[10px] rounded-full border border-emerald-400/40">
                  ● AKTİF VE GEÇERLİ
                </span>
              </div>

              <!-- Certificate Attributes Grid -->
              <div class="grid grid-cols-2 gap-2.5">
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                  <span class="text-[10px] text-gray-400 uppercase font-bold block">Sertifika Kodu</span>
                  <strong id="cert-code" class="text-sky-300 font-mono text-xs">YP-PAW-94821</strong>
                </div>
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                  <span class="text-[10px] text-gray-400 uppercase font-bold block">Doğrulama Kategorisi</span>
                  <strong id="cert-category" class="text-white text-xs truncate block">Popüler Poodle & İçerik Üreticisi</strong>
                </div>
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                  <span class="text-[10px] text-gray-400 uppercase font-bold block">Tescilli Mikroçip</span>
                  <strong id="cert-microchip" class="text-white font-mono text-xs">TR-982009104829104</strong>
                </div>
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                  <span class="text-[10px] text-gray-400 uppercase font-bold block">Onay Tarihi</span>
                  <strong id="cert-date" class="text-emerald-400 text-xs">17 Ekim 2026</strong>
                </div>
              </div>
            </div>

            <!-- Certificate Actions -->
            <div class="mt-5 pt-4 border-t border-white/15 flex flex-wrap items-center justify-between gap-3">
              <button onclick="shareVerificationCertificate()" class="px-4 py-2 bg-white/15 hover:bg-white/25 rounded-xl text-xs font-bold transition flex items-center gap-1.5 active:scale-95">
                <span>🔗</span>
                <span>Sertifikayı Paylaş</span>
              </button>
              <button onclick="toggleVerifiedBadgeDisplay()" id="btn-toggle-badge-display" class="px-4 py-2 bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-400/30 rounded-xl text-xs font-bold transition flex items-center gap-1.5 active:scale-95">
                <span>👁️</span>
                <span id="btn-toggle-badge-text">Rozeti Gizle</span>
              </button>
              <button onclick="closeVerificationModal()" class="px-5 py-2 bg-[#0095f6] hover:bg-sky-600 rounded-xl text-xs font-bold transition active:scale-95">
                Tamam
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- ================= TOPIC DETAIL & DISCUSSION MODAL ================= -->
  <div id="topic-detail-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">
    <div class="w-full max-w-2xl bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl border border-[#dbdbdb] dark:border-[#333] flex flex-col max-h-[92vh]">
      <!-- Header -->
      <div class="p-4 border-b border-[#efefef] dark:border-[#2a2a2a] flex items-center justify-between bg-gray-50 dark:bg-[#202020]">
        <div class="flex items-center gap-2">
          <span class="text-xl">💬</span>
          <h3 id="topic-modal-cat-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/15 text-amber-700 dark:text-amber-300">Topluluk Konusu</h3>
          <span id="topic-modal-solved-badge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400">Çözüldü ✅</span>
        </div>
        <button onclick="closeTopicDetailModal()" class="text-gray-400 hover:text-black dark:hover:text-white p-1 rounded-lg text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <!-- Scrollable Body -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
        <!-- Question Body -->
        <div class="border-b border-[#efefef] dark:border-[#262626] pb-4">
          <h2 id="topic-modal-title" class="text-base sm:text-lg font-extrabold text-gray-900 dark:text-white leading-snug"></h2>
          <div class="flex items-center gap-3 mt-3 text-xs text-[#737373]">
            <div class="flex items-center gap-2">
              <img id="topic-modal-avatar" src="/images/poodle_mochi.jpg" class="size-6 rounded-full object-cover border border-[#dbdbdb] dark:border-[#333]">
              <span id="topic-modal-author" class="font-bold text-gray-900 dark:text-white"></span>
              <span id="topic-modal-badge"></span>
            </div>
            <span>·</span>
            <span id="topic-modal-city"></span>
            <span>·</span>
            <span id="topic-modal-time"></span>
          </div>
          <div id="topic-modal-content" class="mt-3 text-xs sm:text-sm text-gray-800 dark:text-gray-200 leading-relaxed whitespace-pre-line"></div>
          <div id="topic-modal-media" class="mt-3 hidden">
            <img src="" class="max-h-72 w-full object-cover rounded-xl border border-[#dbdbdb] dark:border-[#333]">
          </div>
          <div class="flex items-center justify-between mt-4 pt-3 border-t border-[#f0f0f0] dark:border-[#262626] text-xs">
            <button id="topic-modal-upvote-btn" onclick="voteActiveTopic()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 font-bold transition active:scale-95 cursor-pointer">
              <span>🐾 Pati Oyu</span>
              <strong id="topic-modal-upvotes">1</strong>
            </button>
            <div class="text-[#737373] text-[11px] flex items-center gap-3">
              <span id="topic-modal-views">340 görüntülenme</span>
              <span id="topic-modal-replies-count">2 yanıt</span>
            </div>
          </div>
        </div>

        <!-- Replies Section -->
        <div>
          <h4 class="font-bold text-xs uppercase tracking-wider text-gray-400 mb-3">Yanıtlar & Deneyimler</h4>
          <div id="topic-modal-replies-list" class="space-y-3">
            <!-- Replies populated dynamically -->
          </div>
        </div>
      </div>

      <!-- Add Reply Bar -->
      <form onsubmit="submitActiveTopicReply(event)" class="p-3 sm:p-4 border-t border-[#efefef] dark:border-[#262626] bg-gray-50 dark:bg-[#202020] flex items-center gap-2">
        <input id="topic-reply-input" type="text" required placeholder="Deneyimini veya cevabını paylaş (+10 Pati 🐾)..." class="flex-1 px-3 py-2 bg-white dark:bg-[#151515] border border-gray-200 dark:border-[#333] rounded-xl text-xs outline-none focus:border-[#0095f6]">
        <button type="submit" class="px-4 py-2 bg-[#0095f6] hover:bg-[#1877f2] text-white font-bold text-xs rounded-xl shadow-xs transition active:scale-95 cursor-pointer">Yanıtla</button>
      </form>
    </div>
  </div>

  <!-- ================= CREATE NEW TOPIC MODAL ================= -->
  <div id="create-topic-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-3 sm:p-4 backdrop-blur-sm">
    <div class="w-full max-w-lg bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl border border-[#dbdbdb] dark:border-[#333] flex flex-col max-h-[92vh]">
      <div class="p-4 border-b border-[#efefef] dark:border-[#2a2a2a] flex items-center justify-between bg-gray-50 dark:bg-[#202020]">
        <div class="flex items-center gap-2">
          <span class="text-xl">➕</span>
          <h3 class="font-bold text-sm sm:text-base">Yeni Soru / Konu Başlat</h3>
        </div>
        <button onclick="closeCreateTopicModal()" class="text-gray-400 hover:text-black dark:hover:text-white p-1 rounded-lg text-lg leading-none cursor-pointer">&times;</button>
      </div>

      <form onsubmit="submitNewTopic(event)" class="p-4 sm:p-5 space-y-3.5 overflow-y-auto flex-1 text-xs">
        <div>
          <label class="font-bold text-gray-500 uppercase block mb-1">Konu Başlığı *</label>
          <input type="text" id="new-topic-title" required placeholder="Örn: Toy Poodle için ilk tıraş ne zaman yapılmalı?" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl font-bold focus:outline-none focus:border-[#0095f6]">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="font-bold text-gray-500 uppercase block mb-1">Kategori *</label>
            <select id="new-topic-cat" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl focus:outline-none focus:border-[#0095f6]">
              <option value="bakim">✂️ Bakım & Traş</option>
              <option value="beslenme">🥩 Beslenme & Diyet</option>
              <option value="egitim">🎾 Eğitim & Yavru</option>
              <option value="saglik">🩺 Sağlık & Aşı</option>
              <option value="topluluk">📍 Şehir Buluşmaları</option>
              <option value="tanisma">👋 Tanışma Masası</option>
              <option value="sahiplenme">🤝 Sahiplenme & Eşleşme</option>
            </select>
          </div>
          <div>
            <label class="font-bold text-gray-500 uppercase block mb-1">Poodle Boyu / Varyetesi</label>
            <select id="new-topic-var" class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl focus:outline-none focus:border-[#0095f6]">
              <option value="all">Fark Etmez / Tümü</option>
              <option value="toy">🐩 Toy Poodle</option>
              <option value="miniature">🐕 Miniature Poodle</option>
              <option value="standard">👑 Standard Poodle</option>
            </select>
          </div>
        </div>

        <div>
          <label class="font-bold text-gray-500 uppercase block mb-1">Şehir</label>
          <input type="text" id="new-topic-city" placeholder="Örn: İstanbul, Ankara, İzmir..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl focus:outline-none focus:border-[#0095f6]">
        </div>

        <div>
          <label class="font-bold text-gray-500 uppercase block mb-1">Soru / Açıklama Detayları *</label>
          <textarea id="new-topic-content" rows="4" required placeholder="Yaşadığınız durumu veya sormak istediğiniz ayrıntıları yazın..." class="w-full px-3 py-2 bg-gray-50 dark:bg-[#262626] border border-gray-200 dark:border-[#383838] rounded-xl focus:outline-none focus:border-[#0095f6]"></textarea>
        </div>

        <div>
          <label class="font-bold text-gray-700 dark:text-gray-300 uppercase block mb-1.5 flex items-center justify-between">
            <span>📸 Fotoğraf Ekle (İsteğe Bağlı)</span>
            <span class="text-[10px] text-gray-400 font-normal">Alerji, aşı karnesi, kürk veya mama fotoğrafı</span>
          </label>
          
          <input type="file" id="new-topic-image-file" accept="image/*" class="hidden" onchange="handleTopicImageSelected(event)">
          <input type="hidden" id="new-topic-media" value="">

          <!-- Upload Drop / Select Box -->
          <div id="new-topic-upload-box" onclick="document.getElementById('new-topic-image-file').click()" class="border-2 border-dashed border-gray-300 dark:border-[#404040] hover:border-amber-500 rounded-2xl p-4 text-center cursor-pointer transition bg-gray-50 dark:bg-[#202020] flex flex-col items-center justify-center gap-1.5 active:scale-98">
            <span class="text-2xl">📷</span>
            <span class="font-bold text-gray-700 dark:text-gray-200 text-xs">Fotoğraf Seç veya Kamerayla Çek</span>
            <span class="text-[10px] text-gray-400">JPG, PNG (Maks 10MB)</span>
          </div>

          <!-- Selected Preview Box -->
          <div id="new-topic-preview-box" class="hidden relative rounded-2xl overflow-hidden border border-gray-200 dark:border-[#333] mt-2">
            <img id="new-topic-preview-img" src="" class="w-full max-h-52 object-cover">
            <button type="button" onclick="clearTopicImageSelection(event)" class="absolute top-2 right-2 bg-black/70 hover:bg-black text-white p-1.5 rounded-full size-7 flex items-center justify-center text-xs cursor-pointer shadow-md">✕</button>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" id="btn-submit-topic" class="w-full py-3 bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 hover:from-amber-600 hover:to-purple-700 text-white font-extrabold rounded-xl shadow-md transition transform active:scale-95 cursor-pointer flex items-center justify-center gap-2">
            <span>Soruyu Toplulukla Paylaş 🐾</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] bg-white/20 font-black">+25 Pati</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= POST OPTIONS MODAL (HIDE, REPORT, EDIT, DELETE) ================= -->
  <div id="post-options-modal" class="fixed inset-0 z-50 bg-black/75 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white dark:bg-[#1e1e1e] rounded-2xl overflow-hidden shadow-2xl divide-y divide-[#efefef] dark:divide-[#2d2d2d] text-xs font-semibold text-center">
      <!-- Hide Button (Always Visible) -->
      <button onclick="handleHidePostAction()" class="w-full py-3.5 px-4 text-amber-600 dark:text-amber-400 hover:bg-amber-500/10 font-bold transition flex items-center justify-center gap-2 cursor-pointer">
        <span>🚫</span>
        <span>İlgilenmiyorum (Bu Gönderiyi Gizle)</span>
      </button>

      <!-- Report Button -->
      <button onclick="handleReportPostAction()" class="w-full py-3.5 px-4 text-[#ed4956] hover:bg-red-500/10 font-bold transition flex items-center justify-center gap-2 cursor-pointer">
        <span>🚩</span>
        <span>Gönderiyi Şikayet Et</span>
      </button>

      <!-- Author Only: Edit -->
      <button id="post-opt-edit-btn" onclick="handleEditPostAction()" class="hidden w-full py-3.5 px-4 text-blue-600 dark:text-blue-400 hover:bg-blue-500/10 font-bold transition flex items-center justify-center gap-2 cursor-pointer">
        <span>✏️</span>
        <span>Açıklamayı Düzenle</span>
      </button>

      <!-- Author Only: Delete -->
      <button id="post-opt-delete-btn" onclick="handleDeletePostAction()" class="hidden w-full py-3.5 px-4 text-red-600 hover:bg-red-500/10 font-bold transition flex items-center justify-center gap-2 cursor-pointer">
        <span>🗑️</span>
        <span>Gönderiyi Sil</span>
      </button>

      <!-- Copy Link -->
      <button onclick="handleCopyPostLinkAction()" class="w-full py-3 px-4 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-[#282828] transition flex items-center justify-center gap-2 cursor-pointer">
        <span>🔗</span>
        <span>Bağlantıyı Kopyala</span>
      </button>

      <!-- Cancel -->
      <button onclick="closePostOptionsModal()" class="w-full py-3 px-4 text-gray-500 hover:bg-gray-100 dark:hover:bg-[#282828] font-normal transition cursor-pointer">
        Vazgeç
      </button>
    </div>
  </div>

  <!-- ================= REPORT MODAL ================= -->
  <div id="report-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#efefef] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🛡️</span>
          <h3 class="font-bold text-sm">İçerik Şikayeti</h3>
        </div>
        <button onclick="closeReportModal()" class="text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <p class="text-xs text-gray-600 dark:text-gray-400">Bu içeriğin topluluk kurallarını ihlal ettiğini düşünüyorsanız lütfen sebebi seçin:</p>
      
      <div class="space-y-2 text-xs">
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Spam / İstenmeyen Reklam" checked class="text-[#0095f6]">
          <span>Spam veya İstenmeyen Reklam</span>
        </label>
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Yanıltıcı veya Zararlı Bilgi" class="text-[#0095f6]">
          <span>Yanıltıcı veya Köpek Sağlığına Zararlı Bilgi</span>
        </label>
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Uygunsuz Görsel veya Hakaret" class="text-[#0095f6]">
          <span>Uygunsuz Görsel, Taciz veya Hakaret</span>
        </label>
        <label class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252525] cursor-pointer">
          <input type="radio" name="report_reason" value="Telif Hakkı / İzinsiz Fotoğraf" class="text-[#0095f6]">
          <span>Telif Hakkı / İzinsiz Poodle Fotoğrafı</span>
        </label>
      </div>

      <button onclick="submitContentReport()" class="w-full py-2.5 bg-[#ed4956] hover:bg-red-600 text-white font-bold text-xs rounded-xl transition shadow-xs cursor-pointer">
        Moderasyon Ekibine İlet 🛡️
      </button>
    </div>
  </div>

  <!-- ================= EDIT POST MODAL ================= -->
  <div id="edit-post-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#efefef] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">✏️</span>
          <h3 class="font-bold text-sm">Gönderi Açıklamasını Düzenle</h3>
        </div>
        <button onclick="closeEditPostModal()" class="text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <textarea id="edit-post-caption-input" rows="4" class="w-full p-3 bg-gray-50 dark:bg-[#222] border border-gray-200 dark:border-[#333] rounded-xl text-xs outline-none focus:border-[#0095f6]"></textarea>

      <button onclick="saveEditedPost()" class="w-full py-2.5 bg-[#0095f6] hover:bg-[#1877f2] text-white font-bold text-xs rounded-xl transition shadow-xs cursor-pointer">
        Değişiklikleri Kaydet
      </button>
    </div>
  </div>

  <!-- ================= NOTIFICATION PREFERENCES MODAL ================= -->
  <div id="notif-preferences-modal" class="fixed inset-0 z-50 bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white dark:bg-[#1a1a1a] rounded-2xl overflow-hidden shadow-2xl p-5 flex flex-col gap-4 border border-[#dbdbdb] dark:border-[#333]">
      <div class="flex items-center justify-between border-b border-[#efefef] dark:border-[#333] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">⚙️</span>
          <h3 class="font-bold text-sm">Bildirim Tercihleri</h3>
        </div>
        <button onclick="closeNotifPreferencesModal()" class="text-xl font-bold leading-none cursor-pointer">&times;</button>
      </div>

      <p class="text-xs text-gray-500">Hangi durumlarda anında bildirim almak istediğinizi belirleyin:</p>

      <div class="space-y-3 text-xs">
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">❤️ Beğeniler</span>
          <input type="checkbox" id="pref-likes" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">💬 Yorumlar & Yanıtlar</span>
          <input type="checkbox" id="pref-comments" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">👤 Yeni Takipçiler</span>
          <input type="checkbox" id="pref-follows" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">✉️ Özel Mesajlar (DM)</span>
          <input type="checkbox" id="pref-messages" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
        <div class="flex items-center justify-between p-2 rounded-xl bg-gray-50 dark:bg-[#222]">
          <span class="font-semibold">🐾 Topluluk & Forum Yanıtları</span>
          <input type="checkbox" id="pref-forum" checked class="scale-125 accent-[#0095f6] cursor-pointer">
        </div>
