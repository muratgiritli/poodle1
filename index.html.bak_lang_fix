    <div class="w-full sm:max-w-md bg-white dark:bg-[#161616] rounded-t-3xl sm:rounded-3xl shadow-2xl border border-gray-200 dark:border-[#2a2a2a] flex flex-col max-h-[85vh] overflow-hidden animate-slide-up sm:animate-scale-up">
