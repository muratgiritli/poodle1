  let currentLang = DEFAULT_LANG;

  function detectLanguage() {
    // 1. Check URL path prefix (e.g. /en/, /ja/, /es/, /tr/, etc.)
    const path = window.location.pathname.toLowerCase();
    for (const lang of SUPPORTED_LANGS) {
      if (path === `/${lang.code.toLowerCase()}` || path.startsWith(`/${lang.code.toLowerCase()}/`)) {
        return lang.code;
      }
    }

    // 2. Check localStorage
    const saved = localStorage.getItem('yp_lang');
    if (saved && SUPPORTED_LANGS.some(l => l.code === saved)) {
      return saved;
    }

    // 3. Check browser language
    const navLangs = navigator.languages || [navigator.language || ''];
    for (const nl of navLangs) {
      const code = nl.toLowerCase();
      if (code.startsWith('ja')) return 'ja';
      if (code.startsWith('ko')) return 'ko';
      if (code.startsWith('zh')) return 'zh-CN';
      if (code.startsWith('es')) return 'es';
      if (code.startsWith('fr')) return 'fr';
      if (code.startsWith('de')) return 'de';
      if (code.startsWith('pt')) return 'pt';
      if (code.startsWith('tr')) return 'tr';
      if (code.startsWith('en')) return 'en';
    }

    // 4. Default to English
    return DEFAULT_LANG;
  }

  function t(key, fallback) {
    const dict = TRANSLATIONS[currentLang] || TRANSLATIONS[DEFAULT_LANG];
    if (dict && dict[key] !== undefined) {
      return dict[key];
    }
    const enDict = TRANSLATIONS[DEFAULT_LANG];
    if (enDict && enDict[key] !== undefined) {
      return enDict[key];
    }
    return fallback || key;
  }

  function setLanguage(langCode, updateUrl = true) {
    const langObj = SUPPORTED_LANGS.find(l => l.code === langCode);
    if (!langObj) return;

    currentLang = langCode;
    localStorage.setItem('yp_lang', langCode);

    // Update document attributes
    document.documentElement.lang = langCode;
    document.documentElement.dir = langObj.dir || 'ltr';

    // Update document title & meta description
    if (SEO_TITLES[langCode]) {
      document.title = SEO_TITLES[langCode];
    }
    const metaDesc = document.querySelector('meta[name="description"]');
    if (metaDesc && SEO_DESCRIPTIONS[langCode]) {
      metaDesc.setAttribute('content', SEO_DESCRIPTIONS[langCode]);
    }

    // Update URL if requested
    if (updateUrl) {
      let path = window.location.pathname;
      // Strip any existing language prefix
      for (const l of SUPPORTED_LANGS) {
        if (path === `/${l.code.toLowerCase()}` || path.startsWith(`/${l.code.toLowerCase()}/`)) {
          path = path.slice(l.code.length + 1) || '/';
          break;
        }
      }
      if (!path.startsWith('/')) path = '/' + path;
      const newPath = `/${langCode}${path === '/' ? '' : path}`;
      if (window.location.pathname !== newPath) {
        window.history.replaceState({ lang: langCode }, '', newPath + window.location.search + window.location.hash);
      }
    }

    // Apply translations across DOM
    applyDomTranslations();

    // Update language selector triggers
    updateLanguageSelectorsUI();

    // Trigger re-renders in app if functions are available
    if (typeof window.onLanguageChange === 'function') {
      window.onLanguageChange(langCode);
    }
  }


  // ================= MASTER PHRASE MAP (470+ INTERFACE PHRASES IN 9 LANGUAGES) =================
  const PHRASE_MAP = {"Aktif edildiğinde QR künyeyi okutan kişiye acil iletişim butonu, 5.000 TL ödül bilgisi ve GPS haritası gösterilir.":{"tr":"Aktif edildiğinde QR künyeyi okutan kişiye acil iletişim butonu, 5.000 TL ödül bilgisi ve GPS haritası gösterilir.","en":"When activated, an emergency contact button, 5,000 TL reward information and a GPS map will be displayed to the person who scans the QR tag.","ja":"有効にすると、QRタグをスキャンした人に緊急連絡ボタン、5,000TL特典情報、GPS地図が表示されます。","es":"Cuando se activa, se mostrará a la persona que escanee la etiqueta QR un botón de contacto de emergencia, información de recompensa de 5000 TL y un mapa GPS.","fr":"Lorsqu'il est activé, un bouton de contact d'urgence, des informations de récompense de 5 000 TL et une carte GPS seront affichés à la personne qui scanne l'étiquette QR.","de":"Bei Aktivierung werden der Person, die den QR-Tag scannt, eine Notfallkontakttaste, 5.000 TL-Prämieninformationen und eine GPS-Karte angezeigt.","pt":"Quando ativado, um botão de contato de emergência, informações de recompensa de 5.000 TL e um mapa GPS serão exibidos para a pessoa que digitalizar a etiqueta QR.","ko":"활성화되면 QR 태그를 스캔한 사람에게 긴급연락 버튼과 5,000TL 보상정보, GPS 지도가 표시됩니다.","zh-CN":"激活后，扫描 QR 标签的人将看到紧急联系按钮、5,000 TL 奖励信息和 GPS 地图。"},"💡 İncelemeler genellikle 24 saat içerisinde sonuçlandırılır. Belgeniz onaylandığında bildirim alacaksınız.":{"tr":"💡 İncelemeler genellikle 24 saat içerisinde sonuçlandırılır. Belgeniz onaylandığında bildirim alacaksınız.","en":"💡 Reviews are usually completed within 24 hours. You will receive notification when your document is approved.","ja":"💡 レビューは通常 24 時間以内に完了します。文書が承認されると通知が届きます。","es":"💡 Las revisiones generalmente se completan dentro de las 24 horas. Recibirá una notificación cuando su documento sea aprobado.","fr":"💡 Les évaluations sont généralement terminées dans les 24 heures. Vous recevrez une notification lorsque votre document sera approuvé.","de":"💡 Bewertungen werden in der Regel innerhalb von 24 Stunden abgeschlossen. Sie erhalten eine Benachrichtigung, wenn Ihr Dokument genehmigt wurde.","pt":"💡 As revisões geralmente são concluídas em 24 horas. Você receberá uma notificação quando seu documento for aprovado.","ko":"💡 리뷰는 일반적으로 24시간 이내에 완료됩니다. 문서가 승인되면 알림을 받게 됩니다.","zh-CN":"💡 审核通常在24小时内完成。当您的文件获得批准后，您将收到通知。"},"\"Merhaba! Ben Mochi. Ailemden uzaklaştım ve kayboldum. Lütfen aileme haber ver, beni çok merak ediyorlar!\"":{"tr":"\"Merhaba! Ben Mochi. Ailemden uzaklaştım ve kayboldum. Lütfen aileme haber ver, beni çok merak ediyorlar!\"","en":"\"Hello! I'm Mochi. I moved away from my family and got lost. Please inform my family, they are very curious about me!\"","ja":"「こんにちは！モチです。家族と離れて引っ越して迷子になってしまいました。家族に知らせてください。とても興味津々です！」","es":"\"¡Hola! Soy Mochi. Me alejé de mi familia y me perdí. ¡Por favor informa a mi familia, tienen mucha curiosidad por mí!\"","fr":"\"Bonjour ! Je m'appelle Mochi. J'ai quitté ma famille et je me suis perdu. S'il vous plaît, informez ma famille, elle est très curieuse à mon sujet !\"","de":"„Hallo! Ich bin Mochi. Ich bin von meiner Familie weggezogen und habe mich verlaufen. Bitte informieren Sie meine Familie, sie ist sehr neugierig auf mich!“","pt":"\"Olá! Meu nome é Mochi. Afastei-me da minha família e me perdi. Por favor, informe minha família, eles estão muito curiosos sobre mim!\"","ko":"\"안녕하세요! 저는 모찌입니다. 가족과 떨어져서 길을 잃었습니다. 가족들에게 알려주세요. 저에 대해 매우 궁금해합니다!\"","zh-CN":"“你好！我是Mochi。我搬离了家人，迷路了。请通知我的家人，他们对我很好奇！”"},"YourPoodle topluluğunda doğrulanmış aktif bir Toy Poodle profili olarak yer almak istiyorum.":{"tr":"YourPoodle topluluğunda doğrulanmış aktif bir Toy Poodle profili olarak yer almak istiyorum.","en":"I would like to join the YourPoodle community as a verified active Toy Poodle profile.","ja":"私は、検証済みのアクティブなトイ プードル プロフィールとして YourPoodle コミュニティに参加したいと考えています。","es":"Me gustaría unirme a la comunidad YourPoodle como un perfil de Toy Poodle activo verificado.","fr":"J'aimerais rejoindre la communauté YourPoodle en tant que profil Toy Poodle actif vérifié.","de":"Ich möchte der YourPoodle-Community als verifiziertes aktives Toypudel-Profil beitreten.","pt":"Gostaria de me juntar à comunidade YourPoodle como um perfil ativo verificado do Toy Poodle.","ko":"검증된 활성 토이 푸들 프로필로 YourPoodle 커뮤니티에 가입하고 싶습니다.","zh-CN":"我想加入 YourPoodle 社区，成为经过验证的活跃玩具贵宾犬个人资料。"},"Parktayım butonuna basıldığında park adı diğer Poodle dostlarına bildirim olarak iletilsin.":{"tr":"Parktayım butonuna basıldığında park adı diğer Poodle dostlarına bildirim olarak iletilsin.","en":"When the \"I'm in the park\" button is pressed, the park name will be sent as a notification to other Poodle friends.","ja":"「パークにいるよ」ボタンを押すと、パーク名が他のプードルのお友達に通知として送信されます。","es":"Cuando se presiona el botón \"Estoy en el parque\", el nombre del parque se enviará como notificación a otros amigos Poodle.","fr":"Lorsque vous appuyez sur le bouton \"Je suis dans le parc\", le nom du parc sera envoyé sous forme de notification aux autres amis caniches.","de":"Wenn die Schaltfläche „Ich bin im Park“ gedrückt wird, wird der Name des Parks als Benachrichtigung an andere Pudelfreunde gesendet.","pt":"Ao pressionar o botão \"Estou no parque\", o nome do parque será enviado como notificação para outros amigos Poodle.","ko":"\"나는 공원에 있습니다\" 버튼을 누르면 공원 이름이 다른 푸들 친구들에게 알림으로 전송됩니다.","zh-CN":"当按下“我在公园里”按钮时，公园名称将作为通知发送给其他贵宾犬朋友。"},"Kafana takılan soruyu ara (örn: karma aşı, göz lekesi, patella, tıraş, tuvalet eğitimi)...":{"tr":"Kafana takılan soruyu ara (örn: karma aşı, göz lekesi, patella, tıraş, tuvalet eğitimi)...","en":"Search for the question you are wondering about (e.g. combination vaccine, eye spot, patella, shaving, toilet training)...","ja":"気になる質問を検索してください (混合ワクチン、アイスポット、膝蓋骨、髭剃り、トイレトレーニングなど)...","es":"Busque la pregunta que le interesa (por ejemplo, vacuna combinada, mancha ocular, rótula, afeitado, entrenamiento para ir al baño)...","fr":"Recherchez la question qui vous pose des questions (par exemple vaccin combiné, taches oculaires, rotule, rasage, apprentissage de la propreté)...","de":"Suchen Sie nach der Frage, die Sie beschäftigt (z. B. Kombinationsimpfstoff, Augenfleckenkrankheit, Patella, Rasur, Toilettentraining) ...","pt":"Pesquise a pergunta sobre a qual você está se perguntando (por exemplo, vacina combinada, manchas no olho, patela, barbear, treinamento para usar o banheiro)...","ko":"궁금하신 점을 검색해 보세요(예: 복합백신, 안대, 슬개골, 면도, 배변훈련)...","zh-CN":"搜索您想知道的问题（例如联合疫苗、眼斑、髌骨、剃须、如厕训练）..."},"Beğendiğin Poodle fotoğraflarını ve videolarını daha sonra kolayca bulmak için kaydet.":{"tr":"Beğendiğin Poodle fotoğraflarını ve videolarını daha sonra kolayca bulmak için kaydet.","en":"Save the Poodle photos and videos you like to easily find them later.","ja":"気に入ったプードルの写真やビデオを保存しておくと、後で簡単に見つけることができます。","es":"Guarde las fotos y videos de Poodle que desee para encontrarlos fácilmente más tarde.","fr":"Enregistrez les photos et vidéos de caniche que vous aimez pour les retrouver facilement plus tard.","de":"Speichern Sie die Pudelfotos und -videos, die Ihnen gefallen, um sie später leicht wiederzufinden.","pt":"Salve as fotos e vídeos do Poodle que você gosta para encontrá-los facilmente mais tarde.","ko":"나중에 쉽게 찾을 수 있도록 좋아하는 푸들 사진과 비디오를 저장하세요.","zh-CN":"保存您喜欢的贵宾犬照片和视频，以便以后轻松找到它们。"},"Bu içeriğin topluluk kurallarını ihlal ettiğini düşünüyorsanız lütfen sebebi seçin:":{"tr":"Bu içeriğin topluluk kurallarını ihlal ettiğini düşünüyorsanız lütfen sebebi seçin:","en":"If you think this content violates the community guidelines, please select the reason:","ja":"このコンテンツがコミュニティ ガイドラインに違反していると思われる場合は、その理由を選択してください:","es":"Si cree que este contenido viola las pautas de la comunidad, seleccione el motivo:","fr":"Si vous pensez que ce contenu enfreint le règlement de la communauté, veuillez en sélectionner la raison :","de":"Wenn Sie der Meinung sind, dass dieser Inhalt gegen die Community-Richtlinien verstößt, wählen Sie bitte den Grund aus:","pt":"Se você acha que este conteúdo viola as diretrizes da comunidade, selecione o motivo:","ko":"이 콘텐츠가 커뮤니티 가이드라인을 위반한다고 생각되면 이유를 선택하세요.","zh-CN":"如果您认为此内容违反了社区准则，请选择原因："},"Yalnızca onayladığınız takipçiler gönderi ve reels videolarınızı izleyebilir.":{"tr":"Yalnızca onayladığınız takipçiler gönderi ve reels videolarınızı izleyebilir.","en":"Only followers you approve can watch your posts and reels.","ja":"あなたが承認したフォロワーのみがあなたの投稿とリールを視聴できます。","es":"Solo los seguidores que apruebes pueden ver tus publicaciones y carretes.","fr":"Seuls les abonnés que vous approuvez peuvent regarder vos publications et vos reels.","de":"Nur von Ihnen genehmigte Follower können Ihre Beiträge und Reels ansehen.","pt":"Somente seguidores que você aprovar podem assistir suas postagens e vídeos.","ko":"귀하가 승인한 팔로워만 귀하의 게시물과 영상을 볼 수 있습니다.","zh-CN":"只有您批准的关注者才能观看您的帖子和视频。"},"Kayıtlı Poodle profili bulunamadı. \"Yeni Poodle Ekle\" ile ekleyebilirsiniz.":{"tr":"Kayıtlı Poodle profili bulunamadı. \"Yeni Poodle Ekle\" ile ekleyebilirsiniz.","en":"No registered Poodle profiles found. You can add it with \"Add New Poodle\".","ja":"登録されたプードル プロファイルが見つかりません。 「新しいプードルを追加」で追加できます。","es":"No se encontraron perfiles de Caniche registrados. Puedes agregarlo con \"Agregar nuevo caniche\".","fr":"Aucun profil de caniche enregistré n'a été trouvé. Vous pouvez l'ajouter avec \"Ajouter un nouveau caniche\".","de":"Keine registrierten Pudelprofile gefunden. Sie können es mit „Neuen Pudel hinzufügen“ hinzufügen.","pt":"Nenhum perfil de Poodle registrado encontrado. Você pode adicioná-lo com \"Adicionar Novo Poodle\".","ko":"등록된 푸들 프로필이 없습니다. \"새 푸들 추가\"로 추가할 수 있습니다.","zh-CN":"未找到已注册的贵宾犬配置文件。您可以通过“添加新贵宾犬”来添加它。"},"YourPoodle AI Topluluk Rehberi — Bilgilendirici ve eğitici içerik asistanı":{"tr":"YourPoodle AI Topluluk Rehberi — Bilgilendirici ve eğitici içerik asistanı","en":"YourPoodle AI Community Guide — Informative and educational content assistant","ja":"YourPoodle AI コミュニティ ガイド — 有益で教育的なコンテンツ アシスタント","es":"Guía comunitaria de YourPoodle AI: asistente de contenido informativo y educativo","fr":"Guide communautaire YourPoodle AI — Assistant de contenu informatif et éducatif","de":"YourPoodle AI Community Guide – informativer und lehrreicher Inhaltsassistent","pt":"Guia da comunidade YourPoodle AI – Assistente de conteúdo informativo e educacional","ko":"YourPoodle AI 커뮤니티 가이드 — 유익하고 교육적인 콘텐츠 도우미","zh-CN":"YourPoodle AI 社区指南 - 信息和教育内容助手"},"Aramak istediğin Poodle dostunu, sahibini veya konuyu yazmaya başla...":{"tr":"Aramak istediğin Poodle dostunu, sahibini veya konuyu yazmaya başla...","en":"Start typing the Poodle friend, owner or subject you want to search for...","ja":"検索したいプードルの友達、飼い主、または件名を入力してください...","es":"Comienza a escribir el amigo, dueño o sujeto del Caniche que deseas buscar...","fr":"Commencez à saisir l'ami, le propriétaire ou le sujet caniche que vous souhaitez rechercher...","de":"Beginnen Sie mit der Eingabe des Pudelfreundes, -besitzers oder -subjekts, nach dem Sie suchen möchten ...","pt":"Comece digitando o amigo, dono ou assunto Poodle que deseja pesquisar...","ko":"검색하려는 푸들 친구, 소유자 또는 주제를 입력하기 시작하세요...","zh-CN":"开始输入您要搜索的贵宾犬朋友、主人或主题..."},"4. Doğrulama Belgesi Yükle (Aşı Karnesi, Çip Belgesi veya Soy Kütüğü)":{"tr":"4. Doğrulama Belgesi Yükle (Aşı Karnesi, Çip Belgesi veya Soy Kütüğü)","en":"4. Upload Verification Document (Vaccination Card, Chip Certificate or Pedigree)","ja":"4. 確認書類（ワクチン接種カード、チップ証明書、または血統書）をアップロードします。","es":"4. Cargar Documento de Verificación (Cédula de Vacunación, Certificado de Chip o Pedigrí)","fr":"4. Téléchargez le document de vérification (carte de vaccination, certificat de puce ou pedigree)","de":"4. Verifizierungsdokument hochladen (Impfausweis, Chipzertifikat oder Stammbaum)","pt":"4. Carregar documento de verificação (cartão de vacinação, certificado de chip ou pedigree)","ko":"4. 확인서류(예방접종카드, 칩인증서, 혈통서) 업로드","zh-CN":"4.上传验证文件（疫苗卡、芯片证书或血统书）"},"Takip ettiğiniz bir Poodle yakındaki bir parka geldiğinde haber ver.":{"tr":"Takip ettiğiniz bir Poodle yakındaki bir parka geldiğinde haber ver.","en":"Notify me when a Poodle you are following comes to a nearby park.","ja":"あなたがフォローしているプードルが近くの公園に来ると通知します。","es":"Avísame cuando un caniche al que estás siguiendo llegue a un parque cercano.","fr":"Prévenez-moi lorsqu'un caniche que vous suivez arrive dans un parc à proximité.","de":"Benachrichtigen Sie mich, wenn ein Pudel, dem Sie folgen, in einen nahegelegenen Park kommt.","pt":"Avise-me quando um Poodle que você está seguindo chegar a um parque próximo.","ko":"당신이 따라다니는 푸들이 근처 공원에 오면 알려주세요.","zh-CN":"当您跟踪的贵宾犬来到附近的公园时通知我。"},"Bu soruya henüz yanıt verilmemiş. İlk deneyimini paylaşan sen ol! 🐾":{"tr":"Bu soruya henüz yanıt verilmemiş. İlk deneyimini paylaşan sen ol! 🐾","en":"This question has not been answered yet. Be the first to share your experience! 🐾","ja":"この質問にはまだ答えられていません。あなたの経験を最初に共有してください! 🐾","es":"Esta pregunta aún no ha sido respondida. ¡Sé el primero en compartir tu experiencia! 🐾","fr":"Cette question n'a pas encore reçu de réponse. Soyez le premier à partager votre expérience ! 🐾","de":"Diese Frage wurde noch nicht beantwortet. Seien Sie der Erste, der Ihre Erfahrungen teilt! 🐾","pt":"Esta pergunta ainda não foi respondida. Seja o primeiro a compartilhar sua experiência! 🐾","ko":"이 질문은 아직 답변되지 않았습니다. 귀하의 경험을 가장 먼저 공유해 주세요! 🐾","zh-CN":"这个问题还没有答案。成为第一个分享您的经验的人！ 🐾"},"Telefon numaranıza SMS ile gelen 4 haneli kod ile anında bağlanın.":{"tr":"Telefon numaranıza SMS ile gelen 4 haneli kod ile anında bağlanın.","en":"Connect instantly with the 4-digit code sent to your phone number via SMS.","ja":"SMS 経由で電話番号に送信された 4 桁のコードですぐに接続できます。","es":"Conéctate instantáneamente con el código de 4 dígitos enviado a tu número de teléfono vía SMS.","fr":"Connectez-vous instantanément avec le code à 4 chiffres envoyé à votre numéro de téléphone par SMS.","de":"Verbinden Sie sich sofort mit dem 4-stelligen Code, der per SMS an Ihre Telefonnummer gesendet wird.","pt":"Conecte-se instantaneamente com o código de 4 dígitos enviado para o seu número de telefone via SMS.","ko":"SMS를 통해 전화번호로 전송된 4자리 코드로 즉시 연결하세요.","zh-CN":"使用通过短信发送到您的电话号码的 4 位数代码立即连接。"},"Aşı ve parazit damlası tarihine 3 gün kala telefona uyarı gönder.":{"tr":"Aşı ve parazit damlası tarihine 3 gün kala telefona uyarı gönder.","en":"Send an alert to your phone 3 days before the vaccination and parasite drop date.","ja":"ワクチン接種と寄生虫駆除日の 3 日前に携帯電話にアラートを送信します。","es":"Envía una alerta a tu teléfono 3 días antes de la fecha de vacunación y desparasitación.","fr":"Envoyez une alerte sur votre téléphone 3 jours avant la date de vaccination et de dépose du parasite.","de":"Senden Sie 3 Tage vor dem Impf- und Parasitenabwurfdatum eine Benachrichtigung auf Ihr Telefon.","pt":"Envie um alerta para o seu telefone 3 dias antes da data de vacinação e queda do parasita.","ko":"예방접종 및 기생충 퇴치일 3일 전에 휴대폰으로 알림을 보냅니다.","zh-CN":"在疫苗接种和寄生虫滴落日期前 3 天向您的手机发送提醒。"},"Poodle'ın hakkında bir açıklama yaz... 🐾 #toypoodle #poodlelove":{"tr":"Poodle'ın hakkında bir açıklama yaz... 🐾 #toypoodle #poodlelove","en":"Write a description about your poodle... 🐾 #toypoodle #poodlelove","ja":"あなたのプードルについて説明を書いてください... 🐾 #トイプードル #プードル愛","es":"Escribe una descripción sobre tu caniche... 🐾 #toypoodle #poodlelove","fr":"Écrivez une description de votre caniche... 🐾 #toypoodle #poodlelove","de":"Schreiben Sie eine Beschreibung über Ihren Pudel... 🐾 #toypoodle #poodlelove","pt":"Escreva uma descrição sobre o seu poodle... 🐾 #toypoodle #poodlelove","ko":"당신의 푸들에 대한 설명을 적어주세요... 🐾 #toypoodle #poodlelove","zh-CN":"写下关于您的贵宾犬的描述...🐾 #toypoodle #poodlelove"},"Farklı bir renk veya boy seçebilir veya tüm akışı görebilirsin.":{"tr":"Farklı bir renk veya boy seçebilir veya tüm akışı görebilirsin.","en":"You can choose a different color or size, or view the entire feed.","ja":"別の色やサイズを選択するか、フィード全体を表示できます。","es":"Puedes elegir un color o tamaño diferente, o ver todo el feed.","fr":"Vous pouvez choisir une autre couleur ou taille, ou afficher tout le flux.","de":"Du kannst eine andere Farbe oder Größe wählen oder den gesamten Feed anzeigen.","pt":"Você pode escolher uma cor ou tamanho diferente ou ver todo o feed.","ko":"다른 색상이나 크기를 선택하거나 전체 피드를 볼 수 있습니다.","zh-CN":"您可以选择其他颜色或体型，或查看全部动态。"},"Hangi durumlarda anında bildirim almak istediğinizi belirleyin:":{"tr":"Hangi durumlarda anında bildirim almak istediğinizi belirleyin:","en":"Determine when you want to receive push notifications:","ja":"プッシュ通知をいつ受信するかを決定します。","es":"Determine cuándo desea recibir notificaciones automáticas:","fr":"Déterminez quand vous souhaitez recevoir des notifications push :","de":"Legen Sie fest, wann Sie Push-Benachrichtigungen erhalten möchten:","pt":"Determine quando deseja receber notificações push:","ko":"푸시 알림을 언제 받을지 결정하세요.","zh-CN":"确定您希望何时接收推送通知："},"Yaşadığınız durumu veya sormak istediğiniz ayrıntıları yazın...":{"tr":"Yaşadığınız durumu veya sormak istediğiniz ayrıntıları yazın...","en":"Write down the situation you are experiencing or the details you want to ask...","ja":"あなたが経験している状況や聞きたいことの詳細を書き留めてください...","es":"Anota la situación que estás viviendo o los detalles que quieres preguntar...","fr":"Notez la situation que vous vivez ou les détails que vous souhaitez demander...","de":"Schreiben Sie die Situation auf, in der Sie sich befinden, oder die Details, nach denen Sie fragen möchten ...","pt":"Anote a situação que você está vivenciando ou os detalhes que deseja perguntar...","ko":"겪고 있는 상황이나 묻고 싶은 내용을 적어주세요...","zh-CN":"写下您正在经历的情况或您想询问的细节......"},"Parmağınızla en az 4 noktayı birleştirerek sembolünüzü çizin.":{"tr":"Parmağınızla en az 4 noktayı birleştirerek sembolünüzü çizin.","en":"Draw your symbol by connecting at least 4 dots with your finger.","ja":"指で少なくとも 4 つの点を結んでシンボルを描きます。","es":"Dibuja tu símbolo conectando al menos 4 puntos con tu dedo.","fr":"Dessinez votre symbole en reliant au moins 4 points avec votre doigt.","de":"Zeichnen Sie Ihr Symbol, indem Sie mindestens 4 Punkte mit Ihrem Finger verbinden.","pt":"Desenhe seu símbolo conectando pelo menos 4 pontos com o dedo.","ko":"손가락으로 최소 4개의 점을 연결하여 기호를 그립니다.","zh-CN":"用手指连接至少 4 个点来绘制符号。"},"Veteriner aşı karnesi ilk sayfası veya çip barkodu (JPG, PNG)":{"tr":"Veteriner aşı karnesi ilk sayfası veya çip barkodu (JPG, PNG)","en":"Veterinary vaccination certificate first page or chip barcode (JPG, PNG)","ja":"獣医師のワクチン接種証明書の最初のページまたはチップのバーコード (JPG、PNG)","es":"Certificado de vacunación veterinaria primera página o chip con código de barras (JPG, PNG)","fr":"Première page du certificat de vaccination vétérinaire ou code-barres de la puce (JPG, PNG)","de":"Veterinär-Impfbescheinigung erste Seite oder Chip-Barcode (JPG, PNG)","pt":"Primeira página do certificado de vacinação veterinária ou código de barras do chip (JPG, PNG)","ko":"수의사 예방접종 증명서 첫 페이지 또는 칩 바코드(JPG, PNG)","zh-CN":"兽医疫苗接种证书首页或芯片条形码（JPG、PNG）"},"Poodle sağlığı için kritik aşı ve parazit yenileme süreleri":{"tr":"Poodle sağlığı için kritik aşı ve parazit yenileme süreleri","en":"Critical vaccination and parasite renewal periods for Poodle health","ja":"プードルの健康にとって重要なワクチン接種と寄生虫の更新期間","es":"Periodos críticos de vacunación y renovación de parásitos para la salud del Caniche","fr":"Périodes critiques de vaccination et de renouvellement des parasites pour la santé du caniche","de":"Wichtige Impf- und Parasitenerneuerungsperioden für die Gesundheit des Pudels","pt":"Períodos críticos de vacinação e renovação de parasitas para a saúde do Poodle","ko":"푸들 건강을 위한 중요한 예방접종 및 기생충 갱신 기간","zh-CN":"贵宾犬健康的关键疫苗接种和寄生虫更新期"},"Son 3 gündeki tüm yeni YourPoodle gönderilerini inceledin.":{"tr":"Son 3 gündeki tüm yeni YourPoodle gönderilerini inceledin.","en":"You've viewed all new YourPoodle posts from the last 3 days.","ja":"過去 3 日間の YourPoodle の新しい投稿をすべて表示しました。","es":"Has visto todas las publicaciones nuevas de YourPoodle de los últimos 3 días.","fr":"Vous avez consulté toutes les nouvelles publications de YourPoodle des 3 derniers jours.","de":"Sie haben alle neuen YourPoodle-Beiträge der letzten 3 Tage angesehen.","pt":"Você viu todas as novas postagens do YourPoodle dos últimos 3 dias.","ko":"지난 3일 동안의 모든 새로운 YourPoodle 게시물을 확인하셨습니다.","zh-CN":"您已查看过去 3 天的所有新 YourPoodle 帖子。"},"Poodle'ınız hakkında belirtmek istediğiniz ek detaylar...":{"tr":"Poodle'ınız hakkında belirtmek istediğiniz ek detaylar...","en":"Additional details you would like to specify about your Poodle...","ja":"あなたのプードルに関して指定したい追加の詳細...","es":"Detalles adicionales que le gustaría especificar sobre su Caniche...","fr":"Détails supplémentaires que vous souhaiteriez préciser sur votre caniche...","de":"Zusätzliche Details, die Sie über Ihren Pudel angeben möchten...","pt":"Detalhes adicionais que você gostaria de especificar sobre o seu Poodle...","ko":"귀하의 푸들에 대해 지정하고 싶은 추가 세부 사항...","zh-CN":"您想要指定的有关您的贵宾犬的其他详细信息..."},"4 haneli doğrulama kodu Netgsm SMS ile gönderilecektir.":{"tr":"4 haneli doğrulama kodu Netgsm SMS ile gönderilecektir.","en":"The 4-digit verification code will be sent via Netgsm SMS.","ja":"4 桁の確認コードは Netgsm SMS 経由で送信されます。","es":"El código de verificación de 4 dígitos se enviará a través de Netgsm SMS.","fr":"Le code de vérification à 4 chiffres sera envoyé par SMS Netgsm.","de":"Der 4-stellige Bestätigungscode wird per Netgsm-SMS gesendet.","pt":"O código de verificação de 4 dígitos será enviado via SMS Netgsm.","ko":"4자리 인증번호가 Netgsm SMS를 통해 전송됩니다.","zh-CN":"4 位验证码将通过 Netgsm 短信发送。"},"Köpeğinizi 3 saniyede 3D Pixar karakterine dönüştürün ✨":{"tr":"Köpeğinizi 3 saniyede 3D Pixar karakterine dönüştürün ✨","en":"Transform your dog into a 3D Pixar character in 3 seconds ✨","ja":"3秒であなたの犬を3Dピクサーキャラクターに変身させましょう✨","es":"Transforma a tu perro en un personaje 3D de Pixar en 3 segundos ✨","fr":"Transformez votre chien en personnage Pixar 3D en 3 secondes ✨","de":"Verwandeln Sie Ihren Hund in 3 Sekunden in eine 3D-Pixar-Figur ✨","pt":"Transforme seu cachorro em um personagem 3D da Pixar em 3 segundos ✨","ko":"당신의 강아지를 3초 만에 3D 픽사 캐릭터로 변신시켜 보세요 ✨","zh-CN":"3 秒内将您的狗变成 3D 皮克斯角色 ✨"},"Fotoğraflarını paylaş, puan topla, vitrinde öne çık ✨":{"tr":"Fotoğraflarını paylaş, puan topla, vitrinde öne çık ✨","en":"Share your photos, collect points, stand out in the showcase ✨","ja":"写真をシェアしてポイントを集めてショーケースで目立ちましょう✨","es":"Comparte tus fotos, acumula puntos, destaca en el escaparate ✨","fr":"Partagez vos photos, cumulez des points, démarquez-vous dans la vitrine ✨","de":"Teile deine Fotos, sammle Punkte, falle in der Vitrine auf ✨","pt":"Compartilhe suas fotos, acumule pontos, destaque-se na vitrine ✨","ko":"사진을 공유하고, 포인트를 모아, 쇼케이스에서 돋보이세요 ✨","zh-CN":"分享您的照片，收集积分，在展示中脱颖而出✨"},"Park delisi, ödül maması aşığı bir minik prens 🦴👑":{"tr":"Park delisi, ödül maması aşığı bir minik prens 🦴👑","en":"A park crazy, treat loving little prince 🦴👑","ja":"公園に夢中、おやつ大好き星の王子様 🦴👑","es":"Un parque loco, trata al principito cariñoso 🦴👑","fr":"Un parc fou, régalez-vous petit prince aimant 🦴👑","de":"Ein parkverrückter, gönnerliebender kleiner Prinz 🦴👑","pt":"Uma loucura de parque, mimo amoroso principezinho 🦴👑","ko":"미친 공원에서 사랑하는 어린 왕자를 대접하세요 🦴💕","zh-CN":"一个公园疯子，对待可爱的小王子🦴👑"},"Ana ekranına ekle, bildirimleri ve DM'leri kaçırma!":{"tr":"Ana ekranına ekle, bildirimleri ve DM'leri kaçırma!","en":"Add it to your home screen, don't miss notifications and DMs!","ja":"ホーム画面に追加して、通知やDMを見逃さないようにしましょう！","es":"Agréguelo a su pantalla de inicio, ¡no se pierda las notificaciones y los mensajes directos!","fr":"Ajoutez-le à votre écran d'accueil, ne manquez pas les notifications et les DM !","de":"Fügen Sie es Ihrem Startbildschirm hinzu und verpassen Sie keine Benachrichtigungen und Direktnachrichten!","pt":"Adicione-o à sua tela inicial, não perca notificações e DMs!","ko":"홈 화면에 추가하고 알림과 DM을 놓치지 마세요!","zh-CN":"将其添加到您的主屏幕，不要错过通知和私信！"},"Instagram tarzı doğrulanmış tescilli Poodle rozeti":{"tr":"Instagram tarzı doğrulanmış tescilli Poodle rozeti","en":"Instagram style verified registered Poodle badge","ja":"Instagram スタイルの認証済み登録済みプードルバッジ","es":"Insignia de caniche registrado verificado al estilo de Instagram","fr":"Badge de caniche enregistré de style Instagram vérifié","de":"Im Instagram-Stil verifiziertes registriertes Pudelabzeichen","pt":"Selo de Poodle registrado verificado estilo Instagram","ko":"Instagram 스타일 인증 등록 푸들 배지","zh-CN":"Instagram 风格验证注册贵宾犬徽章"},"Tescilli Poodle Hesabı ve Mavi Pati Rozeti Tasdiki":{"tr":"Tescilli Poodle Hesabı ve Mavi Pati Rozeti Tasdiki","en":"Registered Poodle Account and Blue Paw Badge Certification","ja":"登録済みプードルアカウントと青い足バッジ認定","es":"Cuenta de caniche registrada y certificación de insignia Blue Paw","fr":"Compte caniche enregistré et certification Blue Paw Badge","de":"Registriertes Pudelkonto und Blue Paw Badge-Zertifizierung","pt":"Conta Poodle registrada e certificação Blue Paw Badge","ko":"푸들 계정 등록 및 블루포 뱃지 인증","zh-CN":"注册贵宾犬帐户和蓝爪徽章认证"},"Örn: Toy Poodle için ilk tıraş ne zaman yapılmalı?":{"tr":"Örn: Toy Poodle için ilk tıraş ne zaman yapılmalı?","en":"For example: When should the first shave be done for a Toy Poodle?","ja":"例: トイプードルの最初の毛剃りはいつ行うべきですか?","es":"Por ejemplo: ¿Cuándo se debe realizar el primer afeitado a un Caniche Toy?","fr":"Par exemple : Quand faut-il faire le premier rasage d’un caniche toy ?","de":"Zum Beispiel: Wann sollte die erste Rasur eines Zwergpudels durchgeführt werden?","pt":"Por exemplo: Quando deve ser feito o primeiro barbear de um Poodle Toy?","ko":"예: 토이 푸들의 첫 면도는 언제 해야 합니까?","zh-CN":"例如：玩具贵宾犬第一次剃毛应该什么时候进行？"},"Kilit ekranı ve bildirim çubuğunda anlık uyarılar":{"tr":"Kilit ekranı ve bildirim çubuğunda anlık uyarılar","en":"Push alerts on lock screen and notification bar","ja":"ロック画面と通知バーのプッシュアラート","es":"Alertas push en la pantalla de bloqueo y barra de notificaciones","fr":"Alertes push sur l'écran de verrouillage et la barre de notification","de":"Push-Benachrichtigungen auf dem Sperrbildschirm und in der Benachrichtigungsleiste","pt":"Alertas push na tela de bloqueio e na barra de notificação","ko":"잠금 화면 및 알림 표시줄에 알림 푸시","zh-CN":"在锁定屏幕和通知栏上推送警报"},"YourPoodle • Akıllı Poodle Topluluğu & Sosyal Ağ":{"tr":"YourPoodle • Akıllı Poodle Topluluğu & Sosyal Ağ","en":"YourPoodle • Smart Poodle Community & Social Network","ja":"YourPoodle – スマートプードルコミュニティとソーシャルネットワーク","es":"YourPoodle • Comunidad y red social de Smart Poodle","fr":"YourPoodle • Communauté et réseau social Smart Poodle","de":"YourPoodle • Intelligente Pudel-Community und soziales Netzwerk","pt":"YourPoodle • Comunidade e rede social Smart Poodle","ko":"YourPoodle • 스마트 푸들 커뮤니티 및 소셜 네트워크","zh-CN":"YourPoodle • 智能贵宾犬社区和社交网络"},"Mochi bugün 1 yıl 3 aylık ve harika görünüyor 🐾":{"tr":"Mochi bugün 1 yıl 3 aylık ve harika görünüyor 🐾","en":"Mochi is 1 year and 3 months old today and looks great 🐾","ja":"もちは今日で1歳3ヶ月になり、とても元気です🐾","es":"Mochi hoy cumple 1 año y 3 meses y luce genial 🐾","fr":"Mochi a 1 an et 3 mois aujourd'hui et est superbe 🐾","de":"Mochi ist heute 1 Jahr und 3 Monate alt und sieht großartig aus 🐾","pt":"Mochi faz hoje 1 ano e 3 meses e está ótimo 🐾","ko":"오늘로 모찌가 1년 3개월이 되었는데 정말 멋져 보이네요 🐾","zh-CN":"Mochi今天一岁零三个月了，看起来棒极了🐾"},"Bu ekran tasmadaki QR kodu okutan kişiye görünür":{"tr":"Bu ekran tasmadaki QR kodu okutan kişiye görünür","en":"This screen appears to the person who scans the QR code on the collar","ja":"首輪のQRコードを読み取るとこの画面が表示されます","es":"Esta pantalla le aparece a la persona que escanea el código QR en el collar.","fr":"Cet écran apparaît à la personne qui scanne le QR code présent sur le collier","de":"Dieser Bildschirm erscheint der Person, die den QR-Code am Halsband scannt","pt":"Esta tela aparece para a pessoa que lê o código QR na coleira","ko":"목걸이에 있는 QR코드를 스캔하면 나오는 화면입니다","zh-CN":"扫描衣领上二维码的人会看到此屏幕"},"Deneyimini veya cevabını paylaş (+10 Pati 🐾)...":{"tr":"Deneyimini veya cevabını paylaş (+10 Pati 🐾)...","en":"Share your experience or answer (+10 Paws 🐾)...","ja":"あなたの経験を共有するか、回答してください (+10 足 🐾)...","es":"Comparte tu experiencia o responde (+10 Patas 🐾)...","fr":"Partagez votre expérience ou réponse (+10 Pattes 🐾)...","de":"Teilen Sie Ihre Erfahrung oder Antwort (+10 Pfoten 🐾)...","pt":"Compartilhe sua experiência ou responda (+10 Patas 🐾)...","ko":"경험이나 답변을 공유하세요(+10 Paws 🐾).